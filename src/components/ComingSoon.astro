---
import { config } from '../config';
import { url } from '../lib/util';
---
<section class="cs-hero">
  <div class="wrap cs-hero-in">
    <div class="cs-copy">
      <h1>Coming soon.</h1>
      <p class="cs-sub">We are working on the website and expanding the features.</p>
      <p class="cs-thanks">We appreciate your patience.</p>
    </div>
    <div class="cs-card" id="cs-signup">
      <h2>Get In the Loop.</h2>
      <p>Our weekly newsletter shares local finds and weekend ideas, plus updates as new features go live.</p>
      {config.newsletterAction ? (
        <form class="cs-form" action={config.newsletterAction} method="post">
          <label for="cs-email">Email</label>
          <div class="cs-row">
            <input id="cs-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
            <button type="submit">Subscribe</button>
          </div>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="cs-hp" />
        </form>
      ) : (
        <a class="btn gold" href={`mailto:${config.contactEmail}?subject=Subscribe%20me%20to%20Tradition%20Local`}>Join the newsletter</a>
      )}
    </div>
  </div>
</section>

<section class="cs-explore">
  <div class="wrap">
    <div class="cs-head"><h2>Explore while you wait</h2></div>
    <div class="cs-grid">
      <a class="cs-tile" href={url('/food')}>
        <span class="cs-tile-t">Food</span>
        <span>Eats, coffee stops, and firsthand reviews.</span>
        <span class="cs-tile-go">Explore Food →</span>
      </a>
      <a class="cs-tile" href={url('/cities')}>
        <span class="cs-tile-t">Neighborhoods</span>
        <span>Neighborhood guides and discoveries nearby.</span>
        <span class="cs-tile-go">Explore Neighborhoods →</span>
      </a>
      <a class="cs-tile" href={url('/living')}>
        <span class="cs-tile-t">Things To Do</span>
        <span>Things to do, experiences, and weekend inspiration.</span>
        <span class="cs-tile-go">Explore Things To Do →</span>
      </a>
    </div>
  </div>
</section>

<section class="cs-about">
  <div class="wrap cs-about-in">
    <h2>Meet Dillon and Sara.</h2>
    <div>
      <p>Tradition Local is a local perspective from Dillon and Sara Loren, helping people feel connected to their neighborhood, community, and city. Learn who is behind the recommendations while we work on the site.</p>
      <a class="btn gold" href={url('/about')}>Read our story</a>
    </div>
  </div>
</section>

<style>
  .cs-hero { background: #1F4BA8; color: #fff; padding: 72px 0 80px; }
  .cs-hero-in { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .cs-copy { flex: 1 1 440px; min-width: 0; }
  .cs-copy h1 { margin: 0 0 14px; font-family: var(--serif); font-weight: 400; font-size: clamp(2.6rem, 6vw, 4.4rem); line-height: 1.1; color: #fff; }
  .cs-sub { margin: 0 0 20px; font-family: var(--serif); font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.3; color: #F3E9C4; max-width: 24ch; }
  .cs-thanks { margin: 0; font-size: 1.2rem; color: #fff; }
  .cs-card { flex: 1 1 400px; min-width: 0; max-width: 480px; background: #fff; color: #1C1C1C; border-radius: 14px; padding: 28px 28px 24px; box-shadow: 0 18px 40px rgba(0,0,0,.18); }
  .cs-card h2 { margin: 0 0 10px; font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.15; color: #004AAD; }
  .cs-card p { margin: 0 0 18px; color: #5B6573; font-size: 16px; }
  .cs-form label { display: block; font-size: 14px; margin-bottom: 6px; }
  .cs-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .cs-row input { flex: 1 1 200px; min-width: 0; height: 48px; padding: 0 18px; border-radius: 999px; border: 1.5px solid #5B6573; background: #fff; color: #1C1C1C; font: inherit; font-size: 16px; }
  .cs-row button { height: 48px; padding: 0 24px; border: 0; border-radius: 999px; background: #D8BB53; color: #004AAD; font-family: var(--serif); font-size: 16px; font-weight: 600; cursor: pointer; }
  .cs-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cs-explore { background: #F9F5F4; padding: 56px 0; }
  .cs-head { margin-bottom: 24px; border-bottom: 2px solid #004AAD; padding-bottom: 8px; }
  .cs-head h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.15; color: #004AAD; }
  .cs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 28px; }
  .cs-tile { display: flex; flex-direction: column; gap: 8px; padding: 24px; background: #fff; border-top: 4px solid #D8BB53; text-decoration: none; color: #1C1C1C; }
  .cs-tile:hover { box-shadow: 0 8px 22px rgba(0,0,0,.08); }
  .cs-tile-t { font-family: var(--serif); font-size: 1.5rem; line-height: 1.2; color: #004AAD; }
  .cs-tile-go { margin-top: 4px; font-weight: 600; color: #004AAD; }
  .cs-about { background: #fff; padding: 56px 0; }
  .cs-about-in { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: flex-start; }
  .cs-about-in > h2 { flex: 1 1 320px; margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.15; color: #004AAD; }
  .cs-about-in > div { flex: 1 1 420px; min-width: 0; }
  .cs-about-in p { margin: 0 0 24px; max-width: 60ch; font-size: 18px; line-height: 1.7; }
</style>
