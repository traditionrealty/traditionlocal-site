---
import Base from '../layouts/Base.astro';
import { config } from '../config';
import { url } from '../lib/util';
---
<Base title="About Us" description="Meet Dillon and Sara Loren, the people behind Tradition Local and Tradition Realty Group.">
  <section class="band">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Meet Dillon &amp; Sara Loren</p>
        <h1>Local discoveries. Personal connections. A place to call home.</h1>
        <p class="lede">We created Tradition Local to share the places, people, and everyday experiences that make Houston worth exploring.</p>
        <p class="lede">Come for a new discovery. Stay for a familiar voice and a connection to the community around you.</p>
        <a class="btn gold" href={url('/cities')}>Explore with us &rarr;</a>
      </div>
      <div class="photo-ph">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
        <span>Dillon &amp; Sara together</span>
        <span class="muted small">Natural portrait at a favorite Houston spot</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Why Tradition Local exists</p>
      <h2>Getting to know a place starts with its people.</h2>
      <p class="lede">A neighborhood is more than a location. It's the coffee stop you return to, the business owner you get to know, and the experiences you share. We bring those discoveries together so you can explore Houston with a little more context and confidence.</p>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">The Loren standard</p>
      <h2>How we want you to feel: welcomed, informed, supported.</h2>
      <div class="standard-grid">
        <div>
          <h3>A warm welcome</h3>
          <p>Hospitality guides how we introduce a place, host a gathering, and serve a client.</p>
        </div>
        <div>
          <h3>A useful perspective</h3>
          <p>Firsthand experiences, clear details, and honest context help you make your own choices.</p>
        </div>
        <div>
          <h3>A lasting connection</h3>
          <p>We want to be a resource you return to as your interests, neighborhood, and needs evolve.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">One relationship, different ways to help</p>
      <h2>Explore locally. Get guidance when you need it.</h2>
      <div class="help-grid">
        <div class="help-col">
          <h3>Tradition Local</h3>
          <p>Food reviews, neighborhood guides, local businesses, things to do, videos, and community experiences.</p>
          <a class="mlink-light" href={url('/food')}>Find your next local discovery &rarr;</a>
        </div>
        <div class="help-col">
          <h3>{config.brokerage.name}</h3>
          <p>Personal guidance for buyers, sellers, tenants, landlords, and investors, with a clear plan for your next step.</p>
          <a class="mlink-light" href={config.brokerage.url} target="_blank" rel="noopener">Explore how we can help &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">Your local guides</p>
      <h2>Two perspectives. A shared spirit of hospitality.</h2>
      <div class="guides-grid">
        <div class="guide-card">
          <div class="photo-ph small">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
            <span class="muted small">Sara exploring a cafe or interviewing a local owner</span>
          </div>
          <p class="tag">Writing &middot; Food &middot; Community</p>
          <h3>Sara Loren</h3>
          <p>Sara leads Tradition Local, bringing her background in writing, culinary school, teaching, and holistic health coaching to stories about food, people, and local life.</p>
          <p>Through reviews, conversations, and community experiences, she helps readers look closer at the places around them.</p>
          <a class="mlink-light" href={url('/all-articles')}>Explore Sara's stories &rarr;</a>
        </div>
        <div class="guide-card">
          <div class="photo-ph small">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
            <span class="muted small">Dillon walking a neighborhood or welcoming visitors</span>
          </div>
          <p class="tag">Neighborhoods &middot; Real estate &middot; Personal service</p>
          <h3>Dillon Loren</h3>
          <p>Dillon is a Houston Realtor with {config.brokerage.name}. He connects local discovery with practical guidance for people buying, selling, renting, or investing.</p>
          <p>His approach centers on thoughtful preparation, clear communication, and helping clients feel supported through each decision.</p>
          <a class="mlink-light" href={url('/neighborhood-info-request')}>Meet your real estate concierge &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .kicker { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 12px; margin: 0 0 12px; }
  .lede { max-width: 56ch; }
  .band .btn.gold { margin-top: 20px; }
  .photo-ph { aspect-ratio: 4 / 5; background: rgba(255,255,255,.08); border: 1.5px dashed rgba(255,255,255,.25); border-radius: 16px 16px 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: rgba(255,255,255,.6); text-align: center; padding: 20px; }
  .photo-ph span { max-width: 80%; }
  .photo-ph.small { aspect-ratio: 16/10; border-radius: 8px; margin-bottom: 16px; }

  .narrow { max-width: 760px; }
  .eyebrow { color: var(--green, #1e7a43); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }

  .standard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 24px; }
  .standard-grid h3 { margin: 0 0 8px; font-size: 1.2rem; }

  .help-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 24px; }
  .help-col { border-top: 1px solid var(--line); padding-top: 20px; }
  .help-col h3 { margin: 0 0 8px; font-size: 1.3rem; }
  .mlink-light { color: var(--blue); font-weight: 600; text-decoration: none; }

  .guides-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 24px; }
  .guide-card { background: #fff; border-radius: 10px; padding: 24px; }
  .tag { font-size: 12px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--brown); margin: 0 0 8px; }
  .guide-card h3 { margin: 0 0 10px; font-size: 1.4rem; }

  @media (max-width: 860px) {
    .hero-grid, .standard-grid, .help-grid, .guides-grid { grid-template-columns: 1fr; }
  }
</style>
