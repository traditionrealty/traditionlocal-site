---
import Base from '../layouts/Base.astro';
import { config } from '../config';
import { url } from '../lib/util';
---
<Base title="About Us" description="Meet Dillon and Sara Loren, the people behind Tradition Local and Tradition Realty Group.">
  <section class="band">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Meet Dillon &amp; Sara Loren</p>
        <h1>Local discoveries. Personal connections. A place to call home.</h1>
        <p class="lede">We created Tradition Local to share the places, people, and everyday experiences that make Houston worth exploring.</p>
        <p class="lede">Come for a new discovery. Stay for a familiar voice and a connection to the community around you.</p>
        <a class="btn gold" href={url('/cities')}>Explore with us &rarr;</a>
      </div>
      <div class="photo-ph">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
        <span>Dillon &amp; Sara together</span>
        <span class="muted small">Natural portrait at a favorite Houston spot</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Why Tradition Local exists</p>
      <h2>Getting to know a place starts with its people.</h2>
      <p class="lede">A neighborhood is more than a location. It's the coffee stop you return to, the business owner you get to know, and the experiences you share. We bring those discoveries together so you can explore Houston with a little more context and confidence.</p>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">The Loren standard</p>
      <h2>How we want you to feel: welcomed, informed, supported.</h2>
      <div class="standard-grid">
        <div>
          <h3>A warm welcome</h3>
          <p>Hospitality guides how we introduce a place, host a gathering, and serve a client.</p>
        </div>
        <div>
          <h3>A useful perspective</h3>
          <p>Firsthand experiences, clear details, and honest context help you make your own choices.</p>
        </div>
        <div>
          <h3>A lasting connection</h3>
          <p>We want to be a resource you return to as your interests, neighborhood, and needs evolve.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">One relationship, different ways to help</p>
      <h2>Explore locally. Get guidance when you need it.</h2>
      <div class="help-grid">
        <div class="help-col">
          <h3>Tradition Local</h3>
          <p>Food reviews, neighborhood guides, local businesses, things to do, videos, and community experiences.</p>
          <a class="mlink-light" href={url('/food')}>Find your next local discovery &rarr;</a>
        </div>
        <div class="help-col">
          <h3>{config.brokerage.name}</h3>
          <p>Personal guidance for buyers, sellers, tenants, landlords, and investors, with a clear plan for your next step.</p>
          <a class="mlink-light" href={config.brokerage.url} target="_blank" rel="noopener">Explore how we can help &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">Your local guides</p>
      <h2>Two perspectives. One warm welcome.</h2>
      <p class="lede">Tradition Local brings together the joy of discovering a place and the care that helps you feel at home in it.</p>
      <div class="guides-grid">
        <div class="guide-card">
          <div class="guide-band" data-tone="warm">
            <span class="guide-initials">SL</span>
            <span class="guide-divider"></span>
            <span class="guide-role">
              <span class="guide-kicker">The storyteller</span>
              <span class="guide-name">Sara Loren</span>
            </span>
          </div>
          <div class="guide-body">
            <p class="tag">Writing &middot; Food &middot; Community</p>
            <h3 id="sara">Every place has a story. Sara looks for the people in it.</h3>
            <p>A writer with a background in culinary school, teaching, and holistic health coaching, Sara leads Tradition Local with curiosity and a thoughtful eye for everyday experiences.</p>
            <p>Through firsthand reviews, conversations, and community gatherings, she invites you to look a little closer, and find something worth sharing.</p>
            <hr class="guide-rule" />
            <p class="guide-explore-label">Explore with Sara</p>
            <p class="guide-explore-topics">Food discoveries &middot; Local stories &middot; Community connections</p>
            <a class="btn-meet" href={url('/meet-sara')}>Meet Sara &nearr;</a>
          </div>
        </div>
        <div class="guide-card">
          <div class="guide-band" data-tone="cool">
            <span class="guide-initials">DL</span>
            <span class="guide-divider"></span>
            <span class="guide-role">
              <span class="guide-kicker">The connector</span>
              <span class="guide-name">Dillon Loren</span>
            </span>
          </div>
          <div class="guide-body">
            <p class="tag">Neighborhoods &middot; Real estate &middot; Hospitality</p>
            <h3 id="dillon">A new place. A next chapter. Dillon helps you connect the dots.</h3>
            <p>A Houston Realtor with {config.brokerage.name}, Dillon brings his interest in neighborhoods, economics, and hospitality to the way he serves people.</p>
            <p>Whether you're exploring an area or planning to buy, sell, rent, or invest, his approach starts with listening, thoughtful preparation, and clear communication.</p>
            <hr class="guide-rule" />
            <p class="guide-explore-label">Explore with Dillon</p>
            <p class="guide-explore-topics">Neighborhood insights &middot; Houston updates &middot; Real estate guidance</p>
            <a class="btn-meet" href={url('/meet-dillon')}>Meet Dillon &nearr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .guide-card h3[id] { scroll-margin-top: 110px; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .kicker { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 12px; margin: 0 0 12px; }
  .lede { max-width: 56ch; }
  .band .btn.gold { margin-top: 20px; }
  .photo-ph { aspect-ratio: 4 / 5; background: rgba(255,255,255,.08); border: 1.5px dashed rgba(255,255,255,.25); border-radius: 16px 16px 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: rgba(255,255,255,.6); text-align: center; padding: 20px; }
  .photo-ph span { max-width: 80%; }
  .photo-ph.small { aspect-ratio: 16/10; border-radius: 8px; margin-bottom: 16px; }

  .narrow { max-width: 760px; }
  .eyebrow { color: var(--green, #1e7a43); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }

  .standard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 24px; }
  .standard-grid h3 { margin: 0 0 8px; font-size: 1.2rem; }

  .help-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 24px; }
  .help-col { border-top: 1px solid var(--line); padding-top: 20px; }
  .help-col h3 { margin: 0 0 8px; font-size: 1.3rem; }
  .mlink-light { color: var(--blue); font-weight: 600; text-decoration: none; }

  .guides-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 28px; }
  .guide-card { background: #fff; border-radius: 10px; overflow: hidden; }
  .guide-band { display: flex; align-items: center; gap: 16px; padding: 24px; }
  .guide-band[data-tone="warm"] { background: var(--brown); }
  .guide-band[data-tone="cool"] { background: var(--slate); }
  .guide-initials { font-family: var(--serif); font-size: 2.6rem; color: rgba(255,255,255,.55); line-height: 1; }
  .guide-divider { width: 1px; align-self: stretch; background: rgba(255,255,255,.3); }
  .guide-role { display: flex; flex-direction: column; gap: 4px; }
  .guide-kicker { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .guide-name { font-family: var(--serif); font-size: 1.3rem; color: #fff; }
  .guide-body { padding: 24px; }
  .tag { font-size: 12px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--brown); margin: 0 0 8px; }
  .guide-card h3 { margin: 0 0 14px; font-size: 1.4rem; line-height: 1.25; color: var(--navy); }
  .guide-rule { border: none; border-top: 1px solid var(--line); margin: 18px 0 14px; }
  .guide-explore-label { color: var(--brown); font-size: 12px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; margin: 0 0 4px; }
  .guide-explore-topics { color: var(--muted); font-size: 14px; margin: 0 0 16px; }
  .btn-meet { display: inline-block; background: var(--blue); color: #fff; font-weight: 700; text-decoration: none; padding: 10px 20px; border-radius: 8px; font-size: 14px; }
  .btn-meet:hover { background: var(--blue-deep); }

  @media (max-width: 860px) {
    .hero-grid, .standard-grid, .help-grid, .guides-grid { grid-template-columns: 1fr; }
  }
</style>
