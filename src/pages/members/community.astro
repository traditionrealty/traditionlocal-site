---
// Community feed prototype retired. Redirect anyone with an old link.
import { url } from '../../lib/util';
const dest = url('/members/account');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={dest} />
  <title>Redirecting…</title>
</head>
<body>
  <p>This page moved. <a href={dest}>Continue to My Account</a>.</p>
</body>
</html>
