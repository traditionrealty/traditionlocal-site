---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/util';
import areas from '../../data/areas.json';
const areaNames = [...new Set((areas as any[]).map((a) => a.name))].sort();
---
<Base title="Profile" description="Member profiles and community posts on Tradition Local.">
<section class="pshell">
  <div class="wrap">
    <p class="pback"><a href={url('/members/account')}>&larr; My Account</a></p>

    <div data-loading>
      <p class="mform-note">Loading profile&hellip;</p>
    </div>

    <div data-not-ready hidden>
      <h1>Member accounts are almost ready</h1>
      <p>Check back soon.</p>
    </div>

    <div data-no-username hidden>
      <h1>No profile to show yet</h1>
      <p>Set a username in <a class="plink" href={url('/members/account')}>My Account &rarr; Settings</a> to get your own profile link.</p>
    </div>

    <div data-not-found hidden>
      <h1>We couldn't find that profile</h1>
      <p>The link may be out of date, or this member hasn't set up a public profile yet.</p>
    </div>

    <div data-profile hidden>
      <div class="pwallpaper" data-p-wallpaper>
        <a class="pwallpaper-edit" data-p-own-only href={url('/members/account')} hidden>📷 Change wallpaper</a>
      </div>

      <div class="pheader">
        <span class="pavatar-lg" data-p-initials>&nbsp;</span>
        <h1 data-p-name>Member</h1>
        <p class="pbioline" data-p-bioline hidden></p>
        <p class="pmeta" data-p-meta hidden></p>
        <a class="btn gold" data-p-own-only href={url('/members/account')} hidden>✏️ Edit profile</a>
        <p class="pview-note" data-p-own-only hidden>Your view &middot; Likes, bookmarks, and event plans are private.</p>
      </div>

      <div class="ptabs" role="tablist">
        <button type="button" class="ptab" data-tab="feed" data-p-own-only hidden>Feed <span class="plock">&#128274;</span></button>
        <button type="button" class="ptab" data-tab="posts" aria-selected="true">Posts</button>
        <button type="button" class="ptab" data-tab="about">About</button>
        <button type="button" class="ptab" data-tab="likes" data-p-own-only hidden>Likes <span class="plock">&#128274;</span></button>
        <button type="button" class="ptab" data-tab="bookmarks" data-p-own-only hidden>Bookmarks <span class="plock">&#128274;</span></button>
        <button type="button" class="ptab" data-tab="events" data-p-own-only hidden>Events <span class="plock">&#128274;</span></button>
      </div>

      <div class="pgrid-main">
        <aside class="psidebar">
          <div class="pcard">
            <h2>Intro <span class="pbadge">Public</span></h2>
            <p data-p-intro-bio hidden></p>
            <p class="pmeta" data-p-intro-meta hidden></p>
            <div data-p-interests-wrap hidden>
              <h3 class="psubhead">Interests</h3>
              <div class="pchips" data-p-interests></div>
            </div>
            <div data-p-hoods-wrap hidden>
              <h3 class="psubhead">Neighborhoods I follow</h3>
              <div class="pchips" data-p-hoods></div>
            </div>
            <p class="mform-note" data-p-intro-empty hidden>Nothing to show yet.</p>
          </div>

          <div class="pcard" data-p-own-only hidden>
            <h2>My next plan <span class="plock">&#128274;</span></h2>
            <p class="mform-note">Event RSVPs aren't built yet &mdash; this is a preview of where they'll show up.</p>
            <a class="plink" href={url('/members/account')}>Manage my events &rarr;</a>
          </div>

          <p class="mform-note pprivacy-note" data-p-own-only hidden>Likes, bookmarks, and event plans stay in your account. Your interests, bio, and public posts appear on your profile.</p>
        </aside>

        <div class="pmain">
          <div class="ppanel" data-panel="feed" hidden>
            <div class="pcard">
              <h2>Feed</h2>
              <p>Public posts from neighbors, newest first.</p>
              <div class="search-bar">
                <input type="search" id="feed-search" placeholder="Search posts or neighbors" />
                <select id="feed-hood-select">
                  <option value="all">All neighborhoods</option>
                  {areaNames.map((n: string) => <option value={n}>{n}</option>)}
                </select>
              </div>
            </div>
            <div class="pcard" data-trending-card hidden>
              <h2>🔥 Trending</h2>
              <div class="trending-scroll" data-trending-scroll></div>
            </div>
            <div data-feed-posts>
              <p class="mform-note">Loading&hellip;</p>
            </div>
          </div>

          <div class="ppanel" data-panel="posts">
            <div class="pcard" data-p-composer data-p-own-only hidden>
              <h2>Share a little local life</h2>
              <form id="post-form" novalidate>
                <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
                <div class="mform-field">
                  <textarea id="post-body" name="post-body" rows="2" placeholder="What have you discovered lately?" required></textarea>
                </div>
                <div id="post-banner-preview"></div>
                <div class="composer-row">
                  <div class="join-pin-wrap">
                    <button type="button" class="join-add-btn" data-pin-toggle aria-label="Add area">📍</button>
                    <div class="join-pin-menu" data-pin-menu>
                      <button type="button" data-area="">No area tag</button>
                      {areaNames.map((n: string) => <button type="button" data-area={n}>{n}</button>)}
                    </div>
                  </div>
                  <select class="vis-select" id="post-visibility" name="post-visibility">
                    <option value="public">🌐 Public post</option>
                    <option value="only_me">🔒 Only me</option>
                  </select>
                  <div class="join-add-wrap">
                    <button type="button" class="join-add-btn" data-banner-toggle aria-label="Add a pre-made banner">+</button>
                    <div class="join-add-menu" data-banner-menu>
                      <div class="opt-label">Pre-made banner</div>
                      <div class="banner-swatches">
                        <button type="button" class="banner-swatch" data-banner="green" style="background:linear-gradient(135deg,#3a5a40,#2b4530);" aria-label="Green banner"></button>
                        <button type="button" class="banner-swatch" data-banner="navy" style="background:linear-gradient(135deg,#1D1A6D,#35465c);" aria-label="Navy banner"></button>
                        <button type="button" class="banner-swatch" data-banner="brown" style="background:linear-gradient(135deg,#9d693f,#6b4328);" aria-label="Brown banner"></button>
                        <button type="button" class="banner-swatch" data-banner="gold" style="background:linear-gradient(135deg,#E7BC52,#c99a2f);" aria-label="Gold banner"></button>
                      </div>
                    </div>
                  </div>
                  <button class="btn gold" type="submit">Post</button>
                </div>
              </form>
            </div>
            <div data-own-posts>
              <p class="mform-note">Loading&hellip;</p>
            </div>
          </div>

          <div class="ppanel" data-panel="about" hidden>
            <div class="pcard">
              <h2 data-p-about-title>About</h2>
              <p class="psubhead">Bio</p>
              <p data-p-about-bio>&nbsp;</p>
              <p class="psubhead">Neighborhood</p>
              <p data-p-about-hood>&nbsp;</p>
              <p class="psubhead">Interests</p>
              <p data-p-about-interests>&nbsp;</p>
              <p class="psubhead">Followed neighborhoods</p>
              <p data-p-about-followed>&nbsp;</p>
              <p class="mform-note" data-p-own-only hidden>These details are shown in the public profile preview.</p>
            </div>
          </div>

          <div class="ppanel" data-panel="likes" hidden>
            <div class="pcard">
              <h2>My likes</h2>
              <div data-likes-posts>
                <p class="mform-note">Loading&hellip;</p>
              </div>
            </div>
          </div>

          <div class="ppanel" data-panel="bookmarks" hidden>
            <div class="pcard">
              <h2>Bookmarks</h2>
              <p>Businesses and articles you've bookmarked.</p>
              <p class="mform-note">Saving bookmarks isn't built yet &mdash; this is a preview of where they'll show up.</p>
            </div>
          </div>

          <div class="ppanel" data-panel="events" hidden>
            <div class="pcard">
              <h2>My events</h2>
              <p>Events you're going to or interested in.</p>
              <p class="mform-note">Event RSVPs aren't built yet &mdash; this is a preview of where they'll show up.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</Base>

<script>
import { membersReady, supabase, currentUser, say, busy, field, friendly } from '../../lib/members';

const loadingEl = document.querySelector('[data-loading]') as HTMLElement;
const notReadyEl = document.querySelector('[data-not-ready]') as HTMLElement;
const noUsernameEl = document.querySelector('[data-no-username]') as HTMLElement;
const notFoundEl = document.querySelector('[data-not-found]') as HTMLElement;
const profileEl = document.querySelector('[data-profile]') as HTMLElement;

function show(el: HTMLElement) {
  [loadingEl, notReadyEl, noUsernameEl, notFoundEl, profileEl].forEach((e) => { e.hidden = e !== el; });
}

function esc(s: string) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

const BANNER_GRADIENTS: Record<string, string> = {
  green: 'linear-gradient(135deg,#3a5a40,#2b4530)',
  navy: 'linear-gradient(135deg,#1D1A6D,#35465c)',
  brown: 'linear-gradient(135deg,#9d693f,#6b4328)',
  gold: 'linear-gradient(135deg,#E7BC52,#c99a2f)',
};

let myId: string | null = null;
let viewingOwnId: string | null = null;
let isOwnView = false;
let selectedArea = '';
let selectedBanner = '';
let currentHood = 'all';
let searchQuery = '';

const postForm = document.getElementById('post-form') as HTMLFormElement;
const bodyInput = document.getElementById('post-body') as HTMLTextAreaElement;
const visSelect = document.getElementById('post-visibility') as HTMLSelectElement;
const searchInput = document.getElementById('feed-search') as HTMLInputElement;
const hoodSelect = document.getElementById('feed-hood-select') as HTMLSelectElement;
const ownPostsEl = document.querySelector('[data-own-posts]') as HTMLElement;
const feedPostsEl = document.querySelector('[data-feed-posts]') as HTMLElement;
const likesPostsEl = document.querySelector('[data-likes-posts]') as HTMLElement;
const trendingCard = document.querySelector('[data-trending-card]') as HTMLElement;
const trendingScroll = document.querySelector('[data-trending-scroll]') as HTMLElement;

// ---- Tabs ----
const tabs = [...document.querySelectorAll<HTMLButtonElement>('.ptab')];
const panels = [...document.querySelectorAll<HTMLElement>('.ppanel')];
let feedLoaded = false;
let likesLoaded = false;
function activateTab(key: string) {
  const tab = tabs.find((t) => t.dataset.tab === key);
  if (!tab || tab.hidden) return;
  tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
  panels.forEach((p) => { p.hidden = p.dataset.panel !== key; });
  if (key === 'feed' && !feedLoaded) { feedLoaded = true; loadFeedPosts(); }
  if (key === 'likes' && !likesLoaded) { likesLoaded = true; loadLikes(); }
}
tabs.forEach((tab) => tab.addEventListener('click', () => activateTab(tab.dataset.tab!)));

// ---- Composer: pin + banner menus ----
document.querySelector('[data-pin-toggle]')?.addEventListener('click', () => {
  document.querySelector('[data-banner-menu]')?.classList.remove('open');
  document.querySelector('[data-pin-menu]')?.classList.toggle('open');
});
document.querySelector('[data-banner-toggle]')?.addEventListener('click', () => {
  document.querySelector('[data-pin-menu]')?.classList.remove('open');
  document.querySelector('[data-banner-menu]')?.classList.toggle('open');
});
document.addEventListener('click', (e) => {
  const t = e.target as HTMLElement;
  if (!t.closest('.join-pin-wrap')) document.querySelector('[data-pin-menu]')?.classList.remove('open');
  if (!t.closest('.join-add-wrap')) document.querySelector('[data-banner-menu]')?.classList.remove('open');
});
document.querySelectorAll('[data-pin-menu] button').forEach((btn) => {
  btn.addEventListener('click', () => {
    selectedArea = (btn as HTMLElement).dataset.area || '';
    document.querySelector('[data-pin-menu]')?.classList.remove('open');
  });
});
document.querySelectorAll('.banner-swatch').forEach((btn) => {
  btn.addEventListener('click', () => {
    const key = (btn as HTMLElement).dataset.banner || '';
    selectedBanner = selectedBanner === key ? '' : key;
    document.querySelectorAll('.banner-swatch').forEach((b) => b.classList.toggle('selected', b === btn && selectedBanner !== ''));
    const preview = document.getElementById('post-banner-preview')!;
    preview.innerHTML = selectedBanner
      ? `<div class="join-attachment" style="background:${BANNER_GRADIENTS[selectedBanner]};"><button type="button" class="join-attachment-remove" data-clear-banner>×</button></div>`
      : '';
    document.querySelector('[data-banner-menu]')?.classList.remove('open');
  });
});
document.addEventListener('click', (e) => {
  if ((e.target as HTMLElement).closest('[data-clear-banner]')) {
    selectedBanner = '';
    document.querySelectorAll('.banner-swatch').forEach((b) => b.classList.remove('selected'));
    document.getElementById('post-banner-preview')!.innerHTML = '';
  }
});

function renderPost(p: any, isOwnPost: boolean) {
  const name = p.author_name || 'Member';
  const initials = name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || '?';
  const when = new Date(p.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  const trending = (p.like_count || 0) >= 10;
  const banner = p.banner_style && BANNER_GRADIENTS[p.banner_style]
    ? `<div class="post-card-visual" style="background:${BANNER_GRADIENTS[p.banner_style]};"></div>` : '';
  return `<div class="pcard post-card" data-post-id="${p.id}">
    <div class="post-head">
      <div class="post-head-id"><span class="post-avatar">${esc(initials)}</span>
        <div><strong>${esc(name)}</strong><div class="mform-note">${p.neighborhood ? esc(p.neighborhood) + ' · ' : ''}${when}</div></div>
      </div>
      ${isOwnPost ? `<button type="button" class="post-menu-btn" data-delete-post="${p.id}" aria-label="Delete post">🗑</button>` : ''}
    </div>
    <p>${esc(p.body)}</p>
    ${banner}
    <div class="post-actions">
      <button type="button" class="like-btn" data-like-post="${p.id}" data-liked="${p.liked_by_me ? '1' : '0'}">${p.liked_by_me ? '♥ Liked' : '♡ Like'}</button>
      <span class="mform-note">${p.like_count || 0} ${(p.like_count || 0) === 1 ? 'like' : 'likes'}</span>
      ${trending ? '<span class="feed-trending-badge">🔥 Trending</span>' : ''}
    </div>
  </div>`;
}

async function attachLikeInfo(sb: any, posts: any[]) {
  const ids = posts.map((p) => p.id);
  const counts: Record<string, number> = {};
  const likedByMe = new Set<string>();
  if (ids.length) {
    const { data: likes } = await sb.from('post_likes').select('post_id, profile_id').in('post_id', ids);
    (likes || []).forEach((l: any) => {
      counts[l.post_id] = (counts[l.post_id] || 0) + 1;
      if (myId && l.profile_id === myId) likedByMe.add(l.post_id);
    });
  }
  return posts.map((p) => ({
    ...p,
    author_name: [p.profiles?.first_name, p.profiles?.last_name].filter(Boolean).join(' '),
    like_count: counts[p.id] || 0,
    liked_by_me: likedByMe.has(p.id),
  }));
}

async function loadOwnPosts() {
  if (!membersReady || !viewingOwnId) { ownPostsEl.innerHTML = ''; return; }
  const sb = supabase();
  const { data: posts, error } = await sb
    .from('posts')
    .select('id, body, neighborhood, banner_style, created_at, author_id, visibility, profiles!posts_author_id_fkey(first_name,last_name)')
    .eq('author_id', viewingOwnId)
    .order('created_at', { ascending: false })
    .limit(50);
  if (error) { ownPostsEl.innerHTML = `<p class="mform-note">${esc(friendly(error.message))}</p>`; return; }
  let rows = await attachLikeInfo(sb, posts || []);
  if (!isOwnView) rows = rows.filter((p: any) => p.visibility === 'public');
  ownPostsEl.innerHTML = rows.length
    ? rows.map((p: any) => renderPost(p, p.author_id === myId)).join('')
    : `<div class="pcard"><p class="mform-note">${isOwnView ? 'No posts yet. Be the first to share something.' : 'No public posts yet.'}</p></div>`;
}

async function loadFeedPosts() {
  if (!membersReady) { feedPostsEl.innerHTML = ''; return; }
  const sb = supabase();
  let query = sb
    .from('posts')
    .select('id, body, neighborhood, banner_style, created_at, author_id, profiles!posts_author_id_fkey(first_name,last_name)')
    .eq('visibility', 'public')
    .order('created_at', { ascending: false })
    .limit(50);
  if (currentHood !== 'all') query = query.eq('neighborhood', currentHood);
  const { data: posts, error } = await query;
  if (error) { feedPostsEl.innerHTML = `<p class="mform-note">${esc(friendly(error.message))}</p>`; return; }
  let rows = await attachLikeInfo(sb, posts || []);
  if (searchQuery) {
    const q = searchQuery.toLowerCase();
    rows = rows.filter((p: any) => p.body.toLowerCase().includes(q) || p.author_name.toLowerCase().includes(q));
  }
  feedPostsEl.innerHTML = rows.length
    ? rows.map((p: any) => renderPost(p, p.author_id === myId)).join('')
    : '<div class="pcard"><p class="mform-note">No public posts yet. Be the first to share something.</p></div>';

  const trending = rows.filter((p: any) => p.like_count >= 10).slice(0, 6);
  trendingCard.hidden = trending.length === 0;
  trendingScroll.innerHTML = trending.map((p: any) => `
    <div class="pcard trending-item">
      <strong>${esc(p.author_name || 'Member')}</strong>
      <p>${esc(p.body.slice(0, 120))}${p.body.length > 120 ? '…' : ''}</p>
      <span class="mform-note">♥ ${p.like_count} likes</span>
    </div>`).join('');
}

async function loadLikes() {
  if (!membersReady || !myId) { likesPostsEl.innerHTML = ''; return; }
  const sb = supabase();
  const { data: likeRows, error } = await sb.from('post_likes').select('post_id').eq('profile_id', myId).order('created_at', { ascending: false });
  if (error) { likesPostsEl.innerHTML = `<p class="mform-note">${esc(friendly(error.message))}</p>`; return; }
  const ids = (likeRows || []).map((l: any) => l.post_id);
  if (!ids.length) { likesPostsEl.innerHTML = '<p class="mform-note">Like a post to find it here.</p>'; return; }
  const { data: posts, error: perr } = await sb
    .from('posts')
    .select('id, body, neighborhood, banner_style, created_at, author_id, visibility, profiles!posts_author_id_fkey(first_name,last_name)')
    .in('id', ids)
    .eq('visibility', 'public');
  if (perr) { likesPostsEl.innerHTML = `<p class="mform-note">${esc(friendly(perr.message))}</p>`; return; }
  const rows = await attachLikeInfo(sb, posts || []);
  likesPostsEl.innerHTML = rows.length
    ? rows.map((p: any) => renderPost(p, p.author_id === myId)).join('')
    : '<p class="mform-note">Like a post to find it here.</p>';
}

document.addEventListener('click', async (e) => {
  const likeBtn = (e.target as HTMLElement).closest('[data-like-post]') as HTMLElement | null;
  if (likeBtn) {
    const user = await currentUser();
    if (!user) return;
    const postId = likeBtn.dataset.likePost!;
    const sb = supabase();
    if (likeBtn.dataset.liked === '1') await sb.from('post_likes').delete().eq('post_id', postId).eq('profile_id', user.id);
    else await sb.from('post_likes').insert({ post_id: postId, profile_id: user.id });
    loadOwnPosts(); if (feedLoaded) loadFeedPosts(); if (likesLoaded) loadLikes();
    return;
  }
  const delBtn = (e.target as HTMLElement).closest('[data-delete-post]') as HTMLElement | null;
  if (delBtn) {
    if (!confirm('Delete this post?')) return;
    await supabase().from('posts').delete().eq('id', delBtn.dataset.deletePost);
    loadOwnPosts(); if (feedLoaded) loadFeedPosts(); if (likesLoaded) loadLikes();
  }
});

searchInput?.addEventListener('input', () => { searchQuery = searchInput.value.trim(); loadFeedPosts(); });
hoodSelect?.addEventListener('change', () => { currentHood = hoodSelect.value; loadFeedPosts(); });

postForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  say(postForm, '');
  const user = await currentUser();
  if (!user) return say(postForm, 'Please sign in to post.');
  const body = bodyInput.value.trim();
  if (!body) return;
  const row = {
    author_id: user.id,
    body,
    visibility: visSelect.value,
    neighborhood: selectedArea || null,
    banner_style: selectedBanner || null,
  };
  const { error } = await busy(postForm, 'Posting…', () => supabase().from('posts').insert(row));
  if (error) return say(postForm, friendly(error.message));
  bodyInput.value = '';
  selectedArea = '';
  selectedBanner = '';
  document.getElementById('post-banner-preview')!.innerHTML = '';
  document.querySelectorAll('.banner-swatch').forEach((b) => b.classList.remove('selected'));
  loadOwnPosts(); if (feedLoaded) loadFeedPosts();
});

function renderProfile(p: any, isOwn: boolean) {
  isOwnView = isOwn;
  viewingOwnId = p.id;
  const name = p.display_name || [p.first_name, p.last_name].filter(Boolean).join(' ') || 'Member';
  const initials = name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || '?';
  document.querySelector('[data-p-name]')!.textContent = name;
  document.querySelector('[data-p-initials]')!.textContent = initials;

  const bioLineEl = document.querySelector('[data-p-bioline]') as HTMLElement;
  bioLineEl.hidden = !p.bio; if (p.bio) bioLineEl.textContent = p.bio;
  const metaEl = document.querySelector('[data-p-meta]') as HTMLElement;
  metaEl.hidden = !p.area_of_interest; if (p.area_of_interest) metaEl.textContent = p.area_of_interest;

  document.querySelectorAll<HTMLElement>('[data-p-own-only]').forEach((el) => { el.hidden = !isOwn; });

  const introBio = document.querySelector('[data-p-intro-bio]') as HTMLElement;
  introBio.hidden = !p.bio; if (p.bio) introBio.textContent = p.bio;
  const introMeta = document.querySelector('[data-p-intro-meta]') as HTMLElement;
  introMeta.hidden = !p.area_of_interest; if (p.area_of_interest) introMeta.textContent = '📍 ' + p.area_of_interest;

  const interests: string[] = p.interests || [];
  const interestsWrap = document.querySelector('[data-p-interests-wrap]') as HTMLElement;
  interestsWrap.hidden = interests.length === 0;
  if (interests.length) document.querySelector('[data-p-interests]')!.innerHTML = interests.map((i) => `<span class="pchip">${esc(i)}</span>`).join('');

  const hoods: string[] = p.followed_neighborhoods || [];
  const hoodsWrap = document.querySelector('[data-p-hoods-wrap]') as HTMLElement;
  hoodsWrap.hidden = hoods.length === 0;
  if (hoods.length) document.querySelector('[data-p-hoods]')!.innerHTML = hoods.map((h) => `<span class="pchip">${esc(h)}</span>`).join('');

  (document.querySelector('[data-p-intro-empty]') as HTMLElement).hidden = Boolean(p.bio || p.area_of_interest || interests.length || hoods.length);

  (document.querySelector('[data-p-about-title]') as HTMLElement).textContent = isOwn ? 'About you' : `About ${name.split(' ')[0]}`;
  (document.querySelector('[data-p-about-bio]') as HTMLElement).textContent = p.bio || 'Not shared.';
  (document.querySelector('[data-p-about-hood]') as HTMLElement).textContent = p.area_of_interest || 'Not shared.';
  (document.querySelector('[data-p-about-interests]') as HTMLElement).textContent = interests.length ? interests.join(' · ') : 'Not shared.';
  (document.querySelector('[data-p-about-followed]') as HTMLElement).textContent = hoods.length ? hoods.join(' · ') : 'Not shared.';

  show(profileEl);
  feedLoaded = false; likesLoaded = false;
  loadOwnPosts();
  const activeTab = tabs.find((t) => t.getAttribute('aria-selected') === 'true' && !t.hidden) || tabs.find((t) => !t.hidden);
  activateTab(activeTab?.dataset.tab || 'posts');
}

async function init() {
  if (!membersReady) { show(notReadyEl); return; }
  const sb = supabase();
  const user = await currentUser();
  myId = user?.id ?? null;
  const hashUsername = decodeURIComponent(location.hash.replace(/^#/, '')).trim().toLowerCase();

  const OWN_FIELDS = 'id, first_name, last_name, username, display_name, bio, interests, area_of_interest';

  if (hashUsername) {
    const { data, error } = await sb.from('public_profiles').select('*').eq('username', hashUsername).maybeSingle();
    if (error || !data) { show(notFoundEl); return; }
    if (myId && myId === data.id) {
      const own = await sb.from('profiles').select(OWN_FIELDS).eq('id', myId).maybeSingle();
      if (!own.error && own.data) {
        const { data: hoods } = await sb.from('followed_neighborhoods').select('neighborhood').eq('profile_id', myId);
        renderProfile({ ...own.data, followed_neighborhoods: (hoods || []).map((h: any) => h.neighborhood) }, true);
        return;
      }
    }
    const { data: pubHoods } = await sb.from('followed_neighborhoods').select('neighborhood').eq('profile_id', data.id).eq('is_public', true);
    renderProfile({ ...data, followed_neighborhoods: (pubHoods || []).map((h: any) => h.neighborhood) }, false);
    return;
  }

  if (!user) { show(notFoundEl); return; }
  const { data, error } = await sb.from('profiles').select(OWN_FIELDS).eq('id', user.id).maybeSingle();
  if (error || !data) { show(notFoundEl); return; }
  if (!data.username) { show(noUsernameEl); return; }
  const { data: hoods } = await sb.from('followed_neighborhoods').select('neighborhood').eq('profile_id', user.id);
  renderProfile({ ...data, followed_neighborhoods: (hoods || []).map((h: any) => h.neighborhood) }, true);
}

init();
</script>

