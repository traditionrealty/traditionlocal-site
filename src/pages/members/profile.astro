---
// Profile editing moved into the combined Settings page. Redirect anyone with an old link.
import { url } from '../../lib/util';
const dest = url('/members/settings');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={dest} />
  <title>Redirecting…</title>
</head>
<body>
  <p>This page moved. <a href={dest}>Continue to Settings</a>.</p>
</body>
</html>
