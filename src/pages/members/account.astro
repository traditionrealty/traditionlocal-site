---
import Base from '../../layouts/Base.astro';
import MemberShell from '../../components/MemberShell.astro';
import { config } from '../../config';
import { url } from '../../lib/util';
import areas from '../../data/areas.json';
const areaNames = [...new Set((areas as any[]).map((a) => a.name))].sort();
---
<Base title="My Account" description="Your Tradition Local member account.">
  <MemberShell active="account">
    <div class="acct-tabs" role="tablist">
      <button type="button" class="acct-tab" data-tab="account" aria-selected="true">My Account</button>
      <button type="button" class="acct-tab" data-tab="settings" aria-selected="false">Settings</button>
    </div>

    <div class="acct-panel" data-panel="account">
      <p class="eyebrow">Your member home</p>
      <h1>Welcome, <span data-first-name>neighbor</span>.</h1>
      <p class="lede">You're a Locally member.</p>

      <div class="mgrid2">
        <div class="mcard">
          <h2>What's new</h2>
          <ul class="perks">
            <li><a class="mlink" href={url('/living')}>Upcoming events and meetups &rarr;</a></li>
            <li><a class="mlink" href={url('/all-articles')}>The latest food finds and guides &rarr;</a></li>
            <li><a class="mlink" href={url('/cities')}>Neighborhood guides across Greater Houston &rarr;</a></li>
          </ul>
        </div>
        <div class="mcard">
          <h2>Make yourself at home.</h2>
          <p>A few good places to start.</p>
          <ul class="perks">
            <li><a class="mlink" href={url('/about')}>About us &rarr;</a></li>
            <li><a class="mlink" href={url('/about-our-reviews')}>Our reviews &rarr;</a></li>
            <li><a class="mlink" href={url('/newsletters')}>The newsletter &rarr;</a></li>
          </ul>
        </div>
      </div>

      <form class="mcard" id="neighborhood-form" novalidate>
        <h2>My neighborhood</h2>
        <p>This is the area used for your Locally page and your custom feed.</p>
        <p class="msg" data-nb-msg role="alert" tabindex="-1" hidden></p>
        <div class="mform-field">
          <label for="area-of-interest">Current area</label>
          <select id="area-of-interest" name="area-of-interest">
            <option value="">Choose one</option>
            {areaNames.map((n: string) => <option value={n}>{n}</option>)}
          </select>
        </div>
        <button class="btn gold" type="submit">Save neighborhood</button>
      </form>

      <div class="mgrid2">
        <div class="mcard">
          <h2>Bookmarks</h2>
          <p>Businesses and articles you've bookmarked.</p>
          <p class="mform-note">Saving bookmarks isn't built yet &mdash; this is a preview of where they'll show up.</p>
        </div>
        <div class="mcard">
          <h2>My events</h2>
          <p>Events you're going to or interested in.</p>
          <p class="mform-note">Event RSVPs aren't built yet &mdash; this is a preview of where they'll show up.</p>
        </div>
      </div>

      <div class="mcard">
        <h2>Share</h2>
        <p>Tell a friend about Tradition Local.</p>
        <p><a class="mlink" href={`mailto:?subject=Check%20out%20Tradition%20Local&body=${encodeURIComponent('I thought you might like this: ' + url('/'))}`}>Email a friend &rarr;</a></p>
      </div>
    </div>

    <div class="acct-panel" data-panel="settings" hidden>
      <p class="eyebrow">Communication &amp; account controls</p>
      <h1>Settings</h1>
      <p class="lede">Choose what you receive and manage your account.</p>

      <form class="mcard" id="profile-form" novalidate>
        <h2>Name &amp; email</h2>
        <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
        <div class="mgrid2">
          <div class="mform-field">
            <label for="first-name">First name</label>
            <input type="text" id="first-name" name="first-name" autocomplete="given-name" required />
          </div>
          <div class="mform-field">
            <label for="last-name">Last name</label>
            <input type="text" id="last-name" name="last-name" autocomplete="family-name" required />
          </div>
        </div>
        <div class="mform-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" readonly />
          <p class="mform-note">An email change requires contacting us.</p>
        </div>
        <button class="btn gold" type="submit">Save</button>
      </form>

      <div class="mcard">
        <h2>Newsletters &amp; notifications</h2>
        <label class="mcheck">
          <input type="checkbox" id="weekly-guide" />
          <span><strong>In the Loop weekly newsletter</strong><p>Food finds, neighborhood discoveries, and weekend ideas.</p></span>
        </label>
        <p class="mform-note">Saved to this browser; we don't have an email preference center yet, so this won't follow you to another device.</p>
        <button class="btn gold" type="button" id="save-prefs">Save preferences</button>
        <p class="msg" data-prefs-msg hidden></p>
      </div>

      <div class="mcard">
        <h2>Password &amp; sign-in</h2>
        <div class="mrow-item">
          <div>
            <strong>Sign-in email</strong>
            <p data-settings-email>&nbsp;</p>
          </div>
        </div>
        <div class="mrow-item">
          <div>
            <strong>Password</strong>
            <p>Manage your login credentials.</p>
          </div>
          <a class="btn-outline-dark" href={url('/reset-password')}>Manage sign-in</a>
        </div>
      </div>

      <div class="mcard">
        <h2>Account help</h2>
        <div class="mrow-item">
          <div>
            <strong>Your information</strong>
            <p>Request a copy of your stored account data.</p>
          </div>
          <a class="btn-outline-dark" href={`mailto:${config.contactEmail}?subject=Request%20my%20account%20data`}>Request my data</a>
        </div>
        <div class="mrow-item">
          <div>
            <strong>Close your member account</strong>
            <p>Contact us and we'll close your account for you.</p>
          </div>
          <a class="mlink" href={`mailto:${config.contactEmail}?subject=Close%20my%20member%20account`}>Request account closure &rarr;</a>
        </div>
      </div>
    </div>
  </MemberShell>
</Base>

<script>
  import { membersReady, supabase, currentUser, getProfile, friendly, say, busy, field } from '../../lib/members';

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.acct-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.acct-panel')];
  function activateTab(k: string) {
    const tab = tabs.find((t) => t.dataset.tab === k);
    if (!tab) return;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== k; });
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => activateTab(tab.dataset.tab!)));
  if (location.hash === '#settings') activateTab('settings');

  const profileForm = document.getElementById('profile-form') as HTMLFormElement | null;
  const nbForm = document.getElementById('neighborhood-form') as HTMLFormElement | null;
  const PREF_KEY = 'tl-email-prefs';

  async function load() {
    const user = await currentUser();
    if (!user) return;
    const p = await getProfile(user);
    const first = (p.first_name || '').trim();
    document.querySelector('[data-first-name]')!.textContent = first || 'neighbor';
    const emailEl = document.querySelector('[data-settings-email]');
    if (emailEl) emailEl.textContent = user.email || '';
    if (profileForm) {
      const set = (name: string, v: string | null) => { (profileForm.elements.namedItem(name) as HTMLInputElement).value = v || ''; };
      set('email', user.email || ''); set('first-name', p.first_name); set('last-name', p.last_name);
    }
    if (nbForm) (nbForm.elements.namedItem('area-of-interest') as HTMLSelectElement).value = p.area_of_interest || '';
    const weeklyGuide = document.getElementById('weekly-guide') as HTMLInputElement | null;
    if (weeklyGuide) {
      try {
        const saved = JSON.parse(localStorage.getItem(PREF_KEY) || '{}');
        weeklyGuide.checked = 'weekly-guide' in saved ? Boolean(saved['weekly-guide']) : true;
      } catch {}
    }
  }

  if (membersReady) {
    load();
    supabase().auth.onAuthStateChange((event) => { if (event === 'SIGNED_IN') load(); });
  }

  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!profileForm.reportValidity()) return;
    say(profileForm, '');
    const user = await currentUser();
    if (!user) return say(profileForm, 'Your session ended. Please sign in again.');
    const row = { first_name: field(profileForm, 'first-name'), last_name: field(profileForm, 'last-name') };
    const { error } = await busy(profileForm, 'Saving…', async () => {
      const sb = supabase();
      let res = await sb.from('profiles').update(row).eq('id', user.id).select('id');
      if (!res.error && !res.data?.length) res = await sb.from('profiles').insert({ id: user.id, email: user.email, ...row }).select('id');
      if (!res.error) await sb.auth.updateUser({ data: { first_name: row.first_name, last_name: row.last_name } });
      return res;
    });
    if (error) return say(profileForm, friendly(error.message));
    say(profileForm, 'Saved.', 'ok');
    document.querySelector('[data-first-name]')!.textContent = row.first_name || 'neighbor';
  });

  nbForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    say(nbForm, '');
    const user = await currentUser();
    if (!user) return say(nbForm, 'Your session ended. Please sign in again.');
    const row = { area_of_interest: field(nbForm, 'area-of-interest') || null };
    const { error } = await busy(nbForm, 'Saving…', async () => {
      const sb = supabase();
      let res = await sb.from('profiles').update(row).eq('id', user.id).select('id');
      if (!res.error && !res.data?.length) res = await sb.from('profiles').insert({ id: user.id, email: user.email, ...row }).select('id');
      return res;
    });
    if (error) return say(nbForm, friendly(error.message));
    say(nbForm, 'Saved.', 'ok');
  });

  document.getElementById('save-prefs')?.addEventListener('click', () => {
    const weeklyGuide = document.getElementById('weekly-guide') as HTMLInputElement;
    localStorage.setItem(PREF_KEY, JSON.stringify({ 'weekly-guide': weeklyGuide.checked }));
    const msg = document.querySelector('[data-prefs-msg]') as HTMLElement;
    msg.textContent = 'Saved to this browser.';
    msg.hidden = false;
  });
</script>

<style is:global>
  .acct-tabs { display: flex; gap: 8px; margin: 0 0 28px; flex-wrap: wrap; border-bottom: 1px solid #2c3647; }
  .acct-tab { background: transparent; border: none; border-bottom: 2px solid transparent; color: #8f96a3; padding: 12px 4px; margin-right: 24px; font-size: 15px; font-weight: 600; cursor: pointer; }
  .acct-tab[aria-selected="true"] { color: #fff; border-bottom-color: var(--gold); }
  .mform-note { font-size: 13px; color: #8f96a3; margin: 6px 0 0; }
</style>
