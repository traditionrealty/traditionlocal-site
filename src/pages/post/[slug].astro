---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import posts from '../../data/posts.json';
import { url, img, fmtDate, fixHtml } from '../../lib/util';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const related = posts.filter((p) => p.slug !== post.slug && p.categories.some((c) => post.categories.includes(c))).slice(0, 3);
const more = related.length ? related : posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description,
  datePublished: post.date, dateModified: post.updated, image: post.image,
  author: { '@type': 'Person', name: post.author }, publisher: { '@type': 'Organization', name: 'Tradition Local' },
};
---
<Base title={post.title} description={post.description} image={post.image} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <article class="wrap post">
    <header>
      <p class="crumbs"><a href={url('/all-articles')}>Articles</a>{post.categories.map((c) => <> / <a href={url(`/all-articles/categories/${c}`)}>{c[0].toUpperCase() + c.slice(1)}</a></>)}</p>
      {post.closed && <p class="closed-note"><span class="badge-closed">Closed</span> This business is no longer operating. The review below is kept for reference.</p>}
      <h1>{post.title}</h1>
      <p class="meta">By {post.author}, {fmtDate(post.date, { month: 'long', day: 'numeric', year: 'numeric' })}. {post.readMin} min read.</p>
    </header>
    {post.image && <img class="hero-img" src={img(post.image)} alt={post.imageAlt || post.title} />}
    {(post.website || post.directionsUrl || post.videoUrl) && (
      <div class="quick-links">
        {post.website && <a class="btn outline" href={post.website} target="_blank" rel="noopener">Visit website &rarr;</a>}
        {post.directionsUrl && <a class="btn outline" href={post.directionsUrl} target="_blank" rel="noopener">Get directions &rarr;</a>}
        {post.videoUrl && <a class="btn outline" href={post.videoUrl} target="_blank" rel="noopener">Watch video &rarr;</a>}
      </div>
    )}
    {post.photos && post.photos.length > 0 && (
      <div class="gallery-strip">
        {post.photos.map((p: { src: string; alt: string }) => (
          <img src={img(p.src)} alt={p.alt || post.title} loading="lazy" />
        ))}
      </div>
    )}
    <div class="prose" set:html={fixHtml(post.html)} />
    {post.mapEmbedSrc && (
      <div class="map-embed">
        <iframe src={post.mapEmbedSrc} width="100%" height="380" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
      </div>
    )}
  </article>
  <section class="section tint">
    <div class="wrap">
      <div class="section-head"><h2>Keep reading</h2><a href={url('/all-articles')}>All articles</a></div>
      <div class="grid">{more.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>
</Base>
<style>
  .post { padding-top: 48px; padding-bottom: 48px; max-width: 820px; }
  .crumbs { font-size: 14px; margin: 0 0 16px; }
  .crumbs a { text-decoration: none; }
  .post h1 { font-size: clamp(2rem, 4.4vw, 3rem); }
  .meta { color: var(--muted); margin: 0 0 28px; }
  .closed-note { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; background: var(--cream); border: 1px solid var(--line); border-radius: 6px; padding: 10px 14px; margin: 0 0 20px; font-size: 14px; color: var(--muted); }
  .badge-closed { flex-shrink: 0; background: #fff; color: var(--brown); border: 1px solid var(--brown); border-radius: 999px; padding: 3px 11px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; }
  .hero-img { width: 100%; max-height: 560px; object-fit: cover; border-radius: 6px; margin-bottom: 32px; }
  .quick-links { display: flex; gap: 10px; flex-wrap: wrap; margin: -16px 0 28px; }
  .quick-links .btn.outline { background: transparent; border: 1.5px solid var(--blue); color: var(--blue); padding: 9px 18px; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; }
  .quick-links .btn.outline:hover { background: var(--blue); color: #fff; }
  .gallery-strip { display: flex; gap: 10px; overflow-x: auto; margin: -8px 0 28px; }
  .gallery-strip img { width: 180px; height: 135px; object-fit: cover; border-radius: 8px; flex: none; }
  .map-embed { margin-top: 32px; border-radius: 8px; overflow: hidden; }
</style>
