---
import Base from '../layouts/Base.astro';
import areas from '../data/areas.json';
import { url } from '../lib/util';

const compareData = areas.map((a) => ({
  slug: a.slug,
  name: a.name,
  homes: a.homes || '[Home styles not yet written for this area]',
  vibe: a.vibe || '[Local life notes not yet written for this area]',
}));
const defaultA = areas.find((a) => a.slug === 'spring-branch') || areas[0];
const defaultB = areas.find((a) => a.slug === 'the-heights') || areas[1];

const PRIORITIES = [
  { key: 'home-styles', label: 'Home styles' },
  { key: 'daily-routes', label: 'Daily routes' },
  { key: 'local-life', label: 'Local life' },
  { key: 'costs', label: 'Costs to check' },
];
---
<Base title="Find Your Fit" description="Compare Houston neighborhoods side by side: home styles, daily routes, local life, and costs to check.">
  <section class="band">
    <div class="wrap">
      <p class="crumb"><a href={url('/make-it-home')}>Make It Home</a> <span aria-hidden="true">/</span> Compare Neighborhoods</p>
      <h1>Find Your Fit</h1>
      <p class="lede">A closer look at the neighborhoods you're considering. Compare everyday details, then explore the places that feel right for you.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="pickers">
        <label><span>First neighborhood</span>
          <select id="pick-a">{compareData.map((a) => <option value={a.slug} selected={a.slug === defaultA.slug}>{a.name}</option>)}</select>
        </label>
        <label><span>Second neighborhood</span>
          <select id="pick-b">{compareData.map((a) => <option value={a.slug} selected={a.slug === defaultB.slug}>{a.name}</option>)}</select>
        </label>
        <label><span>Third neighborhood &middot; optional</span>
          <select id="pick-c">
            <option value="">Add a third (optional)</option>
            {compareData.map((a) => <option value={a.slug}>{a.name}</option>)}
          </select>
        </label>
      </div>

      <h2>What matters to you?</h2>
      <div class="priority-chips" role="group" aria-label="Priorities">
        {PRIORITIES.map((p) => <button type="button" class="pchip" data-priority={p.key} aria-pressed="false">{p.label}</button>)}
      </div>
      <p class="muted small">Choose priorities to highlight them below.</p>
      <p class="disclaimer">Neighborhood descriptions below are written from our own guides. Daily routes and costs to check are not sourced yet and show as honest placeholders until we have real data.</p>

      <div class="compare-cols" id="compare-cols"></div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap visit-row">
      <div class="visit-copy">
        <p class="eyebrow">Take it beyond the screen</p>
        <h2>Try a day in each neighborhood.</h2>
        <p>Walk a few streets, stop for coffee, visit a park, and test your usual route at the time you'd actually travel.</p>
      </div>
      <div class="visit-card">
        <h3>Your neighborhood visit list</h3>
        <label class="visit-item"><input type="checkbox" /> Visit during a weekday and a weekend</label>
        <label class="visit-item"><input type="checkbox" /> Try your commute at your normal time</label>
        <label class="visit-item"><input type="checkbox" /> Check the errands you do most often</label>
        <label class="visit-item"><input type="checkbox" /> Note what you liked and what you'd change</label>
        <p class="muted small" id="visit-count">0 of 4 visit notes checked</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap shortlist-row">
      <div>
        <p class="eyebrow">Your shortlist, your pace</p>
        <h2>Want help connecting the dots?</h2>
        <p>Bring your questions and the neighborhoods you're considering.</p>
      </div>
      <a class="btn outline" href={url('/neighborhood-info-request')}>Talk with Dillon &rarr;</a>
    </div>
  </section>
</Base>

<script define:vars={{ compareData, url: url('/cities/') }}>
  const byslug = Object.fromEntries(compareData.map((a) => [a.slug, a]));
  const pickA = document.getElementById('pick-a');
  const pickB = document.getElementById('pick-b');
  const pickC = document.getElementById('pick-c');
  const cols = document.getElementById('compare-cols');
  const SECTIONS = [
    { key: 'home-styles', label: 'Home styles', field: 'homes' },
    { key: 'daily-routes', label: 'Your daily routes', ph: "[Compare access from different parts of the area to your daily destinations.]" },
    { key: 'local-life', label: 'Local life', field: 'vibe' },
    { key: 'costs', label: 'Costs to check', ph: '[Compare current housing costs, taxes, insurance, utilities, and any HOA fees.]' },
  ];
  let active = new Set();

  function card(area) {
    if (!area) return '';
    const sections = SECTIONS.map((s) => {
      const text = s.field ? area[s.field] : s.ph;
      const hi = active.has(s.key) ? ' hi' : '';
      return `<div class="cmp-row${hi}"><h4>${s.label}</h4><p>${text}</p></div>`;
    }).join('');
    return `<div class="cmp-col"><div class="cmp-head"><h3>${area.name}</h3><div class="cmp-actions"><a class="btn-sm" href="${url}${area.slug}/">Explore guide</a><button type="button" class="bookmark-btn" title="Saving neighborhoods isn't built yet" aria-label="Bookmark"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12v18l-6-4-6 4V3z"/></svg></button></div></div>${sections}</div>`;
  }
  function render() {
    const a = byslug[pickA.value];
    const b = byslug[pickB.value];
    const c = pickC.value ? byslug[pickC.value] : null;
    cols.innerHTML = card(a) + card(b) + (c ? card(c) : '');
  }
  [pickA, pickB, pickC].forEach((el) => el.addEventListener('change', render));
  document.querySelectorAll('.pchip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.priority;
      if (active.has(key)) { active.delete(key); chip.setAttribute('aria-pressed', 'false'); }
      else { active.add(key); chip.setAttribute('aria-pressed', 'true'); }
      render();
    });
  });
  render();

  const visitBoxes = document.querySelectorAll('.visit-item input');
  const visitCount = document.getElementById('visit-count');
  visitBoxes.forEach((box) => box.addEventListener('change', () => {
    const n = [...visitBoxes].filter((b) => b.checked).length;
    visitCount.textContent = `${n} of ${visitBoxes.length} visit notes checked`;
  }));
</script>
<style>
  .crumb { font-size: 13px; color: rgba(255,255,255,.65); margin: 0 0 12px; }
  .crumb a { color: rgba(255,255,255,.65); }
  .lede { max-width: 56ch; }

  .pickers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; background: var(--cream); border-radius: 12px; padding: 24px; margin-bottom: 32px; }
  .pickers label span { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--navy); }
  .pickers select { width: 100%; padding: 11px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; font-size: 15px; }

  .priority-chips { display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0 8px; }
  .pchip { padding: 9px 18px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font-size: 14px; font-weight: 600; color: var(--navy); cursor: pointer; }
  .pchip[aria-pressed="true"] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .disclaimer { font-size: 13px; font-style: italic; color: var(--muted); margin: 10px 0 28px; }

  .compare-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .cmp-col { background: var(--cream); border-radius: 12px; overflow: hidden; }
  .cmp-head { padding: 22px 22px 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .cmp-head h3 { margin: 0; font-size: 1.3rem; }
  .cmp-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }
  .btn-sm { background: var(--navy); color: #fff; padding: 7px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .bookmark-btn { background: none; border: 1px solid var(--line); border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; color: var(--navy); cursor: pointer; }
  .cmp-row { padding: 16px 22px; border-top: 1px solid var(--line); }
  .cmp-row.hi { background: var(--gold-soft); }
  .cmp-row h4 { margin: 0 0 4px; font-size: .9rem; color: var(--brown); }
  .cmp-row p { margin: 0; font-size: 14px; color: var(--muted); }

  .visit-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .eyebrow { color: #1e7a43; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  .visit-card { background: #fff; border-radius: 12px; padding: 24px; }
  .visit-card h3 { margin: 0 0 14px; font-size: 1.1rem; }
  .visit-item { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .visit-item:first-of-type { border-top: none; }

  .shortlist-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .shortlist-row p.eyebrow { margin: 0 0 8px; }
  .shortlist-row p:last-child { color: var(--muted); max-width: 46ch; margin: 6px 0 0; }

  @media (max-width: 860px) {
    .pickers, .visit-row { grid-template-columns: 1fr; }
  }
</style>
