---
// Events merged into the Things to Do page. Redirect anyone with an old link.
import { url } from '../lib/util';
const dest = url('/living#featured');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={dest} />
  <title>Redirecting…</title>
</head>
<body>
  <p>This page moved. <a href={dest}>Continue to Things to Do</a>.</p>
</body>
</html>
