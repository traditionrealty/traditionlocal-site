---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import posts from '../data/posts.json';
import events from '../data/events.json';
import areaEvents from '../data/area-events.json';
import site from '../data/site.json';
import polls from '../data/polls.json';
import areas from '../data/areas.json';
import businesses from '../data/businesses.json';
import { url, img, fmtDate } from '../lib/util';
import { config } from '../config';
import { houstonToday, weekFor, weekRange, weekendFor, rangeLabel, buildWeek, buildWeekend, rowsFromCards, renderRows, addDays, BIZ_CATS_ALL } from '../lib/weekend';
import newsletters from '../data/newsletters.json';
import { mondayOf, pickForWeek, lastWeekEdition, summarizeEdition, renderHeadlines } from '../lib/weekly';

const [lead, ...rest] = posts;
const latest = rest.slice(0, 6);
const spotlight = posts.find((p) => p.categories.includes('spotlight')) || posts.find((p) => /mother/i.test(p.title));
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date && e.date >= today).slice(0, 3);
const upcomingAll = events.filter((e) => e.date && e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
// Picks whichever week's row in data/polls.json (sourced from data/raw/reader-polls.csv)
// contains today, falling back to the first entry if today is before the schedule starts.
const todayISO = new Date().toISOString().slice(0, 10);
const currentPoll = [...(polls as { start: string; question: string; options: string[] }[])].reverse().find((p) => p.start <= todayISO) || polls[0];

// "This week" (Monday to Thursday) and "This weekend" (Friday to Sunday) are built from real dated
// events: our own events first, then the Houston area calendar. A day with no event falls back to a
// Sara's Pick or Local Favorite. The logic lives in src/lib/weekend.ts and runs again in the browser,
// so both lists stay current even if the site has not been rebuilt this week.
const CHAINS = ['Starbucks', 'Dunkin', 'Tim Hortons', 'Krispy Kreme', 'Baskin', 'Dairy Queen', 'Cold Stone', 'Marble Slab', 'Crumbl', 'Insomnia', 'Smoothie King', 'Jamba', 'Panera', 'Einstein', 'IHOP', 'Denny', 'Black Bear Diner', 'Nothing Bundt'];
const hwToday = houstonToday();
const hwFrom = addDays(hwToday, -3);
const hwTo = addDays(hwToday, 28);
const hwEvents = [
  ...events.map((e) => ({ id: 'tl-' + e.slug, cat: 'Tradition Local', date: e.date, title: e.title.replace(/\s*\[.*?\]\s*/g, ' ').trim(), venue: e.venue, href: url('/event-details/' + e.slug), tl: true })),
  ...(areaEvents as any[]).map((e) => ({ id: e.id, cat: e.cat, date: e.date, end: e.end || '', title: e.title, venue: e.venue, href: e.url || '', feat: !!e.feat })),
].filter((e) => e.date && (e.end || e.date) >= hwFrom && e.date <= hwTo);
const hwBiz = (businesses as any[])
  .filter((b) => (b.categories || []).some((c: string) => BIZ_CATS_ALL.includes(c)) && !CHAINS.some((n) => b.name.indexOf(n) > -1))
  .map((b) => ({ slug: b.slug, name: b.name, area: b.neighborhood || b.city || '', cats: (b.categories || []).filter((c: string) => BIZ_CATS_ALL.includes(c)), href: url('/eat/' + b.slug), pick: !!b.saraPick, fav: b.rating === 'favorite' }));
const hwData = { events: hwEvents, biz: hwBiz, ideas: [] };
const hwJson = JSON.stringify(hwData).replace(/</g, '\\u003c');
const hwWeek = weekFor(hwToday);
const hwWeekRows = renderRows(buildWeek(hwData as any, hwWeek.mon, hwToday));
const hwWeekend = weekendFor(hwToday);
const hwWeekendRows = renderRows(rowsFromCards(buildWeekend(hwData as any, hwWeekend, hwToday)));
const picks = businesses.filter((b) => b.saraPick).sort((a, b) => b.reviewYear - a.reviewYear).slice(0, 8);
const featuredAreas = ['sugar-land', 'the-heights', 'katy', 'memorial-villages', 'montrose', 'bellaire']
  .map((s) => areas.find((a) => a.slug === s)).filter(Boolean);

// "This weekend in Houston" + "Tradition Local events" + "Something new every week" strip,
// below Neighborhood guides. Real data wherever we have it (the actual next Coffee &
// Conversations, the actual upcoming events list, the same daily neighborhood rotation cities.astro
// uses, the actual current month, and real "Opened this month" entries); honest bracketed
// placeholders everywhere else, same convention used across the rest of the site.
const ccEvent = upcoming.find((e) => e.title.includes('Coffee & Conversations'));
const ccDay = ccEvent ? fmtDate(ccEvent.date, { weekday: 'long' }) : null;
// The Perfect Saturday card features a different area each week, stepping through every area that
// qualifies before any repeats. An area qualifies when it has a coffee spot and a separate lunch
// spot among its reviewed businesses and at least five businesses in all, so its Perfect Saturday
// page is mostly real. The list grows on its own as more areas are reviewed.
const LUNCH_CATS = ['Sandwiches', 'Mexican', 'Tex-Mex', 'American', 'Mediterranean', 'Vietnamese', 'Indian', 'Chinese', 'Halal', 'Middle Eastern', 'Cajun/Creole', 'Breakfast & Brunch'];
const psPool = (areas as any[]).map((a) => {
  const eats = (businesses as any[]).filter((b) => b.area === a.slug).sort((x, y) => Number(y.saraPick) - Number(x.saraPick));
  const coffee = eats.find((b) => b.categories.includes('Coffee & Tea'));
  const lunch = eats.find((b) => b.slug !== coffee?.slug && LUNCH_CATS.some((c) => b.categories.includes(c)));
  return { name: a.name, href: url('/cities/' + a.slug) + '#do', n: eats.length, ok: !!(coffee && lunch), slug: a.slug };
}).filter((x) => x.ok && x.n >= 5).sort((x, y) => y.n - x.n || x.slug.localeCompare(y.slug));
const psArea = pickForWeek(psPool, hwToday);
const psPoolJson = JSON.stringify(psPool.map((p) => ({ name: p.name, href: p.href })));

// "Last week's headlines" shows the newsletter for the week that just ended and changes every Monday.
const hlList = (newsletters as any[]).map((e) => summarizeEdition(e, url('/newsletters/' + e.slug)));
const hlEdition = lastWeekEdition(hlList, hwToday);
const hlHtml = renderHeadlines(hlEdition);
const hlJson = JSON.stringify(hlList).replace(/</g, '\\u003c');
const currentMonthName = new Date().toLocaleDateString('en-US', { month: 'long', timeZone: 'America/Chicago' });
const worthTheDrivePick = (businesses as any[]).filter((b) => b.rating === 'visit').sort((a, b) => b.reviewYear - a.reviewYear)[0];

// "Where should we go?" homepage finder
const finderCatCounts: Record<string, number> = {};
businesses.forEach((b) => b.categories.forEach((c) => (finderCatCounts[c] = (finderCatCounts[c] || 0) + 1)));
const finderCats = Object.entries(finderCatCounts).sort((a, b) => b[1] - a[1]).slice(0, 18).map(([c]) => c);
const finderAreas = [...new Set(businesses.map((b) => b.neighborhood || b.city))].filter(Boolean).sort();
const finderData = businesses.map((b) => ({
  slug: b.slug, name: b.name, cats: b.categories, where: b.neighborhood || b.city, pick: !!b.saraPick,
}));
const basePath = url('/').replace(/\/$/, '');
---
<Base>
  <section class="band finder">
    <div class="wrap">
      <div class="finder-intro">
        <h1>Where should we go?</h1>
        <p class="finder-lede">Discover Houston. Feel more at home.</p>
      </div>
      <div class="finder-grid">
        <div class="finder-copy">
          <div class="finder-sentence">
            <p class="fs-line">I want
              <select id="f-cat" aria-label="What are you looking for">
                {finderCats.map((c) => <option value={c}>{c}</option>)}
              </select>
            </p>
            <p class="fs-line">in
              <select id="f-area" aria-label="Which area">
                <option value="">anywhere</option>
                {finderAreas.map((a) => <option value={a}>{a}</option>)}
              </select>
            </p>
            <p class="fs-line">for
              <select id="f-vibe" aria-label="What kind of visit">
                <option value="anything">anything</option>
                <option value="a quick bite">a quick bite</option>
                <option value="a date">a date</option>
                <option value="the family">the family</option>
                <option value="working">working</option>
              </select>.
            </p>
          </div>
          <button type="button" class="surprise" id="f-surprise">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h4l9 14h4M3 19h4l3-3.5M15 5h4l2 2.5M15 5l2 2.5M19 19l2-2.5M19 19l-2-2.5" /></svg>
            Not sure? Surprise me
          </button>
        </div>
        <div class="finder-panel">
          <p class="panel-head"><span id="f-count">2</span><span id="f-count-label"> spots for you</span></p>
          <ul id="f-list"></ul>
          <a class="panel-all" href={url('/food')}>See all in Eat &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ finderData, basePath }}>
    const catSel = document.getElementById('f-cat');
    const areaSel = document.getElementById('f-area');
    const list = document.getElementById('f-list');
    const countEl = document.getElementById('f-count');
    const labelEl = document.getElementById('f-count-label');

    function render() {
      const cat = catSel.value;
      const area = areaSel.value;
      let matches = finderData.filter((b) => b.cats.includes(cat) && (!area || b.where === area));
      if (!matches.length) matches = finderData.filter((b) => b.cats.includes(cat));
      if (!matches.length) matches = finderData.filter((b) => b.pick);
      matches.sort((a, b) => Number(b.pick) - Number(a.pick));
      const top = matches.slice(0, 2);
      list.innerHTML = top.map((b) =>
        `<li><a href="${basePath}/eat/${b.slug}/"><strong>${b.name}</strong><span>${b.pick ? "Sara's pick" : b.cats[0]} &middot; ${b.where}</span></a></li>`
      ).join('');
      countEl.textContent = String(top.length);
      labelEl.textContent = top.length === 1 ? ' spot for you' : ' spots for you';
    }
    catSel.addEventListener('change', render);
    areaSel.addEventListener('change', render);
    render();

    document.getElementById('f-surprise').addEventListener('click', () => {
      const picks = finderData.filter((b) => b.pick);
      const pool = picks.length ? picks : finderData;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      window.location.href = `${basePath}/eat/${pick.slug}/`;
    });
  </script>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>What's new</h2><a href={url('/all-articles')}>View all posts</a></div>
      <PostCard post={lead} large />
      <div class="grid three">{latest.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap split">
      {spotlight && (
        <div>
          <div class="section-head"><h2>Feature spotlight</h2></div>
          <PostCard post={spotlight} />
        </div>
      )}
      <div>
        <div class="section-head"><h2>Meet the editors</h2><a href={url('/about')}>More about Tradition Local</a></div>
        <div class="editor-split">
          <div class="editor-card">
            <div class="editor-top">
              <span class="avatar" data-tone="warm">SL</span>
              <p class="tag">Food, Stories &amp; Community</p>
            </div>
            <h3>Sara Loren</h3>
            <p>Discover the people behind the places through Sara's firsthand reviews, local stories, and conversations.</p>
            <a class="btn-meet" href={url('/meet-sara')}>Meet Sara &nearr;</a>
          </div>
          <div class="editor-card">
            <div class="editor-top">
              <span class="avatar" data-tone="cool">DL</span>
              <p class="tag">Neighborhoods, Homes &amp; Connection</p>
            </div>
            <h3>Dillon Loren</h3>
            <p>Explore Houston with Dillon's neighborhood curiosity and thoughtful guidance for your next real estate chapter.</p>
            <a class="btn-meet" href={url('/meet-dillon')}>Meet Dillon &nearr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Sara's picks</h2><a href={url('/about-our-reviews')}>See all our reviews</a></div>
      <div class="picks">
        {picks.map((b) => (
          <a class="pick" href={url(`/eat/${b.slug}`)}>
            {b.heroImage ? (
              <img class="pick-img" src={url(b.heroImage)} alt={`${b.name} photo`} width="200" height="130" loading="lazy" />
            ) : (
              <div class="pick-img pick-img-ph">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
              </div>
            )}
            <span class="cat">{b.categories[0]}</span>
            <strong>{b.name}</strong>
            <span class="muted">{b.neighborhood || b.city}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="section-head"><h2>Neighborhood guides</h2><a href={url('/cities')}>All {areas.length} guides</a></div>
      <div class="grid three">
        {featuredAreas.map((a: any) => (
          <a class="area" href={url(`/cities/${a.slug}`)}>
            <strong>{a.name}</strong>
            <span>{a.vibe}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="hw-head">
        <h2>What's happening in Houston</h2>
        <p class="hw-lede">Real events for each day, chosen from our own events and the Houston area calendar. On a quiet day, we point you to a neighborhood spot worth a visit.</p>
      </div>
      <div class="grid2">
        <div>
          <p class="eyebrow">Updated weekly</p>
          <h3 class="hw-title" id="hw-week-title">{hwWeek.next ? 'Next week' : 'This week'}</h3>
          <p class="muted small hw-range" id="hw-week-range">{weekRange(hwWeek.mon)}</p>
          <div class="hw-grid" id="hw-week" data-mon={hwWeek.mon} data-day={hwToday} set:html={hwWeekRows}></div>
          <a class="see-more" href={url('/living#calendar')}>See the full calendar &rarr;</a>
        </div>
        <div>
          <p class="eyebrow">Updated weekly</p>
          <h3 class="hw-title">This weekend</h3>
          <p class="muted small hw-range" id="hw-weekend-range">{rangeLabel(hwWeekend)}</p>
          <div class="hw-grid" id="hw-weekend" data-fri={hwWeekend.fri} data-day={hwToday} set:html={hwWeekendRows}></div>
          <a class="see-more" href={url('/living#weekend')}>See the full weekend list &rarr;</a>
        </div>
      </div>
      <script type="application/json" id="hw-data" is:inline set:html={hwJson}></script>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Our series</p>
      <h2>Something new every week</h2>
      <div class="series-grid">
        <div class="series-card gold">
          <h3>Worth the Drive</h3>
          <p>One spot a week that's worth leaving your neighborhood for.</p>
          {worthTheDrivePick ? (<a class="latest" href={url(`/eat/${worthTheDrivePick.slug}`)}>Latest: {worthTheDrivePick.name} &rarr;</a>) : (<a class="latest ph-text" href={url('/food')}>Latest: [Spot name] &rarr;</a>)}
        </div>
        <div class="series-card green">
          <h3>The Perfect Saturday</h3>
          <p>Breakfast, a park, a shop, and dinner, all in one city.</p>
          <a class="latest" id="ps-link" data-week={mondayOf(hwToday)} data-pool={psPoolJson} href={psArea ? psArea.href : url('/cities')}>Latest: {psArea ? psArea.name : 'Houston areas'} &rarr;</a>
        </div>
        <div class="series-card light">
          <h3>New and Notable</h3>
          <p>Every restaurant and shop that opened this month.</p>
          <a class="latest" href={url('/food')}>Latest: {currentMonthName} openings &rarr;</a>
        </div>
        <div class="series-card dark">
          <h3>Reader Picks</h3>
          <p>You vote, we visit. The community's favorite spot each week.</p>
          <a class="latest" href={url('/neighborhood-info-request')}>Vote this week &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">Your Houston, your picks</p>
      <h2>Join the conversation</h2>
      <div class="join-grid">
        <div class="join-card">
          <div data-poll-vote>
            <p class="eyebrow small">This week's reader poll</p>
            <h3>{currentPoll.question}</h3>
            <form class="poll-form" id="poll-form" data-poll-question={currentPoll.question}>
              {currentPoll.options.map((opt: string) => (
                <label class="poll-option"><input type="radio" name="poll" required /> <span>{opt}</span></label>
              ))}
              <button class="btn blue" type="submit">Vote</button>
            </form>
          </div>
          <div data-poll-thanks hidden>
            <p class="eyebrow small">Thanks for voting</p>
            <h3>Thank you for contributing to the poll!</h3>
            <div data-poll-guest hidden>
              <p class="muted">Create a free account to vote every week, save your favorite spots, and get member perks and local events first.</p>
              <a class="btn blue" href={url('/join')}>Create my free account &rarr;</a>
            </div>
            <div data-poll-member hidden>
              <p class="muted">Good to see you. Where would you like to go next?</p>
              <div class="poll-member-links">
                <a class="btn outline small" href={url('/food')}>Food &rarr;</a>
                <a class="btn outline small" href={url('/cities')}>Neighborhoods &rarr;</a>
                <a class="btn outline small" href={url('/living')}>Things To Do &rarr;</a>
              </div>
            </div>
          </div>
        </div>
        <div class="join-card">
          <p class="eyebrow small">Suggest a spot</p>
          <h3>Know a place we should visit?</h3>
          <p class="muted">Reader picks get reviewed and featured, with credit to you.</p>
          <form class="suggest-form" onsubmit="return false;">
            <label><span>Place name</span>
              <input type="text" placeholder="e.g. your favorite taco truck" />
            </label>
            <label><span>City or neighborhood</span>
              <input type="text" placeholder="e.g. Katy" />
            </label>
            <button class="btn blue" type="submit">Send my pick</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="journey">
    <div class="wrap journey-inner">
      <div>
        <h2>Start your next journey</h2>
        <p>Exploring neighborhoods, schools, food, and local life in Greater Houston? When the time comes, Dillon and {config.brokerage.name} are here to help you make the right move.</p>
      </div>
      <a class="btn gold" href={url('/meet-dillon')}>Meet Dillon</a>
    </div>
  </section>

  {site.videos.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>Local videos</h2><a href={site.social.youtube}>Watch on YouTube</a></div>
        <div class="videos">
          {site.videos.map((v: string) => (
            <a href={`https://www.youtube.com/watch?v=${v}`} class="video">
              <img src={`https://i.ytimg.com/vi/${v}/mqdefault.jpg`} alt="Tradition Local video" loading="lazy" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section sponsors">
    <div class="wrap">
      <h2>Our sponsors</h2>
      <div class="sponsor-row">{site.sponsors.map((s: string) => <img src={img(s)} alt="Sponsor logo" loading="lazy" />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
        <p class="eyebrow">Last week's headlines</p>
        <h2>See what you will get</h2>
        <div class="issue-card" id="hl-card" data-slug={hlEdition ? hlEdition.slug : ''} set:html={hlHtml}></div>
        <script type="application/json" id="hl-data" is:inline set:html={hlJson}></script>
    </div>
  </section>
</Base>

<script>
  import { membersReady, currentUser, supabase } from '../lib/members';
  const form = document.getElementById('poll-form') as HTMLFormElement | null;
  const voteBox = document.querySelector<HTMLElement>('[data-poll-vote]');
  const thanksBox = document.querySelector<HTMLElement>('[data-poll-thanks]');
  const guestBox = document.querySelector<HTMLElement>('[data-poll-guest]');
  const memberBox = document.querySelector<HTMLElement>('[data-poll-member]');
  if (form && voteBox && thanksBox && guestBox && memberBox) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const selected = (form.querySelector('input[name="poll"]:checked') as HTMLInputElement | null)?.nextElementSibling?.textContent?.trim() || '';
      const user = membersReady ? await currentUser() : null;
      voteBox.hidden = true;
      thanksBox.hidden = false;
      guestBox.hidden = Boolean(user);
      memberBox.hidden = !user;
      // Recording the vote is best-effort: if the poll_votes table hasn't been created yet
      // (see supabase/schema.sql) or the insert fails for any other reason, the thank-you
      // message above has already shown, so a voter never sees an error for this.
      if (membersReady && selected) {
        try {
          await supabase().from('poll_votes').insert({
            poll_question: form.dataset.pollQuestion || '',
            selected_option: selected,
            user_id: user?.id ?? null,
          });
        } catch { /* best-effort only, see comment above */ }
      }
    });
  }
</script>

<script>
import { houstonToday, weekFor, weekRange, weekendFor, rangeLabel, buildWeek, buildWeekend, rowsFromCards, renderRows } from '../lib/weekend';

const dataEl = document.getElementById('hw-data');
const weekEl = document.getElementById('hw-week');
const weekendEl = document.getElementById('hw-weekend');
if (dataEl && weekEl && weekendEl) {
  try {
    const today = houstonToday();
    // Re-pick only when the page was built on a different day than the one being viewed.
    if (weekEl.dataset.day !== today) {
      const data = JSON.parse(dataEl.textContent || '{}');
      const wk = weekFor(today);
      weekEl.innerHTML = renderRows(buildWeek(data, wk.mon, today));
      weekEl.dataset.day = today;
      const title = document.getElementById('hw-week-title');
      if (title) title.textContent = wk.next ? 'Next week' : 'This week';
      const r1 = document.getElementById('hw-week-range');
      if (r1) r1.textContent = weekRange(wk.mon);
      const w = weekendFor(today);
      weekendEl.innerHTML = renderRows(rowsFromCards(buildWeekend(data, w, today)));
      weekendEl.dataset.day = today;
      const r2 = document.getElementById('hw-weekend-range');
      if (r2) r2.textContent = rangeLabel(w);
    }
  } catch (e) {
    // Keep the version built with the page.
  }
}
</script>

<script>
import { houstonToday } from '../lib/weekend';
import { mondayOf, pickForWeek, lastWeekEdition, renderHeadlines } from '../lib/weekly';

const today = houstonToday();
const ps = document.getElementById('ps-link');
if (ps) {
  try {
    // A new Perfect Saturday area every Monday.
    if (ps.dataset.week !== mondayOf(today)) {
      const pick = pickForWeek(JSON.parse(ps.dataset.pool || '[]'), today);
      if (pick) {
        ps.setAttribute('href', pick.href);
        ps.textContent = 'Latest: ' + pick.name + ' \u2192';
      }
      ps.dataset.week = mondayOf(today);
    }
  } catch (e) {
    // Keep the version built with the page.
  }
}
const card = document.getElementById('hl-card');
const hlData = document.getElementById('hl-data');
if (card && hlData) {
  try {
    // The headlines card moves to the previous week's newsletter every Monday.
    const ed = lastWeekEdition(JSON.parse(hlData.textContent || '[]'), today);
    if (ed && card.dataset.slug !== ed.slug) {
      card.innerHTML = renderHeadlines(ed);
      card.dataset.slug = ed.slug;
    }
  } catch (e) {
    // Keep the version built with the page.
  }
}
</script>

