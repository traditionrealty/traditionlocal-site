---
import Base from '../layouts/Base.astro';
import areas from '../data/areas.json';
import posts from '../data/posts.json';
import { config } from '../config';
import { url, img, RATING_LABELS } from '../lib/util';
import { directoryListings, GROUPS, GROUP_LABEL } from '../lib/directory';

const listings = directoryListings();
const SHOW = 12;
const wcount: Record<string, number> = {};
listings.forEach((b) => { wcount[b.where] = (wcount[b.where] || 0) + 1; });
const wnames = Object.keys(wcount).sort((a, b) => wcount[b] - wcount[a] || a.localeCompare(b));
const catSet = new Set<string>();
listings.forEach((b) => b.cats.forEach((c) => catSet.add(c)));
const pickN = listings.filter((b) => b.pick).length;
const groupCount = (g: string) => (g ? listings.filter((b) => b.group === g).length : listings.length);

// Area columns: the six areas with the most listings that also have a neighborhood guide.
const guideSlug: Record<string, string> = {};
(areas as any[]).forEach((a) => { guideSlug[a.name.trim().toLowerCase()] = a.slug; });
const cols = wnames.filter((w) => guideSlug[w.toLowerCase()]).slice(0, 6).map((w) => ({ w, slug: guideSlug[w.toLowerCase()] }));
const count = (w: string, g: string) => listings.filter((b) => b.where === w && (!g || b.group === g)).length;
const near = cols.map((c) => ({ ...c, biz: listings.find((b) => b.where === c.w) })).filter((c) => c.biz);

// Real partner spotlights come from posts titled "Business Spotlight: <name> in <area>".
const spotlights = (posts as any[]).filter((p) => /^business spotlight:/i.test(p.title)).map((p) => {
  const t = String(p.title).replace(/^business spotlight:\s*/i, '');
  const m = t.match(/^(.*?)\s+in\s+(.+?)(?:\s+neighborhood)?$/i);
  const name = (m && m[1]) || t;
  const area = (m && m[2]) || '';
  const d = String(p.description || '').replace(/\s+/g, ' ').replace(/\.([A-Z])/g, '. $1');
  const k = d.indexOf(name + ' is');
  const sents = (k > -1 ? d.slice(k) : d).split(/(?<=[.!?])\s/);
  return { name, area, path: p.path as string, image: p.image as string | undefined, blurb: sents.slice(0, 2).join(' ') };
});
// A real review to point to: the newest rated listing outside food and drink.
const sample = listings.filter((b) => b.group !== 'food' && b.rating).sort((a, b) => Number(b.pick) - Number(a.pick) || b.year - a.year)[0];

const SV = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const PATHS: Record<string, string> = {
  food: '<path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h2a2 2 0 0 1 0 4h-2M8 3v2M12 3v2"/>',
  shops: '<path d="M4 9l1-5h14l1 5"/><path d="M5 9v11h14V9"/><path d="M10 20v-6h4v6"/>',
  home: '<path d="M14 6a4 4 0 0 0-5 5L3 17l4 4 6-6a4 4 0 0 0 5-5l-3 3-3-1-1-3z"/>',
  health: '<path d="M12 21c-5-3-8-7-8-11a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 4-3 8-8 11z"/>',
  parks: '<circle cx="12" cy="9" r="6"/><path d="M12 15v6M9 21h6"/>',
};
const icon = (g: string, s: number) => '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" ' + SV + '>' + (PATHS[g] || PATHS.shops) + '</svg>';
const BOOK = '<svg width="16" height="18" viewBox="0 0 16 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 2h10v14l-5-3.5L3 16z"/></svg>';
const TIP_ICONS = [
  '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/>',
  '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/>',
];
const tips = [
  { t: 'Build a maintenance routine', d: 'Keep upkeep visible instead of letting it slip.' },
  { t: 'Notice small changes early', d: 'Pay attention to concerns before they become familiar.' },
  { t: 'Plan the next right step', d: 'Turn a concern into a clear request for help.' },
];
const bar = [['spotlight', 'Spotlight'], ['find', 'Find help'], ['suggest', 'Suggest'], ['care', 'Home care'], ['reviews', 'Reviews'], ['vendors', 'Vendors'], ['near', 'Near you'], ['areas', 'By area']];
const areaItems = [['', 'All local businesses'], ['food', 'Food & coffee'], ['shops', 'Shops & everyday services'], ['home', 'Home services & maintenance']];
---
<Base title="Local Directory" description="Restaurants, cafes, shops, and services across Greater Houston, with our reviews, partner spotlights, and helpful guides in one place.">
  <section class="band dr-band">
    <div class="wrap">
      <p class="dr-crumb"><a href={url('/')}>Home</a> <span aria-hidden="true">&rsaquo;</span> Local Directory</p>
      <span class="dr-tag">Local businesses &middot; Helpful resources</span>
      <h1>Local Directory</h1>
      <p class="dr-lead">Good people. Useful connections. Discover local businesses, meet the people behind them, and find help for everyday life and caring for your home.</p>
      <div class="dr-stats">
        <div><b>{listings.length}</b><span>Local businesses</span></div>
        <div><b>{pickN}</b><span>Sara's picks</span></div>
        <div><b>{wnames.length}</b><span>Areas covered</span></div>
        <div><b>{catSet.size}</b><span>Categories</span></div>
      </div>
      <div class="dr-btns" data-state="in" hidden><a class="dr-pill gold" href="#find">Find a local business</a><a class="dr-pill white" href="#care">Explore home care tips</a></div>
      <div class="dr-btns" data-state="out" hidden><a class="dr-pill gold" href={url('/join')}>Join free</a><a class="dr-pill white" href={url('/sign-in')}>Sign in</a></div>
    </div>
  </section>

  <div data-state="out" hidden>
    <section class="dr-blk wrap">
      <div class="dr-gate">
        <h2>This directory is for members</h2>
        <p>Sign in or join free to browse the full directory, partner spotlights, and helpful guides.</p>
        <p><a class="dr-pill gold" href={url('/sign-in')}>Sign in</a> <a class="dr-pill line" href={url('/join')}>Join free</a></p>
      </div>
    </section>
  </div>

  <div data-state="in" hidden>
    <div class="dr-bar">
      <div class="wrap dr-barin">
        <nav class="dr-barlist" aria-label="Sections on this page">{bar.map((b, i) => <a href={'#' + b[0]} data-sec={b[0]} class={i === 0 ? 'on' : ''}>{b[1]}</a>)}</nav>
        <span class="dr-best">Best for: Finding help, meeting local owners, and caring for your home</span>
      </div>
    </div>

    {spotlights.length > 0 && (
      <section class="dr-blk wrap" id="spotlight">
        <div class="dr-sechead"><div><h2>Business spotlight</h2></div>{spotlights.length > 1 && <button class="dr-linkbtn" type="button" id="dr-spotnext">See another &rarr;</button>}</div>
        {spotlights.map((s, i) => (
          <div class="dr-spot" hidden={i > 0} data-spot>
            <div class="tile">
              {s.image ? <img src={img(s.image, 700)} alt="" /> : <><span aria-hidden="true" set:html={icon('shops', 34)}></span><h3>{s.name}</h3><span class="ph">[Business photo]</span></>}
            </div>
            <div class="body">
              <span class="tg">Meet your local</span>
              <h3 class="t">Every storefront has a story.</h3>
              <p>{s.blurb}</p>
              <p class="meta">Partner spotlight{s.area ? ' · ' + s.area : ''}. Partner spotlights are paid features, always labeled. Our reviews are never for sale.</p>
              <div class="acts"><a class="dr-pill gold" href={url(s.path)}>Read the spotlight</a></div>
            </div>
          </div>
        ))}
      </section>
    )}

    <section class="dr-blk wrap" id="find">
      <span id="trending"></span>
      <div class="dr-sechead"><div><h2>Who can help?</h2></div><span class="dr-badge">Every card opens its business profile</span></div>
      <div class="dr-filters">
        <label>Search businesses or services<input type="search" id="dr-q" placeholder="Try a cafe, local shop, or home service" /></label>
        <label>Category<select id="dr-cat">{GROUPS.map((g) => <option value={g.id}>{g.label} ({groupCount(g.id)})</option>)}</select></label>
        <label>Area<select id="dr-area"><option value="">All areas</option>{wnames.map((w) => <option value={w}>{w} ({wcount[w]})</option>)}</select></label>
      </div>
      <div class="dr-tabs" id="dr-tabs" role="group" aria-label="Browse by category">
        {GROUPS.map((g, i) => <button class="dr-tab" type="button" data-g={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>)}
        <button class="dr-tab saved" type="button" id="dr-savedBtn" aria-pressed="false">Saved (0)</button>
      </div>
      <p class="dr-count" id="dr-count" aria-live="polite">{listings.length} businesses</p>
      <div class="dr-grid" id="dr-grid">
        {listings.map((b, i) => (
          <article class="dr-bcard" hidden={i >= SHOW} data-slug={b.slug} data-g={b.group} data-w={b.where} data-text={(b.name + ' ' + b.cats.join(' ') + ' ' + b.where + ' ' + b.desc).toLowerCase()}>
            <div class="band2">
              <span aria-hidden="true" set:html={icon(b.group, 24)}></span>
              <span class="lab">{GROUP_LABEL[b.group]}</span>
              {b.pick ? <span class="rb pick">Sara's Pick</span> : b.rating && RATING_LABELS[b.rating] ? <span class="rb">{RATING_LABELS[b.rating]}</span> : null}
            </div>
            <div class="body">
              <h3><a href={url('/eat/' + b.slug)}>{b.name}</a></h3>
              <div class="where">{b.where}</div>
              <div class="cats">{b.cats.join(', ')}</div>
              <p>{b.desc}</p>
              <div class="row">
                <a class="dr-pill line sm" href={url('/eat/' + b.slug)}>View profile &rarr;</a>
                <button class="dr-save" type="button" data-save={b.slug} aria-pressed="false" aria-label={'Save business: ' + b.name} set:html={BOOK}></button>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="dr-empty" id="dr-empty" hidden>No businesses match those filters. Try another category or area.</div>
      <div class="dr-more"><button class="dr-pill line" type="button" id="dr-more" hidden={listings.length <= SHOW}>Show more businesses</button></div>
      <noscript><style>.dr-bcard[hidden] { display: flex; }</style></noscript>
    </section>

    <section class="dr-blk wrap" id="suggest">
      <div class="dr-suggest">
        <div><p class="eb">Help us discover more</p><h2>Know a business worth knowing?</h2><p>Recommend a local find or share your business for editorial consideration.</p></div>
        <form id="dr-sugform" data-email={config.contactEmail} novalidate>
          <label for="dr-sugname">Business name</label>
          <input id="dr-sugname" type="text" placeholder="Tell us who to explore" autocomplete="off" />
          <button type="submit">Suggest a business</button>
        </form>
      </div>
    </section>

    <section class="dr-blk wrap" id="care">
      <div class="dr-care">
        <p class="eb">Care for your home</p>
        <h2>Small upkeep. Fewer costly surprises.</h2>
        <p class="lead2">Deferred maintenance is postponed upkeep. Learn what to watch for, keep a record of concerns, and address small issues before they grow.</p>
        <div class="dr-tips">
          {tips.map((t, i) => (
            <div class="dr-tip">
              <span class="ic" set:html={'<svg width="30" height="30" viewBox="0 0 24 24" ' + SV + '>' + TIP_ICONS[i] + '</svg>'}></span>
              <h3>{t.t}</h3>
              <p>{t.d}</p>
              <button class="dr-pill sm" type="button" data-tip={i}>Explore tip</button>
            </div>
          ))}
        </div>
        <p class="fine">Guides are in progress. Each one will connect a practical checklist with the relevant service category.</p>
      </div>
    </section>

    <section class="dr-blk wrap" id="reviews">
      <div class="dr-sechead"><div><h2>Reviews with a local perspective.</h2></div><span class="dr-badge">Firsthand experience comes first</span></div>
      <div class="dr-rv">
        <div class="dr-rcard"><span class="tg">Tradition Local reviews</span><h3>What was the experience like?</h3><p>Our visit or service experience, original evidence, useful observations, and who it might suit.</p>{sample ? <a class="dr-pill line sm" href={url('/eat/' + sample.slug)}>Read a sample review</a> : <a class="dr-pill line sm" href={url('/about-our-reviews')}>How we review</a>}</div>
        <div class="dr-rcard"><span class="tg fut">Member reviews &middot; Future feature</span><h3>Hear from the community.</h3><p>Clearly attributed experiences with dates, moderation, and a way for businesses to respond.</p><button class="dr-pill line sm" type="button" data-dlg="member">Preview member review</button></div>
        <div class="dr-rcard"><span class="tg">Keep the distinction clear</span><h3>Profile. Spotlight. Review.</h3><p>Facts help you plan. A spotlight tells a story. A review helps you decide.</p><button class="dr-pill line sm" type="button" data-dlg="types">Explore content types</button></div>
      </div>
    </section>

    <section class="dr-blk wrap" id="vendors">
      <div class="dr-vhead"><h2>Preferred vendors.</h2><button class="dr-pill line sm" type="button" data-dlg="select">How we select</button></div>
      <p class="dr-vdesc">A separate collection for businesses we have evaluated through our own experience and a documented selection process.</p>
      <div class="dr-vbox">
        <div><p class="eb">Relationships with a reason</p><h3>Know why a provider is included.</h3><p>Each preferred profile would show its services, service area, selection basis, last review date, and any commercial relationship.</p></div>
        <button class="dr-pill line" type="button" data-dlg="vendor">Preview preferred profile</button>
      </div>
      <p class="dr-disc">A directory listing alone does not mean a business is a preferred vendor. No preferred vendors are listed yet.</p>
    </section>

    <section class="dr-blk wrap" id="near">
      <div class="dr-sechead"><div><h2>Discover a business near you.</h2></div><span class="dr-badge">One local find from each area</span></div>
      <p class="dr-note">Explore a neighborhood, starting with a local business.</p>
      <div class="dr-near">
        {near.map((c) => (
          <article class="dr-ncard">
            <div class="art" aria-hidden="true" set:html={icon(c.biz!.group, 34)}></div>
            <div class="body">
              <span class="pillarea">{c.w}</span>
              <h3>{c.biz!.name}</h3>
              <p>{c.biz!.desc}</p>
              <div class="row"><a class="dr-pill line sm" href={url('/eat/' + c.biz!.slug)}>Explore the business &rarr;</a></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="dr-blk padb wrap" id="areas">
      <div class="dr-sechead"><div><h2>More to discover, area by area.</h2></div><span class="dr-badge">Browse your local</span></div>
      <p class="dr-note">Explore businesses and services by neighborhood. Start with the area closest to you.</p>
      <div class="dr-acols">
        {cols.map((c) => (
          <div class="dr-acol">
            <h3><a href={url('/cities/' + c.slug)}>{c.w}</a></h3>
            <ul>
              {areaItems.map((it) => {
                const n = count(c.w, it[0]);
                return n ? <li><button type="button" data-aw={c.w} data-ag={it[0]}>{it[1]}<small>{n}</small></button></li> : <li><span class="none">{it[1]}<small>none yet</small></span></li>;
              })}
              <li><a href={url('/cities/' + c.slug)}>Neighborhood guide</a></li>
            </ul>
          </div>
        ))}
      </div>
      <p class="dr-fine">Listings grow as each area is added.</p>
    </section>
  </div>

  <dialog id="dr-dlg" class="dr-dlg"><div class="dr-dlgin"><h3 id="dr-dT"></h3><p class="m" id="dr-dM"></p><div id="dr-dB"></div><div class="x"><button class="dr-pill line sm" type="button" data-close>Close</button></div></div></dialog>
</Base>

<script is:inline>
  (function () {
    var cards = [].slice.call(document.querySelectorAll('.dr-bcard'));
    if (!cards.length) return;
    var $ = function (id) { return document.getElementById(id); };
    var SHOW = 12, saved = [];
    try { saved = JSON.parse(localStorage.getItem('tl-dir-saved') || '[]'); } catch (e) {}
    var st = { q: '', g: '', w: '', limit: SHOW, savedOnly: false };
    var GL = { '': 'All businesses', food: 'Food & drink', shops: 'Shops & everyday services', home: 'Home services & maintenance', health: 'Health, beauty & fitness', parks: 'Parks, travel & outings' };
    var toastEl = null;
    function toast(m) {
      if (!toastEl) { toastEl = document.createElement('div'); toastEl.className = 'dr-toast'; toastEl.setAttribute('role', 'status'); document.body.appendChild(toastEl); }
      toastEl.textContent = m; toastEl.classList.add('on'); clearTimeout(toast.h); toast.h = setTimeout(function () { toastEl.classList.remove('on'); }, 1800);
    }
    function render() {
      var q = st.q.trim().toLowerCase(), n = 0, shown = 0;
      cards.forEach(function (c) {
        var ok = (!st.g || c.getAttribute('data-g') === st.g) && (!st.w || c.getAttribute('data-w') === st.w) && (!st.savedOnly || saved.indexOf(c.getAttribute('data-slug')) > -1) && (!q || c.getAttribute('data-text').indexOf(q) > -1);
        if (ok) { n++; if (shown < st.limit) { shown++; c.hidden = false; } else { c.hidden = true; } } else { c.hidden = true; }
        c.querySelector('[data-save]').setAttribute('aria-pressed', String(saved.indexOf(c.getAttribute('data-slug')) > -1));
      });
      $('dr-count').textContent = n + ' business' + (n === 1 ? '' : 'es');
      $('dr-empty').hidden = n > 0; $('dr-more').hidden = n <= st.limit;
      $('dr-cat').value = st.g; $('dr-area').value = st.w;
      document.querySelectorAll('#dr-tabs [data-g]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-g') === st.g)); });
      var sb = $('dr-savedBtn'); sb.textContent = 'Saved (' + saved.length + ')'; sb.setAttribute('aria-pressed', String(st.savedOnly));
    }
    function jump(id) { var el = $(id); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    $('dr-q').addEventListener('input', function () { st.q = this.value; st.limit = SHOW; render(); });
    $('dr-cat').addEventListener('change', function () { st.g = this.value; st.limit = SHOW; render(); });
    $('dr-area').addEventListener('change', function () { st.w = this.value; st.limit = SHOW; render(); });
    $('dr-more').addEventListener('click', function () { st.limit += SHOW; render(); });

    // dialogs
    var TIPS = [
      ['Build a maintenance routine', ['Pick a regular time each season to walk the house and yard.', 'Keep a simple list of filters, gutters, and appliances to check.', 'Write down the date each job was done.']],
      ['Notice small changes early', ['Look for new stains, sounds, smells, or sticking doors.', 'Take a dated photo when something changes.', 'Small signs are easier and cheaper to address.']],
      ['Plan the next right step', ['Describe what you see, where, and since when.', 'Gather photos and any past service records.', 'Ask providers what they would check first.']]
    ];
    function dlg(t, m, h) { var d = $('dr-dlg'); if (typeof d.showModal !== 'function') return; $('dr-dT').textContent = t; $('dr-dM').textContent = m; $('dr-dB').innerHTML = h; d.showModal(); }
    var DLG = {
      member: function () { dlg('Member reviews', 'Future feature. This is a layout preview, not a real review.', '<p><b>Sample member, Sugar Land</b> · Visited [date] · <i>Member review</i></p><p>[A member\'s own words about their experience would appear here, with the date of the visit.]</p><p><b>Response from the business</b> · [date]<br>[The business can reply here.]</p><p class="note">Reviews would be moderated, clearly attributed, and kept separate from Tradition Local reviews.</p>'); },
      types: function () { dlg('Profile. Spotlight. Review.', 'Three kinds of content, kept clearly separate.', '<ul><li><b>Profile.</b> The facts that help you plan: what the business is, where it is, and how to reach it.</li><li><b>Spotlight.</b> A story about the people behind a business. Partner spotlights are paid features and are always labeled.</li><li><b>Review.</b> Our own firsthand experience, to help you decide. Our reviews are never for sale.</li></ul>'); },
      select: function () { dlg('How we select preferred vendors', 'What a provider needs before we list them.', '<ul><li>We have used the service ourselves, or evaluated it through a clear process.</li><li>We record why a provider is included, and the date we last reviewed them.</li><li>We disclose any commercial relationship on the provider\'s profile.</li><li>A directory listing alone never makes a business a preferred vendor.</li></ul>'); },
      vendor: function () { dlg('Preferred profile preview', 'Layout only. No provider is named here.', '<p><b>[Provider name]</b> · [Home services category]</p><ul><li><b>Services:</b> [what they do]</li><li><b>Service area:</b> [neighborhoods served]</li><li><b>Selection basis:</b> [how we evaluated them]</li><li><b>Last review date:</b> [date]</li><li><b>Commercial relationship:</b> [disclosure, or none]</li></ul>'); }
    };
    document.addEventListener('click', function (e) {
      var d = e.target.closest('[data-dlg]'); if (d) { DLG[d.getAttribute('data-dlg')](); return; }
      var tp = e.target.closest('[data-tip]'); if (tp) { var t = TIPS[+tp.getAttribute('data-tip')]; dlg(t[0], 'A quick checklist to start with.', '<ul>' + t[1].map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ul>'); return; }
      var dd = $('dr-dlg'); if (e.target.hasAttribute('data-close') || e.target === dd) { dd.close(); return; }
      var aw = e.target.closest('[data-aw]'); if (aw) { st = { q: '', g: aw.getAttribute('data-ag'), w: aw.getAttribute('data-aw'), limit: SHOW, savedOnly: false }; $('dr-q').value = ''; render(); jump('find'); toast('Showing ' + (st.g ? GL[st.g] + ' in ' : 'businesses in ') + st.w); return; }
      var g = e.target.closest('#dr-tabs [data-g]'); if (g) { st.g = g.getAttribute('data-g'); st.savedOnly = false; st.limit = SHOW; render(); return; }
      var sv = e.target.closest('[data-save]');
      if (sv) { var s = sv.getAttribute('data-save'), p = saved.indexOf(s); if (p > -1) { saved.splice(p, 1); toast('Removed from saved'); } else { saved.push(s); toast('Saved'); } try { localStorage.setItem('tl-dir-saved', JSON.stringify(saved)); } catch (err) {} render(); return; }
      if (e.target.closest('#dr-savedBtn')) { st.savedOnly = !st.savedOnly; st.limit = SHOW; render(); return; }
    });

    // suggest a business opens an email
    var sf = $('dr-sugform');
    if (sf) sf.addEventListener('submit', function (e) {
      e.preventDefault(); var n = $('dr-sugname').value.trim(); if (!n) { toast('Enter a business name first'); return; }
      toast('Opening your email app');
      window.location.href = 'mailto:' + sf.getAttribute('data-email') + '?subject=' + encodeURIComponent('Business suggestion') + '&body=' + encodeURIComponent('Business name: ' + n + '\n\nWhy it is worth knowing:\n');
    });

    // spotlights
    var spots = [].slice.call(document.querySelectorAll('[data-spot]')), nx = $('dr-spotnext'), si = 0;
    if (nx && spots.length > 1) nx.addEventListener('click', function () { spots[si].hidden = true; si = (si + 1) % spots.length; spots[si].hidden = false; });

    // keep the section bar in sync while scrolling
    var links = [].slice.call(document.querySelectorAll('.dr-bar a[data-sec]'));
    if (links.length) window.addEventListener('scroll', function () {
      var cur = links[0].getAttribute('data-sec');
      links.forEach(function (a) { var el = document.getElementById(a.getAttribute('data-sec')); if (el && el.getBoundingClientRect().top <= 140) cur = a.getAttribute('data-sec'); });
      links.forEach(function (a) { a.classList.toggle('on', a.getAttribute('data-sec') === cur); });
    }, { passive: true });
    render();
  })();
</script>

<script>
  // Shows the directory to signed-in members only; everyone else sees the sign-in gate.
  import { membersReady, supabase } from '../lib/members';
  function setState(signedIn: boolean) {
    document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
      el.hidden = (el.dataset.state === 'in') !== signedIn;
    });
  }
  if (membersReady) {
    const sb = supabase();
    sb.auth.getSession().then(({ data }) => setState(Boolean(data.session)));
    sb.auth.onAuthStateChange((_event, session) => setState(Boolean(session)));
  } else {
    setState(false);
  }
</script>

