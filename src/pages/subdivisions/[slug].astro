---
import Base from '../../layouts/Base.astro';
import subdivisions from '../../data/subdivisions.json';
import areas from '../../data/areas.json';
import businesses from '../../data/businesses.json';
import { url, tidy } from '../../lib/util';

export function getStaticPaths() {
  return subdivisions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const area = areas.find((a) => a.slug === s.area);
const siblings = subdivisions.filter((x) => x.area === s.area && x.slug !== s.slug);
const areaEats = area ? businesses.filter((b) => b.area === area.slug && b.saraPick).slice(0, 1) : [];
const stats = [
  ['Price range', s.priceRange], ['Price per sq ft', s.pricePerSqft], ['Year built', s.yearBuilt],
  ['School district', s.schools?.join(', ')], ['ZIP code', s.zipCodes],
].filter(([, v]) => v);

// Real data we have: description, city/state/zip, area link, price range, price/sqft, HOA name,
// school district (district only, not specific schools). Everything the mockup shows that we
// don't have anywhere (home sizes, year built where missing, specific school names, HOA dollar
// figure, nearby drive times, recent sales, flood zone status) stays an honest bracketed
// placeholder, same convention used across the rest of the site.
---
<Base title={(s.seoTitle || s.name).replace(/\s*\|\s*Tradition Local$/, '')} description={s.metaDescription || s.description}>
  <section class="band sub-hero">
    <div class="wrap">
      <p class="crumb">
        <a href={url('/cities')}>Home</a> <span aria-hidden="true">&rsaquo;</span>
        <a href={url('/cities')}>Neighborhoods</a> <span aria-hidden="true">&rsaquo;</span>
        {area && <><a href={url(`/cities/${area.slug}`)}>{area.name}</a> <span aria-hidden="true">&rsaquo;</span> </>}
        {s.name}
      </p>
      <p class="type-badge">Subdivision &middot; {area ? area.name : s.city}</p>
      <h1>{s.name}</h1>
      <p class="lede">{s.description}</p>
      <div class="hero-stats">
        <div><strong>{s.priceRange || <span class="ph-text">[$000K to $0.0M]</span>}</strong><span>Price range</span></div>
        <div><strong class="ph-text">[0,000 to 0,000 sq ft]</strong><span>Home sizes</span></div>
        <div><strong>{s.yearBuilt || <span class="ph-text">[0000 to 0000]</span>}</strong><span>Built</span></div>
        <div><strong class="ph-text">[$00 to $00/mo]</strong><span>HOA</span></div>
      </div>
      <div class="hero-actions">
        <a class="btn gold" href={url('/neighborhood-info-request')}>Talk with Dillon about {s.name}</a>
        <a class="btn on-dark" href="https://traditionrealtygroup.com" target="_blank" rel="noopener">Homes for sale in {s.name}</a>
      </div>
    </div>
  </section>

  <nav class="subnav">
    <div class="wrap subnav-inner">
      <div class="tabs">
        <a href="#homes" class="tab active">Homes</a>
        <a href="#schools" class="tab">Schools</a>
        <a href="#nearby" class="tab">Nearby</a>
        <a href="#market" class="tab">Market</a>
        <a href="#faq" class="tab">FAQ</a>
      </div>
      {area && <p class="part-of muted small">Part of <a href={url(`/cities/${area.slug}`)}>{area.name}</a></p>}
    </div>
  </nav>

  <section class="section" id="homes">
    <div class="wrap layout">
      <div>
        <p class="eyebrow">Homes</p>
        <h2>The homes in {s.name}</h2>
        <dl class="live-stats">
          <div><dt>Builders</dt><dd class="ph-text">[Builder names]</dd></div>
          <div><dt>Styles</dt><dd class="ph-text">[Architectural styles]</dd></div>
          <div><dt>Home sizes</dt><dd class="ph-text">[0,000 to 0,000 sq ft]</dd></div>
          <div><dt>Taxes</dt><dd class="ph-text">[About 0.00%, verify MUD status]</dd></div>
          <div><dt>Amenities</dt><dd class="ph-text">[Amenity list]</dd></div>
          {s.hoa && (<div><dt>HOA</dt><dd>{tidy(s.hoa)}</dd></div>)}
        </dl>
      </div>
      <div class="img-stack">
        <div class="img-block blue"></div>
        <div class="img-row">
          <div class="img-block green"></div>
          <div class="img-block gold"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint" id="schools">
    <div class="wrap">
      <p class="eyebrow">Schools</p>
      <h2>Zoned schools</h2>
      <div class="school-grid">
        <div class="school-card">
          <p class="eyebrow small">Elementary</p>
          <strong class="ph-text">[School name]</strong>
          <span class="muted small">{s.schools?.[0] || <span class="ph-text">[District]</span>}</span>
        </div>
        <div class="school-card">
          <p class="eyebrow small">Middle</p>
          <strong class="ph-text">[School name]</strong>
          <span class="muted small">{s.schools?.[0] || <span class="ph-text">[District]</span>}</span>
        </div>
        <div class="school-card">
          <p class="eyebrow small">High</p>
          <strong class="ph-text">[School name]</strong>
          <span class="muted small">{s.schools?.[0] || <span class="ph-text">[District]</span>}</span>
        </div>
      </div>
      <p class="muted small disclaimer">Always verify attendance zones with the district before buying.</p>
    </div>
  </section>

  {area && (
    <section class="section" id="nearby">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Nearby</p>
            <h2>From the {area.name} guide</h2>
          </div>
          <a href={url(`/cities/${area.slug}`)}>Full {area.name} guide &rarr;</a>
        </div>
        <div class="nearby-grid">
          {areaEats.length > 0 ? (
            <div class="nearby-card">
              <div class="nearby-img gold"></div>
              <p class="eyebrow small">Eat</p>
              <strong><a href={url(`/eat/${areaEats[0].slug}`)}>{areaEats[0].name}</a></strong>
              <span class="muted small ph-text">[00 min drive]</span>
            </div>
          ) : (
            <div class="nearby-card">
              <div class="nearby-img gold"></div>
              <p class="eyebrow small">Eat</p>
              <strong class="ph-text">[Nearby favorite]</strong>
              <span class="muted small ph-text">[00 min drive]</span>
            </div>
          )}
          <div class="nearby-card">
            <div class="nearby-img green"></div>
            <p class="eyebrow small">Do</p>
            <strong class="ph-text">[Nearby park]</strong>
            <span class="muted small ph-text">[00 min drive]</span>
          </div>
          <div class="nearby-card">
            <div class="nearby-img blue"></div>
            <p class="eyebrow small">Events</p>
            <strong class="ph-text">[Upcoming nearby]</strong>
            <span class="muted small ph-text">[Date]</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section tint" id="market">
    <div class="wrap layout2">
      <div>
        <p class="eyebrow">Market</p>
        <div class="section-head small-head">
          <h2>Recent sales in {s.name}</h2>
          <span class="muted small ph-text">[Updated Month 2026]</span>
        </div>
        <table class="sales-table">
          <thead><tr><th>Street</th><th>Beds / baths</th><th>Price</th><th>Sold</th></tr></thead>
          <tbody>
            {Array.from({ length: 4 }).map(() => (
              <tr>
                <td class="ph-text">[Street name]</td>
                <td class="ph-text">[0] / [0]</td>
                <td class="ph-text">[$000K]</td>
                <td class="ph-text">[Date]</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="sales-card">
        <p class="badge gold">{s.name} sales, monthly</p>
        <h3>What did the house down the street sell for?</h3>
        <form class="email-form" onsubmit="return false;">
          <label><span class="sr">Email address</span>
            <input type="email" placeholder="you@email.com" />
          </label>
          <button class="btn gold" type="submit">Send me {s.name} sales</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h2>Common questions about {s.name}</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary>What is the HOA fee in {s.name}?</summary>
          <p>{s.hoa ? <>{s.name} is managed by {tidy(s.hoa)}. <span class="ph-text">[Specific monthly fee not on file, verify with the HOA.]</span></> : <span class="ph-text">[HOA fee not on file, verify with the HOA.]</span>}</p>
        </details>
        <details class="faq-item">
          <summary>Which schools serve {s.name}?</summary>
          <p>{s.schools?.length ? `${s.name} is zoned to ${s.schools.join(', ')}.` : <span class="ph-text">[District]</span>}</p>
        </details>
        <details class="faq-item">
          <summary>How much are homes in {s.name}?</summary>
          <p>{s.priceRange ? `Homes in ${s.name} have recently ranged ${s.priceRange}.` : <span class="ph-text">[Price range not on file]</span>}</p>
        </details>
        <details class="faq-item">
          <summary>Is {s.name} in a flood zone?</summary>
          <p class="ph-text">[Flood zone and drainage notes. Verify by address.]</p>
        </details>
      </div>
      <div class="cta-banner">
        <p>Thinking about {s.name}? Let's talk it through.</p>
        <a class="btn blue" href={url('/neighborhood-info-request')}>Book a call with Dillon</a>
      </div>
    </div>
  </section>

  {siblings.length > 0 && area && (
    <section class="section tint">
      <div class="wrap">
        <p class="eyebrow">Neighborhoods</p>
        <h2 class="sib-head">Other subdivisions in {area.name}</h2>
        <div class="sub-grid">
          {siblings.slice(0, 6).map((x) => (
            <div class="sub-card">
              <div class="sub-img"></div>
              <div>
                <strong><a href={url(`/subdivisions/${x.slug}`)}>{x.name}</a></strong>
                <span class="muted small">{x.priceRange || '[One-line vibe]'}</span>
                <a class="view-link" href={url(`/subdivisions/${x.slug}`)}>View guide &rarr;</a>
              </div>
            </div>
          ))}
        </div>
        {siblings.length > 6 && (
          <details class="more">
            <summary>See all {siblings.length + 1} subdivisions</summary>
            <div class="sub-grid">
              {siblings.slice(6).map((x) => (
                <div class="sub-card">
                  <div class="sub-img"></div>
                  <div>
                    <strong><a href={url(`/subdivisions/${x.slug}`)}>{x.name}</a></strong>
                    <span class="muted small">{x.priceRange || '[One-line vibe]'}</span>
                    <a class="view-link" href={url(`/subdivisions/${x.slug}`)}>View guide &rarr;</a>
                  </div>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    </section>
  )}
</Base>
<style>
  .crumb { font-size: 13px; color: rgba(255,255,255,.65); margin: 0 0 14px; }
  .crumb a { color: rgba(255,255,255,.65); }
  .type-badge { display: inline-block; background: rgba(255,255,255,.15); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 4px 14px; border-radius: 999px; margin: 0 0 14px; }
  .lede { max-width: 640px; }
  .hero-stats { display: flex; gap: 36px; flex-wrap: wrap; margin: 24px 0; }
  .hero-stats strong { display: block; font-family: var(--serif); font-size: 1.3rem; color: #fff; }
  .hero-stats span { font-size: 13px; color: rgba(255,255,255,.7); }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn.on-dark { background: #fff; color: var(--navy); }

  .subnav { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .subnav-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 14px 0; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tab { padding: 8px 16px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--navy); text-decoration: none; }
  .tab.active { background: var(--navy); color: #fff; }
  .part-of { margin: 0; }
  .part-of a { font-weight: 600; }

  .eyebrow { color: var(--green, #1e7a43); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 6px; }
  .eyebrow.small { font-size: 11px; margin: 0 0 4px; }

  .layout { display: grid; grid-template-columns: 1fr 440px; gap: 48px; align-items: start; }
  .live-stats { display: grid; gap: 0; margin-top: 16px; }
  .live-stats > div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .live-stats dt { font-size: 14px; color: var(--muted); }
  .live-stats dd { margin: 0; font-weight: 600; text-align: right; }
  .img-stack { display: flex; flex-direction: column; gap: 14px; }
  .img-block { border-radius: 10px; aspect-ratio: 16 / 10; }
  .img-block.blue { background: #e6eef8; }
  .img-block.green { background: #e8f5ec; }
  .img-block.gold { background: var(--gold-soft); }
  .img-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .img-row .img-block { aspect-ratio: 1; }

  .school-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 20px 0 10px; }
  .school-card { background: #fff; border-radius: 8px; padding: 20px; }
  .school-card strong { display: block; font-family: var(--serif); font-size: 1.2rem; color: var(--navy); margin: 4px 0; }
  .disclaimer { font-style: italic; }

  .nearby-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .nearby-card { background: var(--cream); border-radius: 8px; padding: 16px; }
  .nearby-img { aspect-ratio: 16 / 10; border-radius: 6px; margin-bottom: 10px; }
  .nearby-img.gold { background: var(--gold-soft); }
  .nearby-img.green { background: #e8f5ec; }
  .nearby-img.blue { background: #e6eef8; }
  .nearby-card strong { display: block; font-family: var(--serif); font-size: 1.1rem; color: var(--navy); }
  .nearby-card strong a { color: var(--blue); text-decoration: none; }

  .layout2 { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: start; }
  .small-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid var(--blue); padding-bottom: 8px; margin-bottom: 16px; }
  .small-head h2 { margin: 0; }
  .sales-table { width: 100%; border-collapse: collapse; }
  .sales-table th { background: var(--navy); color: #fff; text-align: left; padding: 10px 14px; font-weight: 600; font-size: 14px; }
  .sales-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); background: #fff; font-size: 14px; }
  .sales-card { background: var(--navy); color: #fff; border-radius: 10px; padding: 24px; }
  .sales-card h3 { color: #fff; font-size: 1.3rem; margin: 6px 0 18px; }
  .badge.gold { display: inline-block; background: var(--gold); color: var(--navy); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 999px; margin: 0; }
  .email-form { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
  .email-form input { padding: 10px 14px; border: 1.5px solid rgba(255,255,255,.3); border-radius: 6px; font-size: 15px; background: rgba(255,255,255,.1); color: #fff; }
  .email-form input::placeholder { color: rgba(255,255,255,.6); }

  .faq-list { margin: 20px 0; border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); padding: 16px 0; }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--navy); font-size: 1.05rem; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin: 12px 0 0; color: var(--muted); }
  .cta-banner { background: var(--gold-soft); border-radius: 8px; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
  .cta-banner p { margin: 0; font-weight: 600; font-size: 1.05rem; color: var(--navy); }
  .btn.blue { background: var(--blue); color: #fff; }

  .sib-head { margin: 0 0 16px; }
  .sub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .sub-card { display: flex; gap: 14px; background: #fff; border-radius: 8px; padding: 16px; }
  .sub-img { flex-shrink: 0; width: 64px; height: 64px; border-radius: 6px; background: linear-gradient(135deg, var(--cream), var(--gold-soft)); }
  .sub-card strong a { font-family: var(--serif); font-size: 1.05rem; color: var(--blue); text-decoration: none; display: block; }
  .sub-card .view-link { display: inline-block; margin-top: 4px; font-size: 13px; font-weight: 600; }
  .more { margin-top: 16px; }
  .more summary { cursor: pointer; color: var(--blue); font-weight: 600; font-size: 15px; list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more ul { margin-top: 10px; }

  .ph-text { color: var(--muted); font-style: italic; }
  .sales-card .ph-text { color: rgba(255,255,255,.65); }

  @media (max-width: 860px) {
    .layout, .layout2 { grid-template-columns: 1fr; }
    .school-grid, .nearby-grid, .img-row, .sub-grid { grid-template-columns: 1fr; }
    .subnav-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
