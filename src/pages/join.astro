---
import Base from '../layouts/Base.astro';
import MemberForm from '../components/MemberForm.astro';
import { config } from '../config';
import { url } from '../lib/util';
---
<Base title="Join Tradition Local" description="Become a Tradition Local member for local food finds, neighborhood guides, events, and member perks across Greater Houston.">
  <MemberForm title="Join Tradition Local" intro="Create your free member account for local finds, events, and member perks across Greater Houston.">
    <div data-redirect-if-member={url('/members')}></div>
    <form class="mform" id="join-form" novalidate>
      <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
      <div class="row">
        <label>First name
          <input type="text" name="first-name" autocomplete="given-name" required />
        </label>
        <label>Last name
          <input type="text" name="last-name" autocomplete="family-name" required />
        </label>
      </div>
      <label>Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>Password
        <input type="password" name="password" autocomplete="new-password" minlength="8" required />
      </label>
      <label><span>Phone <span class="opt">(optional)</span></span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label><span>Area of interest <span class="opt">(optional)</span></span>
        <select name="area-of-interest">
          <option value="">Choose one</option>
          {config.interests.map((i) => <option value={i}>{i}</option>)}
        </select>
      </label>
      <p class="fine">By joining, you agree to receive emails from Tradition Local. You can unsubscribe anytime. We only call or text if you ask us to. See our <a href={url('/privacy-policy')}>privacy policy</a>.</p>
      <button class="btn blue" type="submit">Create my account</button>
    </form>
    <div id="join-done" hidden>
      <p class="welcome">Check your email.</p>
      <p>We sent a confirmation link to <strong data-sent-to></strong>. Click it to finish creating your account, then you'll land on your member page.</p>
      <p class="small">Don't see it? Check your spam folder, or <a href={url('/join')}>try again</a>.</p>
    </div>
    <p class="alt">Already a member? <a href={url('/sign-in')}>Sign in</a></p>
  </MemberForm>
</Base>

<script>
  import { membersReady, supabase, siteUrl, friendly, say, busy, field } from '../lib/members';
  const form = document.getElementById('join-form') as HTMLFormElement | null;
  if (form && membersReady) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      say(form, '');
      const email = field(form, 'email');
      const { data, error } = await busy(form, 'Creating your account…', () =>
        supabase().auth.signUp({
          email,
          password: field(form, 'password'),
          options: {
            emailRedirectTo: siteUrl('/members'),
            data: {
              first_name: field(form, 'first-name'),
              last_name: field(form, 'last-name'),
              phone: field(form, 'phone') || null,
              area_of_interest: field(form, 'area-of-interest') || null,
            },
          },
        }));
      if (error) return say(form, friendly(error.message));
      // Supabase returns a user with no identities when the email is already registered.
      if (data.user && data.user.identities?.length === 0) return say(form, friendly('already registered'));
      if (data.session) { window.location.href = siteUrl('/members'); return; }
      const done = document.getElementById('join-done')!;
      done.querySelector('[data-sent-to]')!.textContent = email;
      form.hidden = true; done.hidden = false;
    });
  }
</script>
