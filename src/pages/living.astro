---
import Todo from '../layouts/Todo.astro';
import EventCalendar from '../components/EventCalendar.astro';
import events from '../data/events.json';
import areaEvents from '../data/area-events.json';
import ideas from '../data/ideas.json';
import { url, fmtDate } from '../lib/util';
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date && e.date >= today);
const upcomingCount = upcoming.length + areaEvents.filter((e) => (e.end || e.date) >= today).length;
const nowCount = areaEvents.filter((e) => e.end && e.date <= today && e.end >= today).length;
const areas = [...new Set(ideas.map((i) => i.area))].sort();

// "This weekend" spotlight: our only real, dated recurring content is Coffee & Conversations.
// We show it under its own real weekday rather than forcing it into a Saturday slot it may not
// fall on. The other three slots (live music, farmers market, park/trail) have no curated data
// yet, so they stay honest bracketed placeholders, same convention used across the site.
const ccEvent = upcoming.find((e) => e.title.includes('Coffee & Conversations'));
const ccDay = ccEvent ? fmtDate(ccEvent.date, { weekday: 'long' }) : null;
---
<Todo
  title="Things to Do"
  description="Events, weekend plans, and easy ideas for families, couples, and anyone who wants to get out and explore Greater Houston."
  tag="Things to Do · Greater Houston"
  heading="Things to Do"
  lead="Good plans start with a little discovery. Find something to do, a reason to get out, and a new favorite corner of Houston."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Things to Do' }]}
  stats={[
    { key: 'upcoming', value: upcomingCount, label: 'Events on the calendar' },
    { key: 'now', value: nowCount, label: 'Happening now' },
    { key: 'ideas', value: ideas.length, label: 'Weekend ideas' },
    { key: 'areas', value: areas.length, label: 'Areas to explore' },
  ]}
  buttons={[{ label: 'Explore weekend ideas', href: '/weekend-ideas', kind: 'gold' }, { label: 'Submit an event', href: '#submit', kind: 'white' }]}
  bar={[{ id: 'weekend', label: 'This weekend' }, { id: 'featured', label: 'Featured events' }, { id: 'calendar', label: 'Calendar' }, { id: 'ongoing', label: 'Happening now' }, { id: 'area', label: 'By area' }, { id: 'ideas', label: 'Ideas' }, { id: 'past', label: 'Past events' }]}
  best="Best for: Weekend plans, families, and curious locals"
>
  <section class="td-blk wrap" id="weekend">
    <div class="td-sechead">
      <div><span class="upd">Updated every Thursday</span><h2>This weekend in Houston</h2></div>
      <a href={url('/weekend-ideas')}>Plan your weekend &rarr;</a>
    </div>
    <div class="weekend-grid">
      <div class="weekend-card">
        <p class="day">Friday</p>
        <strong class="ph-text">[Live music night]</strong>
        <span class="muted small ph-text">[Venue, area]</span>
      </div>
      <div class="weekend-card">
        <p class="day">{ccDay || 'Saturday'}</p>
        {ccEvent ? (
          <>
            <strong><a href={url(`/event-details/${ccEvent.slug}`)}>Coffee &amp; Conversations</a></strong>
            <span class="muted small">{ccEvent.venue}</span>
          </>
        ) : (
          <><strong class="ph-text">[Coffee shop meetup]</strong><span class="muted small ph-text">[Venue, area]</span></>
        )}
      </div>
      <div class="weekend-card">
        <p class="day">Saturday</p>
        <strong class="ph-text">[Farmers market]</strong>
        <span class="muted small ph-text">[Market, area]</span>
      </div>
      <div class="weekend-card">
        <p class="day">Sunday</p>
        <strong class="ph-text">[Park event or trail day]</strong>
        <span class="muted small ph-text">[Park, area]</span>
      </div>
    </div>
  </section>

  <section class="td-blk wrap" id="featured">
    <span id="events"></span>
    <div class="td-sechead"><div><h2>Featured events</h2></div></div>
    <div id="td-feat"></div>
  </section>

  <section class="td-blk wrap" id="calendar">
    <div class="td-sechead"><div><h2>Event calendar</h2></div></div>
    <EventCalendar />
  </section>

  <section class="td-blk wrap" id="ongoing">
    <div class="td-sechead"><div><h2>Happening now</h2></div><span class="td-badge">Exhibits, shows, and long runs</span></div>
    <div class="td-chips" id="td-ongoChips" role="group" aria-label="Filter ongoing events"></div>
    <div class="td-ogrid" id="td-ongoGrid"></div>
  </section>

  <section class="td-blk wrap" id="area">
    <div class="td-dayc">
      <div>
        <p class="td-eyebrow">Make a day of it</p>
        <h2>One area. More to explore.</h2>
        <p>Pair your outing with a nearby cafe, a local shop, or a neighborhood walk. Pick an area to see ideas close together.</p>
      </div>
      <div class="td-achips">{areas.map((a) => <a class="td-chip" href={url(`/weekend-ideas?area=${encodeURIComponent(a)}`)}>{a}</a>)}</div>
    </div>
  </section>

  <section class="td-blk wrap" id="ideas">
    <div class="td-sechead"><div><h2>Make a little time for local.</h2></div><a href={url('/weekend-ideas')}>See all ideas &rarr;</a></div>
    <p class="td-note">Illustrative editorial ideas. Final guides would include verified places and practical details.</p>
    <div class="td-ideas" id="td-hub-ideas"></div>
  </section>

  <section class="td-blk wrap" id="past">
    <div class="td-sechead"><div><h2>Past events</h2></div></div>
    <details class="td-past">
      <summary>Look back at Tradition Local gatherings</summary>
      <ul class="td-pastlist" id="td-pastlist"></ul>
    </details>
  </section>

  <section class="td-blk padb wrap" id="submit">
    <div class="td-submit">
      <div><h2>Hosting something local?</h2><p>Send us the details and we will consider it for the calendar. We list events that help people get out and explore Greater Houston.</p></div>
      <a class="td-pill gold" href="mailto:traditionlocal@gmail.com?subject=Event%20submission">Submit an event</a>
    </div>
  </section>
</Todo>
<style>
  .weekend-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .weekend-card { background: var(--cream); border-radius: 10px; padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .weekend-card .day { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--blue); margin: 0; }
  .weekend-card strong { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; color: var(--navy); }
  .weekend-card strong a { color: var(--blue); text-decoration: none; }
  .ph-text { color: var(--muted); font-style: italic; }
  @media (max-width: 860px) { .weekend-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .weekend-grid { grid-template-columns: 1fr; } }
</style>
