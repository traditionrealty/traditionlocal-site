---
import Base from '../layouts/Base.astro';
import MemberForm from '../components/MemberForm.astro';
import { config } from '../config';
import { url } from '../lib/util';
---
<Base title="Members" description="Your Tradition Local member account.">
  <MemberForm title="Members" wide>
    <div data-state="out" hidden>
      <p class="intro">Sign in to see your account, or create a free membership in under a minute.</p>
      <p><a class="btn blue" href={url('/sign-in')}>Sign in</a> <a class="btn ghost" href={url('/join')}>Join free</a></p>
    </div>

    <div data-state="in" hidden>
      <p class="welcome">Welcome, <span data-first-name>neighbor</span>.</p>

      <div class="member-section">
        <h2>What's new for members</h2>
        <ul class="perks">
          <li><a href={url('/living')}>Upcoming events and meetups</a></li>
          <li><a href={url('/all-articles')}>The latest food finds and guides</a></li>
          <li><a href={url('/cities')}>Neighborhood guides across Greater Houston</a></li>
        </ul>
      </div>

      <div class="member-section" id="details">
        <h2>Your details</h2>
        <form class="mform" id="profile-form" novalidate>
          <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
          <label>Email
            <input type="email" name="email" readonly aria-describedby="email-note" />
            <span class="opt" id="email-note">To change your email, contact us.</span>
          </label>
          <div class="row">
            <label>First name
              <input type="text" name="first-name" autocomplete="given-name" required />
            </label>
            <label>Last name
              <input type="text" name="last-name" autocomplete="family-name" required />
            </label>
          </div>
          <label><span>Phone <span class="opt">(optional)</span></span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
          <label><span>Area of interest <span class="opt">(optional)</span></span>
            <select name="area-of-interest">
              <option value="">Choose one</option>
              {config.interests.map((i) => <option value={i}>{i}</option>)}
            </select>
          </label>
          <button class="btn blue" type="submit">Save changes</button>
        </form>
      </div>

      <div class="member-section">
        <p><a href={url('/reset-password')}>Change your password</a></p>
        <button class="btn ghost" type="button" data-signout>Sign out</button>
      </div>
    </div>
  </MemberForm>
</Base>

<script>
  import { membersReady, supabase, currentUser, getProfile, friendly, say, busy, field } from '../lib/members';
  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  async function load() {
    const user = await currentUser();
    if (!user || !form) return;
    const p = await getProfile(user);
    document.querySelector('[data-first-name]')!.textContent = p.first_name || 'neighbor';
    const set = (name: string, v: string | null) => { (form.elements.namedItem(name) as HTMLInputElement).value = v || ''; };
    set('email', user.email || ''); set('first-name', p.first_name); set('last-name', p.last_name);
    set('phone', p.phone); set('area-of-interest', p.area_of_interest);
  }
  if (membersReady && form) {
    load();
    supabase().auth.onAuthStateChange((event) => { if (event === 'SIGNED_IN') load(); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      say(form, '');
      const user = await currentUser();
      if (!user) return say(form, 'Your session ended. Please sign in again.');
      const row = {
        first_name: field(form, 'first-name'), last_name: field(form, 'last-name'),
        phone: field(form, 'phone') || null, area_of_interest: field(form, 'area-of-interest') || null,
      };
      const { error } = await busy(form, 'Saving…', async () => {
        const sb = supabase();
        let res = await sb.from('profiles').update(row).eq('id', user.id).select('id');
        // Older accounts made before the profiles table existed have no row yet
        if (!res.error && !res.data?.length) res = await sb.from('profiles').insert({ id: user.id, email: user.email, ...row }).select('id');
        if (!res.error) await sb.auth.updateUser({ data: { first_name: row.first_name, last_name: row.last_name } });
        return res;
      });
      if (error) return say(form, friendly(error.message));
      document.querySelector('[data-first-name]')!.textContent = row.first_name;
      say(form, 'Your details are saved.', 'ok');
    });
  }
</script>
