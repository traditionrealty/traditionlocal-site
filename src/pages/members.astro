---
import Base from '../layouts/Base.astro';
import MemberShell from '../components/MemberShell.astro';
import { url } from '../lib/util';
---
<Base title="My Account" description="Your Tradition Local member account.">
  <MemberShell active="account">
    <p class="eyebrow">Your member home</p>
    <h1>Welcome back, <span data-first-name>neighbor</span>.</h1>
    <p class="lede">Your local interests, saved resources, and personal guidance in one place.</p>

    <div class="mcard">
      <p class="eyebrow">Picked for your interests</p>
      <h2 data-interest-headline>Explore Greater Houston and beyond.</h2>
      <p data-interest-sub class="ph-text">[Eats &middot; Neighborhoods]</p>
      <a class="btn gold" href={url('/members/profile')}>Update my interests &rarr;</a>
    </div>

    <div class="mgrid2">
      <div class="mcard">
        <h2>Saved discoveries</h2>
        <div class="mrow-item">
          <div>
            <strong class="ph-text">[Saved neighborhood guide]</strong>
            <p class="ph-text">[Sample saved guide] &middot; Neighborhoods</p>
          </div>
        </div>
        <div class="mrow-item">
          <div>
            <strong class="ph-text">[Saved collection]</strong>
            <p class="ph-text">[Sample saved collection] &middot; Eat</p>
          </div>
        </div>
        <p class="mform-note">Saving guides and places to a list isn't built yet &mdash; this is a preview of where they'll show up.</p>
      </div>
      <div class="mcard">
        <h2>Your subscriptions</h2>
        <p>Choose the topics and messages you want to receive.</p>
        <a class="mlink" href={url('/members/settings')}>Manage email preferences &rarr;</a>
        <div class="mrow-item">
          <div>
            <strong>Your profile</strong>
            <p data-profile-summary class="ph-text">[Preferred area, contact preference]</p>
          </div>
        </div>
        <a class="mlink" href={url('/members/profile')}>Edit my details &rarr;</a>
      </div>
    </div>

    <div class="mcard">
      <p class="eyebrow">When you're ready</p>
      <h2>Your real estate journey</h2>
      <p>Next steps, milestones, documents, and your team.</p>
      <a class="btn gold" href={url('/members/journey')}>View my journey &rarr;</a>
    </div>
  </MemberShell>
</Base>

<script>
  import { membersReady, supabase, currentUser, getProfile } from '../lib/members';
  async function load() {
    if (!membersReady) return;
    const user = await currentUser();
    if (!user) return;
    const p = await getProfile(user);
    const first = (p.first_name || '').trim();
    document.querySelector('[data-first-name]')!.textContent = first || 'neighbor';
    if (p.area_of_interest) {
      document.querySelector('[data-interest-headline]')!.textContent = `Explore ${p.area_of_interest} and beyond.`;
      document.querySelector('[data-interest-sub]')!.textContent = '';
      document.querySelector('[data-interest-sub]')!.classList.remove('ph-text');
      const summary = document.querySelector('[data-profile-summary]')!;
      summary.textContent = `Preferred area: ${p.area_of_interest}`;
      summary.classList.remove('ph-text');
    }
  }
  if (membersReady) {
    load();
    supabase().auth.onAuthStateChange((event) => { if (event === 'SIGNED_IN') load(); });
  }
</script>
<style>
  .ph-text { color: #6d7482; font-style: italic; }
</style>
