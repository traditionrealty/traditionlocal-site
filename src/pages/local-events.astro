---
import Base from '../layouts/Base.astro';
import EventCalendar from '../components/EventCalendar.astro';
import events from '../data/events.json';
import areaEvents from '../data/area-events.json';
import ideas from '../data/ideas.json';
import { config } from '../config';
import { url, fmtDate } from '../lib/util';

const todayS = new Date().toISOString().slice(0, 10);

// Same merge Todo.astro uses, so the shared script and dialog behave identically here.
const own = events.map((e: any) => ({
  id: e.slug, src: 'tl', cat: 'Gatherings', date: e.date, end: '',
  title: String(e.title).replace(/\s+/g, ' ').trim(), venue: e.venue || 'Houston',
  url: url('/event-details/' + e.slug), monthOnly: !String(e.when || '').includes(','),
}));
const area = areaEvents.map((e: any) => ({ ...e, src: 'vh' }));
const data = { events: [...own, ...area], ideas, urls: { events: url('/living#featured'), weekend: url('/weekend-ideas'), cities: url('/cities') } };

const upcoming = [...own, ...area]
  .filter((e: any) => (e.end || e.date) >= todayS)
  .sort((a: any, b: any) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
const interests = [...new Set(upcoming.map((e: any) => e.cat))].sort();

function isWeekend(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00').getDay();
  return d === 0 || d === 6;
}
function badgeDate(e: any) {
  const d = new Date(e.date + 'T12:00:00');
  return { wd: d.toLocaleDateString('en-US', { weekday: 'short' }), day: d.getDate() };
}
---
<Base title="Local Events" description="Your calendar for local happenings, neighborhood outings, and Tradition Local gatherings in Greater Houston.">
  <section class="band">
    <div class="wrap le-hero">
      <div>
        <p class="kicker">Make time for something local</p>
        <h1>Local Events</h1>
        <p class="lede">Your calendar for local happenings, neighborhood outings, and Tradition Local gatherings.</p>
      </div>
      <a class="btn gold" href={`mailto:${config.contactEmail}?subject=Event%20submission`}>+ Suggest an event</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="le-filters">
        <label><span>Find an event</span><input type="search" id="le-q" placeholder="Coffee, music, a neighborhood..." /></label>
        <label><span>Interest</span>
          <select id="le-interest">
            <option value="">All interests</option>
            {interests.map((c: any) => <option value={c}>{c}</option>)}
          </select>
        </label>
      </div>
      <div class="le-chips">
        <button type="button" class="le-chip" id="le-free" aria-pressed="false">Free events</button>
        <button type="button" class="le-chip" id="le-weekend" aria-pressed="false">Weekends</button>
        <button type="button" class="le-chip" id="le-clear">Clear filters</button>
      </div>

      <div class="le-viewtabs">
        <button type="button" class="le-vtab" data-view="month" aria-pressed="true">Month calendar</button>
        <button type="button" class="le-vtab" data-view="list" aria-pressed="false">List</button>
      </div>

      <div id="le-view-month">
        <EventCalendar />
      </div>

      <div id="le-view-list" hidden>
        <p class="muted small" id="le-count">{upcoming.length} upcoming events</p>
        <div class="le-list">
          {upcoming.map((e: any) => {
            const bd = badgeDate(e);
            return (
              <div class="le-row" data-cat={e.cat} data-free={e.cat === 'Free' ? '1' : '0'} data-weekend={isWeekend(e.date) ? '1' : '0'} data-name={(e.title + ' ' + e.venue).toLowerCase()}>
                <div class="le-datebadge"><span>{bd.wd}</span><strong>{bd.day}</strong></div>
                <div class="le-rowbody">
                  <span class="le-tag">{e.cat}</span>
                  <h3>{e.title}</h3>
                  <p class="muted small">{fmtDate(e.date, { month: 'short', day: 'numeric' })} &middot; {e.venue}</p>
                </div>
                {e.src === 'tl'
                  ? <a class="btn outline sm" href={e.url}>View details &rarr;</a>
                  : <button class="btn outline sm" type="button" data-ev={e.id}>View details &rarr;</button>}
              </div>
            );
          })}
        </div>
        <p class="le-empty" id="le-empty" hidden>No events match that search. Try a different term or filter.</p>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">A little inspiration for your calendar</p>
      <h2>Worth making time for.</h2>
      <div class="le-feat-grid">
        {upcoming.slice(0, 3).map((e: any) => (
          <div class="le-feat-card">
            <span class="le-tag">{e.cat}</span>
            <h3>{e.title}</h3>
            <p class="muted small">{fmtDate(e.date, { month: 'short', day: 'numeric' })} &middot; {e.venue}</p>
            {e.src === 'tl'
              ? <a class="btn outline sm" href={e.url}>Explore event &rarr;</a>
              : <button class="btn outline sm" type="button" data-ev={e.id}>Explore event &rarr;</button>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap le-cta">
      <div>
        <p class="eyebrow">Meet a little more locally</p>
        <h2>Come curious. Leave connected.</h2>
        <p>Explore ideas for coffee meetups, tasting outings, and neighborhood gatherings with Dillon and Sara.</p>
      </div>
      <a class="btn gold" href={url('/living')}>See Tradition Local gatherings &rarr;</a>
    </div>
  </section>

  <dialog id="td-dlg" class="td-dlg"><div class="td-dlgin"><h3 id="td-dT"></h3><p class="td-m" id="td-dM"></p><p id="td-dB"></p><div class="td-x" id="td-dX"></div></div></dialog>
  <div id="td-toast" role="status" aria-live="polite"></div>
  <script type="application/json" id="td-data" set:html={JSON.stringify(data)}></script>
</Base>
<script>import '../scripts/things-to-do.js';</script>

<script>
  const month = document.getElementById('le-view-month')!;
  const list = document.getElementById('le-view-list')!;
  document.querySelectorAll<HTMLButtonElement>('.le-vtab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.le-vtab').forEach((t) => t.setAttribute('aria-pressed', 'false'));
      tab.setAttribute('aria-pressed', 'true');
      const v = tab.dataset.view;
      month.hidden = v !== 'month';
      list.hidden = v !== 'list';
    });
  });

  const q = document.getElementById('le-q') as HTMLInputElement;
  const interest = document.getElementById('le-interest') as HTMLSelectElement;
  const freeBtn = document.getElementById('le-free') as HTMLButtonElement;
  const weekendBtn = document.getElementById('le-weekend') as HTMLButtonElement;
  const clearBtn = document.getElementById('le-clear') as HTMLButtonElement;
  const rows = [...document.querySelectorAll<HTMLElement>('.le-row')];
  const count = document.getElementById('le-count')!;
  const empty = document.getElementById('le-empty') as HTMLElement;

  function apply() {
    const term = q.value.trim().toLowerCase();
    const cat = interest.value;
    const freeOn = freeBtn.getAttribute('aria-pressed') === 'true';
    const weekendOn = weekendBtn.getAttribute('aria-pressed') === 'true';
    let n = 0;
    rows.forEach((r) => {
      const okTerm = !term || (r.dataset.name || '').includes(term);
      const okCat = !cat || r.dataset.cat === cat;
      const okFree = !freeOn || r.dataset.free === '1';
      const okWeekend = !weekendOn || r.dataset.weekend === '1';
      const ok = okTerm && okCat && okFree && okWeekend;
      r.hidden = !ok; if (ok) n++;
    });
    count.textContent = `${n} upcoming ${n === 1 ? 'event' : 'events'}`;
    empty.hidden = n > 0;
  }
  q.addEventListener('input', apply);
  interest.addEventListener('change', apply);
  freeBtn.addEventListener('click', () => { freeBtn.setAttribute('aria-pressed', String(freeBtn.getAttribute('aria-pressed') !== 'true')); apply(); });
  weekendBtn.addEventListener('click', () => { weekendBtn.setAttribute('aria-pressed', String(weekendBtn.getAttribute('aria-pressed') !== 'true')); apply(); });
  clearBtn.addEventListener('click', () => {
    q.value = ''; interest.value = '';
    freeBtn.setAttribute('aria-pressed', 'false'); weekendBtn.setAttribute('aria-pressed', 'false');
    apply();
  });
</script>

<style is:global>
  .le-hero { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .lede { max-width: 54ch; }
  .le-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; background: var(--cream); border-radius: 12px; padding: 22px 24px; margin-bottom: 16px; }
  .le-filters label span { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--navy); }
  .le-filters input, .le-filters select { width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; font-size: 15px; }
  .le-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
  .le-chip { background: #fff; border: 1.5px solid var(--line); color: var(--navy); border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; }
  .le-chip[aria-pressed="true"] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .le-viewtabs { display: flex; gap: 8px; margin-bottom: 20px; }
  .le-vtab { background: #fff; border: 1.5px solid var(--line); color: var(--navy); border-radius: 999px; padding: 9px 18px; font-size: 14px; font-weight: 700; cursor: pointer; }
  .le-vtab[aria-pressed="true"] { background: var(--gold); border-color: var(--gold); }

  .le-list { display: flex; flex-direction: column; gap: 14px; margin-top: 16px; }
  .le-row { display: flex; align-items: center; gap: 18px; background: var(--cream); border-radius: 12px; padding: 16px 20px; }
  .le-datebadge { flex-shrink: 0; width: 56px; text-align: center; background: #fff; border-radius: 8px; padding: 8px 0; border: 1px solid var(--line); }
  .le-datebadge span { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
  .le-datebadge strong { font-size: 1.3rem; color: var(--navy); font-family: var(--serif); }
  .le-rowbody { flex: 1; min-width: 0; }
  .le-rowbody h3 { font-size: 1.05rem; margin: 6px 0 2px; color: var(--navy); }
  .le-tag { display: inline-block; background: var(--gold-soft); color: var(--brown); font-size: 11px; font-weight: 700; border-radius: 999px; padding: 3px 10px; }
  .le-empty { text-align: center; color: var(--muted); padding: 32px 0; }

  .le-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 20px; }
  .le-feat-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
  .le-feat-card h3 { font-size: 1.1rem; margin: 10px 0 6px; color: var(--navy); }

  .le-cta { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--navy); color: #fff; border-radius: 14px; padding: 32px 36px; }
  .le-cta h2 { color: #fff; }
  .le-cta p { color: rgba(255,255,255,.8); max-width: 46ch; margin: 6px 0 0; }
  .le-cta .eyebrow { color: var(--gold); }

  .btn.outline { background: #fff; border: 1.5px solid var(--line); color: var(--blue); border-radius: 999px; padding: 9px 18px; font-weight: 700; font-size: 14px; text-decoration: none; cursor: pointer; }
  .btn.outline.sm { padding: 7px 14px; font-size: 13px; }

  @media (max-width: 860px) {
    .le-filters, .le-feat-grid { grid-template-columns: 1fr; }
  }

  /* The month calendar and dialog are shared with the Things To Do page's script,
     which expects these exact class names; copied here since this page doesn't use
     the Todo layout that normally supplies them. */
  .td-pill { display: inline-block; border-radius: 999px; padding: 12px 26px; font: 700 15px var(--serif); text-decoration: none; cursor: pointer; border: 2px solid transparent; }
  .td-pill:hover { text-decoration: none; }
  .td-pill.gold { background: var(--gold); color: var(--navy); }
  .td-pill.white { background: #fff; color: var(--navy); }
  .td-pill.line { background: #fff; border-color: var(--line); color: var(--blue); }
  .td-pill.line:hover { border-color: var(--blue); }
  .td-pill.sm { padding: 7px 16px; font-size: 13px; }
  .td-meta { font-size: 14px; color: var(--muted); }
  .td-src { display: inline-block; font-size: 11px; font-weight: 700; border-radius: 99px; padding: 1px 9px; margin-left: 6px; background: var(--gold-soft); color: #6b4a1d; vertical-align: 2px; font-family: var(--sans); }
  .td-src.vh { background: #e6edfd; color: #1d4ed8; }

  .td-calwrap { display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 900px) { .td-calwrap { grid-template-columns: 1fr; } }
  .td-calbox, .td-daybox { background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .td-calbox { padding: 16px 16px 12px; border-top: 3px solid var(--gold); }
  .td-calbar { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .td-calbar h3 { font-size: 24px; color: var(--navy); flex: 1; text-align: center; margin: 0; }
  .td-cnav { width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid var(--line); background: #fff; color: var(--blue); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .td-cnav:hover { border-color: var(--blue); }
  .td-calgrid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .td-wd { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); text-align: center; padding: 4px 0; }
  .td-dc { position: relative; aspect-ratio: 1 / .92; min-height: 46px; border: 1px solid transparent; border-radius: 10px; background: var(--cream); cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 6px 2px 4px; font: 600 15px var(--sans); color: var(--ink); }
  .td-dc:hover { border-color: var(--blue); }
  .td-dc.blank { background: transparent; cursor: default; border: 0; }
  .td-dc.last { background: #fbe6d3; border-color: #f0c6a2; }
  .td-dc.today { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold); }
  .td-dc.sel { background: var(--navy); color: #fff; border-color: var(--navy); }
  .td-dots { display: flex; gap: 3px; margin-top: 4px; min-height: 7px; }
  .td-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
  .td-dot.tl { background: var(--gold); }
  .td-dot.ot { background: var(--blue); }
  .td-dot.ld { background: #c2571a; }
  .td-dc.sel .td-dot.ot { background: #fff; }
  .td-dc.sel .td-dot.ld { background: #ffb27a; }
  .td-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--muted); padding: 10px 4px 2px; }
  .td-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .td-daybox { padding: 20px 22px; }
  .td-daybox h3 { font-size: 24px; color: var(--navy); margin: 0 0 12px; }
  .td-dayitem { padding: 12px 0; border-top: 1px solid var(--line); }
  .td-dayitem:first-of-type { border-top: 0; padding-top: 0; }
  .td-dayitem h4 { font: 600 18px/1.3 var(--serif); color: var(--navy); margin: 0 0 2px; }
  .td-dayitem .td-meta { margin: 0 0 8px; }
  .td-lab { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; border-radius: 99px; padding: 1px 9px; margin-right: 6px; background: var(--cream); border: 1px solid var(--line); color: var(--navy); }
  .td-dayempty { color: var(--muted); margin: 0 0 6px; }
  .td-ongo { margin: 14px 0 0; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 14px; color: var(--muted); }
  .td-ongo a { font-weight: 700; }
  #td-dayList { max-height: 380px; overflow: auto; padding-right: 6px; }

  .td-dlg { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 14px; padding: 0; width: min(560px, 94vw); }
  .td-dlg::backdrop { background: rgba(20,40,55,.55); }
  .td-dlgin { padding: 26px 28px; }
  .td-dlgin h3 { font-size: 26px; color: var(--navy); margin: 0 0 6px; }
  .td-m { color: var(--muted); font-size: 14px; margin: 0 0 12px; }
  .td-dlgin p { margin: 0 0 14px; }
  .td-x { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; margin-top: 6px; }
  #td-toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: var(--navy); color: #fff; padding: 9px 16px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 50; }
  #td-toast.on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { #td-toast { transition: none; } }
</style>
