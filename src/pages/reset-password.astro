---
import Base from '../layouts/Base.astro';
import MemberForm from '../components/MemberForm.astro';
import { url } from '../lib/util';
---
<Base title="Reset your password" description="Reset the password for your Tradition Local member account.">
  <MemberForm title="Reset your password" intro="Enter your email and we'll send you a reset code.">
    <form class="mform" data-ms-form="forgot-password">
      <label>Email
        <input type="email" name="email" data-ms-member="email" autocomplete="email" required />
      </label>
      <button class="btn blue" type="submit">Send reset code</button>
    </form>
    <div class="member-section">
      <h2>Have a code?</h2>
      <form class="mform" data-ms-form="reset-password">
        <label>Reset code
          <input type="text" name="token" data-ms-member="token" autocomplete="one-time-code" required />
        </label>
        <label>New password
          <input type="password" name="newPassword" data-ms-member="newPassword" autocomplete="new-password" minlength="8" required />
        </label>
        <button class="btn blue" type="submit">Set new password</button>
      </form>
    </div>
    <p class="alt"><a href={url('/sign-in')}>Back to sign in</a></p>
  </MemberForm>
</Base>
