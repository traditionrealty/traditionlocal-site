---
import Base from '../layouts/Base.astro';
import MemberForm from '../components/MemberForm.astro';
import { url } from '../lib/util';
---
<Base title="Reset your password" description="Reset the password for your Tradition Local member account.">
  <MemberForm title="Reset your password" intro="Enter your email and we'll send you a link to choose a new password.">
    <form class="mform" id="forgot-form" novalidate>
      <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
      <label>Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button class="btn blue" type="submit">Send reset link</button>
    </form>
    <form class="mform" id="newpass-form" hidden novalidate>
      <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
      <p class="welcome">Choose a new password.</p>
      <label>New password
        <input type="password" name="password" autocomplete="new-password" minlength="8" required />
      </label>
      <label>Confirm new password
        <input type="password" name="confirm" autocomplete="new-password" minlength="8" required />
      </label>
      <button class="btn blue" type="submit">Save new password</button>
    </form>
    <p class="alt"><a href={url('/sign-in')}>Back to sign in</a></p>
  </MemberForm>
</Base>

<script>
  import { membersReady, supabase, siteUrl, friendly, say, busy, field } from '../lib/members';
  const forgot = document.getElementById('forgot-form') as HTMLFormElement | null;
  const newpass = document.getElementById('newpass-form') as HTMLFormElement | null;
  if (forgot && newpass && membersReady) {
    const sb = supabase();
    const showNewPassword = () => { forgot.hidden = true; newpass.hidden = false; };
    // Arriving from the email link (or signed in and changing it from the account menu)
    sb.auth.onAuthStateChange((event) => { if (event === 'PASSWORD_RECOVERY') showNewPassword(); });
    sb.auth.getSession().then(({ data }) => { if (data.session) showNewPassword(); });

    forgot.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!forgot.reportValidity()) return;
      say(forgot, '');
      const { error } = await busy(forgot, 'Sending…', () =>
        sb.auth.resetPasswordForEmail(field(forgot, 'email'), { redirectTo: siteUrl('/reset-password') }));
      if (error) return say(forgot, friendly(error.message));
      say(forgot, 'If there is an account with that email, a reset link is on its way. It expires in one hour.', 'ok');
      forgot.reset();
    });

    newpass.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!newpass.reportValidity()) return;
      if (field(newpass, 'password') !== field(newpass, 'confirm')) return say(newpass, 'Those passwords do not match.');
      say(newpass, '');
      const { error } = await busy(newpass, 'Saving…', () => sb.auth.updateUser({ password: field(newpass, 'password') }));
      if (error) return say(newpass, friendly(error.message));
      say(newpass, 'Your password is updated. Taking you to your account…', 'ok');
      setTimeout(() => { window.location.href = siteUrl('/members'); }, 1200);
    });
  }
</script>
