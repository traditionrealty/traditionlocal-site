---
import Base from '../layouts/Base.astro';
import builds from '../data/new-builds.json';
import { url } from '../lib/util';

const infoUrl = url('/neighborhood-info-request');
---
<Base title="New Builds" description="Search new construction communities across Greater Houston, compare your options, and understand the new build journey.">
  <section class="nb-hero">
    <div class="wrap">
      <p class="nb-crumb"><a href={url('/')}>Home</a> › Neighborhoods › New Builds</p>
      <p class="nb-kicker">Make it home / New construction</p>
      <h1>New Builds</h1>
      <p class="nb-lede">Browse new construction communities by area, builder, and price. Then send an info request and we will help you narrow the list.</p>
      <div class="nb-actions">
        <a class="btn gold" href="#nb-tool">Search new builds</a>
        <a class="btn nb-outline" href="#nb-journey">Understand the journey</a>
      </div>
    </div>
  </section>

  <section class="section" id="nb-tool">
    <div class="wrap">
      <p class="nb-eyebrow">Find a community</p>
      <h2>Search by what matters to you</h2>
      <p class="nb-sub">Starting prices, bedrooms, builders, and ZIP codes in one place. Prices and availability change often, so always confirm with the builder.</p>

      <div class="nb-filters" role="search">
        <label class="nb-search">Search
          <input id="nb-q" type="search" placeholder="Community, product line, builder, city, or ZIP" />
        </label>
        <label>City <select id="nb-city"></select></label>
        <label>Builder <select id="nb-builder"></select></label>
        <label>ZIP <input id="nb-zip" inputmode="numeric" maxlength="5" placeholder="Any" /></label>
        <label>Max starting price
          <select id="nb-max">
            <option value="">Any</option>
            <option value="300000">$300,000</option>
            <option value="400000">$400,000</option>
            <option value="500000">$500,000</option>
            <option value="650000">$650,000</option>
            <option value="800000">$800,000</option>
          </select>
        </label>
        <label>Bedrooms
          <select id="nb-beds"><option value="">Any</option><option value="3">3 or more</option><option value="4">4 or more</option><option value="5">5 or more</option></select>
        </label>
        <div class="nb-chips">
          <label><input type="checkbox" id="nb-hot" /> Hot deals</label>
          <label><input type="checkbox" id="nb-cut" /> Price reduced</label>
          <label><input type="checkbox" id="nb-no55" /> Hide 55+ communities</label>
          <button class="nb-linkbtn" id="nb-clear" type="button">Clear filters</button>
        </div>
      </div>

      <div class="nb-count">
        <span id="nb-count" aria-live="polite"></span>
        <label>Sort
          <select id="nb-sort"><option value="lo">Price, low to high</option><option value="hi">Price, high to low</option><option value="name">Community A to Z</option></select>
        </label>
      </div>

      <div class="nb-grid" id="nb-grid"></div>
      <div class="nb-empty" id="nb-empty" hidden>No communities match yet. Try a higher price or clear a filter.</div>
      <div class="nb-more"><button class="btn gold" id="nb-more" type="button" hidden>Show more</button></div>

      <div class="nb-short" id="nb-shortwrap" hidden>
        <div><strong>Your comparison shortlist</strong><span id="nb-shortmsg"></span></div>
        <button class="btn gold" id="nb-compare" type="button" disabled>Compare selected</button>
      </div>

      <p class="nb-fine">Listing details are gathered from public new home listings and may be out of date. Starting prices are not offers. Confirm pricing, incentives, and availability with the builder before making decisions. Tradition Local is not affiliated with these builders.</p>
    </div>
  </section>

  <section class="nb-band nb-cream" id="nb-difference">
    <div class="wrap nb-two">
      <div>
        <p class="nb-eyebrow">The Tradition Local difference</p>
        <h2>See the life beyond the floor plan.</h2>
        <p class="nb-sub">Connect every community to its neighborhood guide, nearby discoveries, and conversations with people who live there.</p>
      </div>
      <aside class="nb-know" aria-live="polite">
        <h3 id="nb-know-title">Get to know Greater Houston</h3>
        <p>What would a normal Saturday feel like here?</p>
        <div class="nb-ln">
          <a href="#nb-tool" id="nb-know-new">Explore new builds →</a>
          <a href={url('/cities')}>Neighborhood guide →</a>
          <a href={url('/food')}>Coffee, food and local finds →</a>
          <a href={url('/neighborhood-info-request')}>Ask the community →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="nb-band" id="nb-journey">
    <div class="wrap">
      <p class="nb-eyebrow">From discovery to your keys</p>
      <h2>Your new build journey</h2>
      <div class="nb-tabs" role="tablist" aria-label="New build journey steps" id="nb-tabs"></div>
      <div class="nb-jpanel" id="nb-jpanel" role="tabpanel" aria-live="polite" tabindex="0"></div>
    </div>
  </section>

  <section class="nb-band nb-cream" id="nb-library">
    <div class="wrap nb-two">
      <div>
        <p class="nb-eyebrow">Buyer resource library</p>
        <h2>Make a confident next move.</h2>
        <p class="nb-sub">Plain language guides and practical worksheets for each decision.</p>
        <button class="nb-ghostbtn" id="nb-checklist-btn" type="button">Preview the tour checklist</button>
      </div>
      <div id="nb-acc"></div>
    </div>
  </section>

  <section class="nb-trg" id="nb-talk">
    <div class="wrap nb-two">
      <div>
        <p class="nb-kicker">Tradition Realty Group</p>
        <h2>A little guidance.<br />A clearer path home.</h2>
        <p>Bring your shortlist and questions. Dillon can help you organize the next steps.</p>
        <a class="btn gold" href={infoUrl}>Plan my new home search</a>
      </div>
      <div class="nb-locally">
        <h3>Keep discovering with Locally</h3>
        <p>Save communities and follow the neighborhoods you're considering, even before you're ready to move.</p>
        <small>Your saved places, local newsletter, and home journey in one account.</small>
      </div>
    </div>
  </section>

  <dialog id="nb-dlg-compare" class="nb-dlg"><div class="nb-dlg-in"><h3>Compare your shortlist</h3><div class="nb-tablewrap" id="nb-cmp-body"></div><div class="nb-x"><button class="nb-ghostbtn" type="button" data-nb-close>Close</button></div></div></dialog>
  <dialog id="nb-dlg-list" class="nb-dlg"><div class="nb-dlg-in"><h3>Tour checklist</h3>
    <ul>
      <li>Ask what is included in the base price and what costs extra.</li>
      <li>Confirm the lot, its orientation, and what can be built nearby.</li>
      <li>Ask about community charges, taxes, and any special districts.</li>
      <li>Walk the street at different times of day to check noise and traffic.</li>
      <li>Review the warranty and who to call after move in.</li>
      <li>Ask how delays are communicated and how closing dates are set.</li>
      <li>Take photos and write down every promise made during the visit.</li>
    </ul>
    <div class="nb-x"><button class="nb-ghostbtn" type="button" data-nb-close>Close</button></div></div></dialog>

  <script type="application/json" id="nb-data" set:html={JSON.stringify(builds)}></script>
  <script type="application/json" id="nb-cfg" set:html={JSON.stringify({ info: infoUrl })}></script>

  <script is:inline>
  (function () {
    var data = JSON.parse(document.getElementById('nb-data').textContent);
    var cfg = JSON.parse(document.getElementById('nb-cfg').textContent);
    var $ = function (i) { return document.getElementById(i); };
    var SHOW = 12, limit = SHOW, PICK = [];
    data.forEach(function (r, i) { r.idx = i; });
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function range(r) { return String(r).replace('-', ' to '); }
    function maxN(r) { var m = String(r).match(/\d+/g); return m ? Math.max.apply(null, m.map(Number)) : 0; }
    function money(n) { return '$' + n.toLocaleString('en-US'); }
    function uniq(k) { var o = {}; data.forEach(function (r) { o[r[k]] = 1; }); return Object.keys(o).sort(); }
    function fill(el, vals, all) { el.innerHTML = '<option value="">' + all + '</option>' + vals.map(function (v) { return '<option>' + esc(v) + '</option>'; }).join(''); }
    fill($('nb-city'), uniq('city'), 'All cities');
    fill($('nb-builder'), uniq('builder'), 'All builders');

    function list() {
      var q = $('nb-q').value.trim().toLowerCase(), c = $('nb-city').value, b = $('nb-builder').value,
          z = $('nb-zip').value.trim(), mx = +$('nb-max').value, bd = +$('nb-beds').value;
      var out = data.filter(function (r) {
        if (q && (r.name + ' ' + r.line + ' ' + r.builder + ' ' + r.city + ' ' + r.zip).toLowerCase().indexOf(q) < 0) return false;
        if (c && r.city !== c) return false;
        if (b && r.builder !== b) return false;
        if (z && r.zip.indexOf(z) !== 0) return false;
        if (mx && r.lo > mx) return false;
        if (bd && maxN(r.beds) < bd) return false;
        if ($('nb-hot').checked && !r.hot) return false;
        if ($('nb-cut').checked && !r.cut) return false;
        if ($('nb-no55').checked && r.s55) return false;
        return true;
      });
      var s = $('nb-sort').value;
      out.sort(function (a, b2) { return s === 'hi' ? b2.lo - a.lo : s === 'name' ? a.name.localeCompare(b2.name) : a.lo - b2.lo; });
      return out;
    }

    function render() {
      var rows = list(), shown = rows.slice(0, limit);
      $('nb-count').textContent = rows.length + ' of ' + data.length + ' communities';
      $('nb-grid').innerHTML = shown.map(function (r) {
        var tags = (r.line ? '<span class="nb-tag line">' + esc(r.line) + '</span>' : '') + (r.hot ? '<span class="nb-tag">Hot deal</span>' : '') + (r.cut ? '<span class="nb-tag cut">Price reduced</span>' : '') + (r.s55 ? '<span class="nb-tag senior">55+</span>' : '');
        var sq = String(r.sqft).replace('-', ' to ').replace(/(\d)(?=(\d{3})+\b)/g, '$1,');
        var href = cfg.info + (cfg.info.indexOf('?') > -1 ? '&' : '?') + 'community=' + encodeURIComponent(r.name + (r.line ? ' ' + r.line : '')) + '&source=new-builds';
        var on = PICK.indexOf(r.idx) > -1;
        return '<article class="nb-card' + (on ? ' sel' : '') + '"><div class="nb-tags">' + tags + '</div><h3>' + esc(r.name) + '</h3>' +
          '<div class="nb-line">' + esc(r.builder) + ' · ' + esc(r.city) + ' ' + esc(r.zip) + '</div>' +
          '<div class="nb-price">From ' + money(r.lo) + '</div>' +
          '<div class="nb-facts"><span><b>' + esc(range(r.beds)) + '</b> beds</span><span><b>' + esc(range(r.baths)) + '</b> baths</span><span><b>' + esc(sq) + '</b> sq ft</span></div>' +
          '<label class="nb-cmp"><input type="checkbox" data-nb-pick="' + r.idx + '"' + (on ? ' checked' : '') + ' /> Add to comparison</label>' +
          '<div class="nb-ask"><a href="' + esc(href) + '" aria-label="Request info for ' + esc(r.name) + '">Request info<span class="nb-arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></div></article>';
      }).join('');
      $('nb-empty').hidden = rows.length > 0;
      $('nb-more').hidden = rows.length <= limit;
    }

    function renderShort() {
      var n = PICK.length;
      $('nb-shortwrap').hidden = n === 0;
      $('nb-shortmsg').textContent = n === 1 ? '1 selected. Add one more to compare.' : n + ' selected. Ready to compare.';
      $('nb-compare').disabled = n < 2;
    }
    function setSpot() {
      var c = $('nb-city').value;
      $('nb-know-title').textContent = 'Get to know ' + (c || 'Greater Houston');
      $('nb-know-new').textContent = c ? 'Explore ' + c + ' new builds →' : 'Explore new builds →';
    }

    ['nb-q', 'nb-city', 'nb-builder', 'nb-zip', 'nb-max', 'nb-beds', 'nb-hot', 'nb-cut', 'nb-no55', 'nb-sort'].forEach(function (i) {
      $(i).addEventListener('input', function () { limit = SHOW; render(); });
    });
    $('nb-city').addEventListener('input', setSpot);
    $('nb-clear').onclick = function () {
      ['nb-q', 'nb-city', 'nb-builder', 'nb-zip', 'nb-max', 'nb-beds'].forEach(function (i) { $(i).value = ''; });
      ['nb-hot', 'nb-cut', 'nb-no55'].forEach(function (i) { $(i).checked = false; });
      limit = SHOW; render(); setSpot();
    };
    $('nb-more').onclick = function () { limit += SHOW; render(); };

    $('nb-grid').addEventListener('change', function (e) {
      var i = e.target.getAttribute('data-nb-pick');
      if (i === null) return;
      i = +i;
      if (e.target.checked) {
        if (PICK.length >= 3) { e.target.checked = false; $('nb-shortwrap').hidden = false; $('nb-shortmsg').textContent = 'You can compare up to three communities.'; return; }
        PICK.push(i);
      } else {
        PICK = PICK.filter(function (x) { return x !== i; });
      }
      e.target.closest('.nb-card').classList.toggle('sel', e.target.checked);
      if (PICK.length) renderShort(); else $('nb-shortwrap').hidden = true;
    });

    $('nb-compare').onclick = function () {
      var rows = PICK.map(function (i) { return data[i]; });
      var fields = [
        ['Product line', function (r) { return r.line || 'None listed'; }],
        ['Builder', function (r) { return r.builder; }],
        ['Location', function (r) { return r.city + ' ' + r.zip; }],
        ['Starting price', function (r) { return money(r.lo); }],
        ['Bedrooms', function (r) { return range(r.beds); }],
        ['Bathrooms', function (r) { return range(r.baths); }],
        ['Square feet', function (r) { return String(r.sqft).replace('-', ' to '); }]
      ];
      var h = '<table><thead><tr><th></th>' + rows.map(function (r) { return '<th scope="col">' + esc(r.name) + '</th>'; }).join('') + '</tr></thead><tbody>';
      fields.forEach(function (f) { h += '<tr><th scope="row">' + f[0] + '</th>' + rows.map(function (r) { return '<td>' + esc(f[1](r)) + '</td>'; }).join('') + '</tr>'; });
      $('nb-cmp-body').innerHTML = h + '</tbody></table>';
      $('nb-dlg-compare').showModal();
    };

    var STEPS = [
      ['Discover', 'Find the place that fits', 'Explore areas, communities, home types, and daily life. Save a shortlist and note what matters to you.'],
      ['Compare', 'Look past the price', 'Line up your shortlist side by side: monthly cost, lot, commute, schools, and community charges.'],
      ['Prepare', 'Get ready before you tour', 'Review your budget with a lender, gather questions for the sales team, and decide what you will not compromise on.'],
      ['Build', 'Stay close to the process', 'Learn the milestones from foundation to final walkthrough, and who to contact at each stage.'],
      ['Move in', 'Cross the finish line', 'Complete your walkthrough, review your warranty, and start getting to know your new neighborhood.']
    ];
    var ACC = [
      ['Compare the full cost of two homes', 'Use a worksheet for base price, lot premium, options, closing costs, taxes, insurance, community charges, and maintenance. Record where each figure came from.'],
      ["Understand a builder's offer", 'Ask what is included in the base price, which incentives depend on a preferred lender or title company, and when the offer expires. Get every promise in writing.'],
      ['Plan inspections and walkthroughs', 'Many buyers schedule an independent inspection at key stages and a final walkthrough before closing. Ask your builder what is allowed and when.'],
      ['New construction or resale?', 'New homes bring modern systems and warranties, but may mean waiting and less mature surroundings. Resale offers established neighborhoods and faster move in. Weigh timing, budget, and location.'],
      ['Meet the builder', 'Ask about floor plans, warranty coverage, how delays are handled, and what recent buyers say. Visit a finished community if you can.']
    ];
    $('nb-tabs').innerHTML = STEPS.map(function (s, i) { return '<button role="tab" type="button" id="nb-tab' + i + '" aria-selected="' + (i === 0) + '" aria-controls="nb-jpanel" data-i="' + i + '">' + (i + 1) + '. ' + s[0] + '</button>'; }).join('');
    function showStep(i) {
      document.querySelectorAll('#nb-tabs button').forEach(function (b, j) { b.setAttribute('aria-selected', String(j === i)); });
      $('nb-jpanel').setAttribute('aria-labelledby', 'nb-tab' + i);
      $('nb-jpanel').innerHTML = '<h3>' + esc(STEPS[i][1]) + '</h3><p>' + esc(STEPS[i][2]) + '</p>';
    }
    $('nb-tabs').addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) showStep(+b.dataset.i); });
    $('nb-tabs').addEventListener('keydown', function (e) {
      var cur = +document.querySelector('#nb-tabs [aria-selected="true"]').dataset.i, n = STEPS.length;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); var j = (cur + (e.key === 'ArrowRight' ? 1 : n - 1)) % n; showStep(j); $('nb-tab' + j).focus(); }
    });
    showStep(0);
    $('nb-acc').innerHTML = ACC.map(function (a, i) { return '<details' + (i === 0 ? ' open' : '') + '><summary>' + esc(a[0]) + '</summary><p>' + esc(a[1]) + '</p></details>'; }).join('');
    $('nb-checklist-btn').onclick = function () { $('nb-dlg-list').showModal(); };
    document.querySelectorAll('[data-nb-close]').forEach(function (b) { b.onclick = function () { b.closest('dialog').close(); }; });

    render();
  })();
  </script>
</Base>

<style is:global>
  .nb-hero { background: var(--navy); color: #fff; padding: 48px 0 56px; }
  .nb-hero h1 { color: #fff; margin: 0 0 12px; }
  .nb-crumb { font-size: 13px; color: rgba(255,255,255,.7); margin: 0 0 14px; }
  .nb-crumb a { color: rgba(255,255,255,.85); }
  .nb-kicker { color: var(--gold); font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  .nb-lede { max-width: 640px; color: rgba(255,255,255,.88); }
  .nb-actions { display: flex; gap: 14px; margin-top: 24px; flex-wrap: wrap; }
  .btn.nb-outline { border: 1.5px solid #fff; color: #fff; background: transparent; }
  .nb-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--brown); margin: 0 0 6px; }
  .nb-sub { color: var(--muted); margin: 0 0 20px; max-width: 64ch; }
  .nb-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
  .nb-filters label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .nb-filters input, .nb-filters select { border: 1px solid var(--line); background: var(--cream); border-radius: 8px; padding: 9px 10px; width: 100%; font: inherit; color: var(--ink); }
  .nb-filters .nb-search { grid-column: span 2; }
  @media (max-width: 560px) { .nb-filters .nb-search { grid-column: span 1; } }
  .nb-chips { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; }
  .nb-chips label { flex-direction: row; align-items: center; gap: 6px; color: var(--ink); font-size: 14px; }
  .nb-chips input { width: auto; accent-color: var(--blue); }
  .nb-linkbtn { background: none; border: 0; color: var(--blue); text-decoration: underline; cursor: pointer; padding: 0; font: inherit; }
  .nb-count { margin: 18px 0 12px; color: var(--muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .nb-count select { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 6px 8px; font: inherit; }
  .nb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .nb-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 8px; }
  .nb-card.sel { border-color: var(--gold); box-shadow: 0 0 0 2px var(--gold); }
  .nb-card h3 { font: 600 20px/1.2 var(--serif); margin: 0; }
  .nb-line { color: var(--muted); font-size: 14px; }
  .nb-price { font: 600 22px var(--serif); color: var(--navy); }
  .nb-facts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  .nb-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .nb-tag { font-size: 12px; font-weight: 700; border-radius: 99px; padding: 2px 10px; background: var(--gold-soft); color: #6b4a1d; }
  .nb-tag.cut { background: #e6edfd; color: #1d4ed8; }
  .nb-tag.senior { background: #efe7fb; color: #6d28d9; }
  .nb-tag.line { background: var(--cream); border: 1px solid var(--line); color: var(--ink); }
  .nb-cmp { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
  .nb-cmp input { width: 17px; height: 17px; accent-color: var(--blue); }
  .nb-ask { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); }
  .nb-ask a { display: flex; align-items: center; justify-content: space-between; text-decoration: none; font-weight: 700; font-size: 14px; color: var(--blue); }
  .nb-arrow { width: 30px; height: 30px; border-radius: 50%; background: var(--gold); color: #1c1c1c; display: inline-flex; align-items: center; justify-content: center; transition: transform .15s; }
  .nb-ask a:hover .nb-arrow, .nb-ask a:focus-visible .nb-arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) { .nb-arrow { transition: none; } }
  .nb-empty { padding: 40px 16px; text-align: center; color: var(--muted); background: #fff; border: 1px dashed var(--line); border-radius: 12px; }
  .nb-more { display: flex; justify-content: center; margin: 22px 0; }
  .nb-short { background: var(--cream); border: 1px solid var(--line); border-radius: 12px; padding: 16px 20px; margin: 18px 0; display: flex; justify-content: space-between; gap: 16px; align-items: center; flex-wrap: wrap; }
  .nb-short strong { display: block; font: 600 18px var(--serif); color: var(--navy); }
  .nb-short span { font-size: 14px; color: var(--muted); }
  .nb-short .btn[disabled] { opacity: .45; cursor: not-allowed; }
  .nb-fine { font-size: 13px; color: var(--muted); max-width: 80ch; }
  .nb-band { padding: 48px 0; background: #fff; }
  .nb-band.nb-cream { background: var(--cream); }
  .nb-two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 900px) { .nb-two { grid-template-columns: 1fr; gap: 26px; } }
  .nb-ghostbtn { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 10px 22px; cursor: pointer; font: 700 14px var(--serif); color: var(--blue); }
  .nb-ghostbtn:hover { border-color: var(--blue); }
  .nb-know { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--gold); border-radius: 14px; padding: 26px 28px; }
  .nb-know h3 { font: 600 28px var(--serif); color: var(--navy); margin: 0 0 10px; }
  .nb-know p { font-size: 17px; color: var(--muted); margin: 0 0 14px; }
  .nb-ln { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 16px; font-weight: 600; line-height: 1.9; }
  .nb-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 20px; }
