---
import Base from '../layouts/Base.astro';
import builds from '../data/new-builds.json';
import { url } from '../lib/util';

const infoUrl = url('/neighborhood-info-request');
---
<Base title="New Builds" description="Browse new construction communities across Greater Houston by area, builder, and price.">
  <section class="nb-hero">
    <div class="wrap">
      <p class="nb-crumb"><a href={url('/')}>Home</a> › Neighborhoods › New Builds</p>
      <p class="nb-kicker">New construction across Greater Houston</p>
      <h1>New Builds</h1>
      <p class="nb-lede">Browse new construction communities by area, builder, and price. Then send an info request and we will help you narrow the list.</p>
      <div class="nb-actions">
        <a class="btn gold" href="#nb-tool">Search new builds</a>
        <a class="btn nb-outline" href={infoUrl}>Send an info request</a>
      </div>
    </div>
  </section>

  <section class="section" id="nb-tool">
    <div class="wrap">
      <p class="nb-eyebrow">Find a community</p>
      <h2>Search by what matters to you</h2>
      <p class="nb-sub">Starting prices, bedrooms, builders, and ZIP codes in one place. Prices and availability change often, so always confirm with the builder.</p>

      <div class="nb-filters" role="search">
        <label class="nb-search">Search
          <input id="nb-q" type="search" placeholder="Community, builder, city, or ZIP" />
        </label>
        <label>City <select id="nb-city"></select></label>
        <label>Builder <select id="nb-builder"></select></label>
        <label>ZIP <input id="nb-zip" inputmode="numeric" maxlength="5" placeholder="Any" /></label>
        <label>Max starting price
          <select id="nb-max">
            <option value="">Any</option>
            <option value="300000">$300,000</option>
            <option value="400000">$400,000</option>
            <option value="500000">$500,000</option>
            <option value="650000">$650,000</option>
            <option value="800000">$800,000</option>
          </select>
        </label>
        <label>Bedrooms
          <select id="nb-beds"><option value="">Any</option><option value="3">3 or more</option><option value="4">4 or more</option><option value="5">5 or more</option></select>
        </label>
        <div class="nb-chips">
          <label><input type="checkbox" id="nb-hot" /> Hot deals</label>
          <label><input type="checkbox" id="nb-cut" /> Price reduced</label>
          <label><input type="checkbox" id="nb-no55" /> Hide 55+ communities</label>
          <button class="nb-linkbtn" id="nb-clear" type="button">Clear filters</button>
        </div>
      </div>

      <div class="nb-count">
        <span id="nb-count" aria-live="polite"></span>
        <label>Sort
          <select id="nb-sort"><option value="lo">Price, low to high</option><option value="hi">Price, high to low</option><option value="name">Community A to Z</option></select>
        </label>
      </div>

      <div class="nb-grid" id="nb-grid"></div>
      <div class="nb-empty" id="nb-empty" hidden>No communities match yet. Try a higher price or clear a filter.</div>
      <div class="nb-more"><button class="btn gold" id="nb-more" type="button" hidden>Show more</button></div>

      <div class="nb-cta">
        <div>
          <p class="nb-eyebrow">Skip the guesswork</p>
          <h2>Not sure which builder fits?</h2>
          <p>Share your budget, commute, and school needs in an info request. We will point you to the communities that make sense and the ones to skip.</p>
        </div>
        <a class="btn gold" href={infoUrl}>Send an info request</a>
      </div>

      <p class="nb-fine">Listing details are gathered from public new home listings and may be out of date. Starting prices are not offers. Confirm pricing, incentives, and availability with the builder before making decisions. Tradition Local is not affiliated with these builders.</p>
    </div>
  </section>

  <script type="application/json" id="nb-data" set:html={JSON.stringify(builds)}></script>
  <script type="application/json" id="nb-cfg" set:html={JSON.stringify({ info: infoUrl })}></script>

  <script is:inline>
  (function () {
    var data = JSON.parse(document.getElementById('nb-data').textContent);
    var cfg = JSON.parse(document.getElementById('nb-cfg').textContent);
    var $ = function (i) { return document.getElementById(i); };
    var SHOW = 12, limit = SHOW;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function range(r) { return String(r).replace('-', ' to '); }
    function maxN(r) { var m = String(r).match(/\d+/g); return m ? Math.max.apply(null, m.map(Number)) : 0; }
    function money(n) { return '$' + n.toLocaleString('en-US'); }
    function uniq(k) { var o = {}; data.forEach(function (r) { o[r[k]] = 1; }); return Object.keys(o).sort(); }
    function fill(el, vals, all) { el.innerHTML = '<option value="">' + all + '</option>' + vals.map(function (v) { return '<option>' + esc(v) + '</option>'; }).join(''); }
    fill($('nb-city'), uniq('city'), 'All cities');
    fill($('nb-builder'), uniq('builder'), 'All builders');

    function list() {
      var q = $('nb-q').value.trim().toLowerCase(), c = $('nb-city').value, b = $('nb-builder').value,
          z = $('nb-zip').value.trim(), mx = +$('nb-max').value, bd = +$('nb-beds').value;
      var out = data.filter(function (r) {
        if (q && (r.name + ' ' + r.line + ' ' + r.builder + ' ' + r.city + ' ' + r.zip).toLowerCase().indexOf(q) < 0) return false;
        if (c && r.city !== c) return false;
        if (b && r.builder !== b) return false;
        if (z && r.zip.indexOf(z) !== 0) return false;
        if (mx && r.lo > mx) return false;
        if (bd && maxN(r.beds) < bd) return false;
        if ($('nb-hot').checked && !r.hot) return false;
        if ($('nb-cut').checked && !r.cut) return false;
        if ($('nb-no55').checked && r.s55) return false;
        return true;
      });
      var s = $('nb-sort').value;
      out.sort(function (a, b2) { return s === 'hi' ? b2.lo - a.lo : s === 'name' ? a.name.localeCompare(b2.name) : a.lo - b2.lo; });
      return out;
    }

    function render() {
      var rows = list(), shown = rows.slice(0, limit);
      $('nb-count').textContent = rows.length + ' of ' + data.length + ' communities';
      $('nb-grid').innerHTML = shown.map(function (r) {
        var tags = (r.line ? '<span class="nb-tag line">' + esc(r.line) + '</span>' : '') + (r.hot ? '<span class="nb-tag">Hot deal</span>' : '') + (r.cut ? '<span class="nb-tag cut">Price reduced</span>' : '') + (r.s55 ? '<span class="nb-tag senior">55+</span>' : '');
        var sq = String(r.sqft).replace('-', ' to ').replace(/(\d)(?=(\d{3})+\b)/g, '$1,');
        var href = cfg.info + (cfg.info.indexOf('?') > -1 ? '&' : '?') + 'community=' + encodeURIComponent(r.name + (r.line ? ' ' + r.line : '')) + '&source=new-builds';
        return '<article class="nb-card"><div class="nb-tags">' + tags + '</div><h3>' + esc(r.name) + '</h3>' +
          '<div class="nb-line">' + esc(r.builder) + ' · ' + esc(r.city) + ' ' + esc(r.zip) + '</div>' +
          '<div class="nb-price">From ' + money(r.lo) + '</div>' +
          '<div class="nb-facts"><span><b>' + esc(range(r.beds)) + '</b> beds</span><span><b>' + esc(range(r.baths)) + '</b> baths</span><span><b>' + esc(sq) + '</b> sq ft</span></div>' +
          '<div class="nb-ask"><a href="' + esc(href) + '" aria-label="Request info for ' + esc(r.name) + '">Request info<span class="nb-arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a></div></article>';
      }).join('');
      $('nb-empty').hidden = rows.length > 0;
      $('nb-more').hidden = rows.length <= limit;
    }

    ['nb-q', 'nb-city', 'nb-builder', 'nb-zip', 'nb-max', 'nb-beds', 'nb-hot', 'nb-cut', 'nb-no55', 'nb-sort'].forEach(function (i) {
      $(i).addEventListener('input', function () { limit = SHOW; render(); });
    });
    $('nb-clear').onclick = function () {
      ['nb-q', 'nb-city', 'nb-builder', 'nb-zip', 'nb-max', 'nb-beds'].forEach(function (i) { $(i).value = ''; });
      ['nb-hot', 'nb-cut', 'nb-no55'].forEach(function (i) { $(i).checked = false; });
      limit = SHOW; render();
    };
    $('nb-more').onclick = function () { limit += SHOW; render(); };
    render();
  })();
  </script>
</Base>

<style is:global>
  .nb-hero { background: var(--navy); color: #fff; padding: 48px 0 56px; }
  .nb-hero h1 { color: #fff; margin: 0 0 12px; }
  .nb-crumb { font-size: 13px; color: rgba(255,255,255,.7); margin: 0 0 14px; }
  .nb-crumb a { color: rgba(255,255,255,.85); }
  .nb-kicker { color: var(--gold); font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  .nb-lede { max-width: 640px; color: rgba(255,255,255,.88); }
  .nb-actions { display: flex; gap: 14px; margin-top: 24px; flex-wrap: wrap; }
  .btn.nb-outline { border: 1.5px solid #fff; color: #fff; background: transparent; }
  .nb-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--brown); margin: 0 0 6px; }
  .nb-sub { color: var(--muted); margin: 0 0 20px; max-width: 64ch; }
  .nb-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
  .nb-filters label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .nb-filters input, .nb-filters select { border: 1px solid var(--line); background: var(--cream); border-radius: 8px; padding: 9px 10px; width: 100%; font: inherit; color: var(--ink); }
  .nb-filters .nb-search { grid-column: span 2; }
  @media (max-width: 560px) { .nb-filters .nb-search { grid-column: span 1; } }
  .nb-chips { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; }
  .nb-chips label { flex-direction: row; align-items: center; gap: 6px; color: var(--ink); font-size: 14px; }
  .nb-chips input { width: auto; accent-color: var(--blue); }
  .nb-linkbtn { background: none; border: 0; color: var(--blue); text-decoration: underline; cursor: pointer; padding: 0; font: inherit; }
  .nb-count { margin: 18px 0 12px; color: var(--muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .nb-count select { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 6px 8px; font: inherit; }
  .nb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .nb-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 8px; }
  .nb-card h3 { font: 600 20px/1.2 var(--serif); margin: 0; }
  .nb-line { color: var(--muted); font-size: 14px; }
  .nb-price { font: 600 22px var(--serif); color: var(--navy); }
  .nb-facts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  .nb-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .nb-tag { font-size: 12px; font-weight: 700; border-radius: 99px; padding: 2px 10px; background: var(--gold-soft); color: #6b4a1d; }
  .nb-tag.cut { background: #e6edfd; color: #1d4ed8; }
  .nb-tag.senior { background: #efe7fb; color: #6d28d9; }
  .nb-tag.line { background: var(--cream); border: 1px solid var(--line); color: var(--ink); }
  .nb-ask { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); }
  .nb-ask a { display: flex; align-items: center; justify-content: space-between; text-decoration: none; font-weight: 700; font-size: 14px; color: var(--blue); }
  .nb-arrow { width: 30px; height: 30px; border-radius: 50%; background: var(--gold); color: #1c1c1c; display: inline-flex; align-items: center; justify-content: center; transition: transform .15s; }
  .nb-ask a:hover .nb-arrow, .nb-ask a:focus-visible .nb-arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) { .nb-arrow { transition: none; } }
  .nb-empty { padding: 40px 16px; text-align: center; color: var(--muted); background: #fff; border: 1px dashed var(--line); border-radius: 12px; }
  .nb-more { display: flex; justify-content: center; margin: 22px 0; }
  .nb-cta { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 26px; margin: 36px 0; display: flex; gap: 18px; justify-content: space-between; align-items: center; flex-wrap: wrap; }
  .nb-cta h2 { margin: 0 0 4px; }
  .nb-cta p { margin: 0; color: var(--muted); max-width: 56ch; }
  .nb-cta .nb-eyebrow { margin-bottom: 4px; }
  .nb-fine { font-size: 13px; color: var(--muted); max-width: 80ch; }
</style>
