---
import Base from '../../layouts/Base.astro';
import events from '../../data/events.json';
import { url, img, fmtDate } from '../../lib/util';

export function getStaticPaths() {
  const paths: any[] = events.map((e) => ({ params: { slug: e.slug }, props: { e } }));
  // Old Wix registration URL for the July event now points to the event page
  paths.push({ params: { slug: 'jos-coffee-for-coffee-conversations-july/form' }, props: { e: events.find((x) => x.slug === 'jos-coffee-for-coffee-conversations-july'), redirect: true } });
  return paths;
}
const { e, redirect } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const isPast = !e.date || e.date < today;
const exact = e.when?.includes(',');
const ld = { '@context': 'https://schema.org', '@type': 'Event', name: e.title, startDate: e.date,
  location: { '@type': 'Place', name: e.venue, address: e.location }, image: e.image, description: e.about.join(' ') };
---
{redirect ? (
  <html><head><meta http-equiv="refresh" content={`0; url=${url(e.path)}`} /><link rel="canonical" href={url(e.path)} /></head><body><a href={url(e.path)}>Continue to the event</a></body></html>
) : (
<Base title={e.title} description={e.about[0] || `${e.title} with Tradition Local.`} image={e.image}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <section class="band">
    <div class="wrap">
      <p class="kicker"><a href={url('/living')}>Events</a> / {isPast ? 'Past event' : 'Upcoming'}</p>
      <h1>{e.title}</h1>
      <p class="lede">{exact ? e.when : e.when || 'Date to be announced'}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap layout">
      <div class="prose">
        {e.image && <img src={img(e.image)} alt="" />}
        <h2>About the event</h2>
        {e.about.length ? e.about.map((p) => <p>{p}</p>) : <p>Relaxed talks, cheery friendly faces, and a good time. Join us for Coffee & Conversations.</p>}
      </div>
      <aside>
        <h3>Time and location</h3>
        {e.when && <p>{e.when}</p>}
        {e.location && <p>{e.location}</p>}
        {e.location && <a class="btn blue" href={`https://www.google.com/maps/search/${encodeURIComponent(e.location)}`}>Get directions</a>}
        {!isPast && (<div class="rsvp"><h3>RSVP</h3><form class="rsvp-form" data-rsvp-form data-slug={e.slug} data-title={e.title} data-when={e.when || ''} data-location={e.location || ''} novalidate><div data-rsvp-member hidden><p>Signed in as <strong data-rsvp-name></strong>.</p><button type="button" class="btn blue" data-rsvp-onetap>RSVP with one tap</button></div><div data-rsvp-fields><label>First name<input name="first_name" required autocomplete="given-name" /></label><label>Last name<input name="last_name" autocomplete="family-name" /></label><label>Email<input name="email" type="email" required autocomplete="email" /></label><label>Guests, including you<select name="party_size"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></label><input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><button class="btn blue" type="submit">RSVP</button></div><p data-rsvp-msg role="status" hidden></p><p class="muted" data-rsvp-signin-note>Free to attend. Have a Tradition Local account? <a href={url('/sign-in')}>Sign in</a> for one tap RSVPs.</p></form></div>)}
        {isPast && <p class="muted">This event has ended. <a href={url('/living')}>See upcoming events</a>.</p>}
      </aside>
    </div>
  </section>
</Base>
)}
<style>
  .kicker a { color: var(--gold); }
  .layout { display: grid; grid-template-columns: 1fr 320px; gap: 56px; }
  .prose img { border-radius: 6px; margin-bottom: 24px; }
  aside { align-self: start; background: var(--cream); padding: 24px; }
  .rsvp { margin-top: 20px; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
</style>

<script>import { membersReady, currentUser, getProfile } from '../../lib/members'; import { config } from '../../config'; const form = document.querySelector('[data-rsvp-form]'); if (form) { const endpoint = String(config.newsletterAction || '').replace(/\/$/, '') + '/rsvp'; const msg = form.querySelector('[data-rsvp-msg]'); const fields = form.querySelector('[data-rsvp-fields]'); const memberBox = form.querySelector('[data-rsvp-member]'); const signinNote = form.querySelector('[data-rsvp-signin-note]'); const say = (t, ok) => { msg.textContent = t; msg.hidden = !t; msg.className = ok ? 'rsvp-ok' : 'rsvp-err'; }; let member = null; const send = async (p) => { const body = Object.assign({ event_slug: form.dataset.slug, event_title: form.dataset.title, event_when: form.dataset.when, event_location: form.dataset.location }, p); try { const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const j = await r.json(); if (j.ok) { say(j.duplicate ? 'You are already on the list for this event. See you there.' : 'You are on the list! Check your email for a confirmation.', true); fields.hidden = true; memberBox.hidden = true; signinNote.hidden = true; } else { say('Please check your details and try again.', false); } } catch (err) { say('Something went wrong. Please try again, or email us.', false); } }; form.addEventListener('submit', (ev) => { ev.preventDefault(); const fd = new FormData(form); send({ first_name: fd.get('first_name'), last_name: fd.get('last_name'), email: fd.get('email'), party_size: fd.get('party_size'), company: fd.get('company') }); }); form.querySelector('[data-rsvp-onetap]').addEventListener('click', () => { if (member) { send(Object.assign({ party_size: 1 }, member)); } }); if (membersReady) { currentUser().then(async (u) => { if (!u) { return; } const p = await getProfile(u); member = { first_name: p.first_name, last_name: p.last_name, email: u.email, phone: p.phone }; form.querySelector('[data-rsvp-name]').textContent = (p.first_name + ' ' + p.last_name).trim() || u.email; memberBox.hidden = false; fields.hidden = true; signinNote.hidden = true; }).catch(() => {}); } }</script>
<style is:global>.rsvp-form label { display: block; margin-top: 12px; font-size: 14px; } .rsvp-form input, .rsvp-form select { display: block; width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; margin-top: 4px; background: #fff; box-sizing: border-box; } .rsvp-form button { margin-top: 16px; cursor: pointer; } .rsvp-ok { color: var(--blue); font-weight: 600; margin-top: 14px; } .rsvp-err { color: #b00020; font-weight: 600; margin-top: 14px; }</style>
