---
import Base from '../../layouts/Base.astro';
import posts from '../../data/posts.json';
import categories from '../../data/categories.json';
import site from '../../data/site.json';
import events from '../../data/events.json';
import { config } from '../../config';
import { url, img, fmtDate } from '../../lib/util';

const dated = posts.filter((p: any) => p.date);
const byRecent = [...dated].sort((a: any, b: any) => (a.date < b.date ? 1 : -1));
const featured = byRecent[0];
// Exclude the featured post so it isn't shown twice between the feature card and this list.
const others = byRecent.slice(1, 4);
const videos = (site.videos || []).slice(0, 4);

const todayStr = new Date().toISOString().slice(0, 10);
const upcomingEvents = events
  .filter((e: any) => e.date && e.date >= todayStr)
  .sort((a: any, b: any) => (a.date > b.date ? 1 : -1))
  .slice(0, 6);

const RATING_LEVELS = [
  { n: 1, label: 'Try at Least Once' }, { n: 2, label: 'Worth a Visit' }, { n: 3, label: 'Would Go Again' },
  { n: 4, label: 'Highly Recommend' }, { n: 5, label: 'Local Favorite' }, { n: 6, label: "Sara's Pick" },
];

function typeTag(p: any) {
  const c = (p.categories || [])[0];
  if (!c) return 'Guide';
  const found = categories.find((x: any) => x.slug === c);
  return found ? found.name : 'Guide';
}

function fmtEventDate(d: string) {
  const dt = new Date(d + 'T00:00:00');
  return { dow: dt.toLocaleDateString('en-US', { weekday: 'short' }).toUpperCase(), md: dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase() };
}
---
<Base title="Houston Stories &amp; Guides" description="A closer look at Houston. Reviews, local businesses, neighborhood discoveries, and ideas for living well.">
  <div class="cp-page">
    <section class="cp-hero">
      <div class="wrap cp-hero-grid">
        <div>
          <p class="cp-eyebrow">Good finds. Local ideas. Shared experiences.</p>
          <h1>A little more connected to where you live.</h1>
          <p class="cp-lede">Discover something new, share something useful, and make it local.</p>
          <div class="cp-hero-ctas">
            <a class="cp-btn primary" href="#community">Join the conversation</a>
            <a class="cp-btn ghost" href="#stories">Read recent stories</a>
          </div>
        </div>
        <div class="cp-hero-preview" data-hero-preview hidden>
          <p class="cp-tag">🔥 From the community</p>
          <div class="cp-who"><span class="cp-avatar" data-hp-initials></span><div><strong data-hp-name></strong><span data-hp-when></span></div></div>
          <p class="cp-hp-body" data-hp-body></p>
        </div>
      </div>
    </section>

    <div class="cp-stat-strip">
      <div class="wrap">
        <div class="cp-stat"><strong>{posts.length}</strong><span>Stories in the archive</span></div>
        <div class="cp-stat"><strong>{categories.length}</strong><span>Topics covered</span></div>
        <div class="cp-stat"><strong>{upcomingEvents.length}</strong><span>Upcoming local events</span></div>
        <div class="cp-stat" data-stat-posts hidden><strong data-stat-posts-n>&nbsp;</strong><span>Community posts this month</span></div>
      </div>
    </div>

    <section class="cp-community" id="community">
      <div class="wrap">
        <div class="cp-community-head">
          <div>
            <p class="cp-eyebrow">From our members</p>
            <h2>Community</h2>
            <p class="cp-sub">Updates, photos, and local finds from the people around you.</p>
          </div>
          <a class="cp-btn primary" href={url('/members/community')}>+ Join the conversation</a>
        </div>
        <div class="cp-feed" data-community-feed>
          <p class="cp-muted">Loading&hellip;</p>
        </div>
      </div>
    </section>

    <section class="cp-spotlight">
      <div class="wrap">
        <div class="cp-spotlight-head">
          <div>
            <p class="cp-eyebrow">Neighbor spotlight</p>
            <h2>The people behind the posts.</h2>
          </div>
        </div>
        <div data-spotlight-box>
          <p class="cp-muted">Loading&hellip;</p>
        </div>
      </div>
    </section>

    {videos.length > 0 && (
      <section class="cp-video">
        <div class="wrap">
          <p class="cp-eyebrow">Trending Houston · With Dillon Loren</p>
          <div class="cp-video-feature">
            <a class="cp-video-thumb" href={`https://www.youtube.com/watch?v=${videos[0]}`} target="_blank" rel="noopener">
              <img src={`https://img.youtube.com/vi/${videos[0]}/hqdefault.jpg`} alt="" loading="lazy" />
              <span class="cp-play"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            </a>
            <div class="cp-video-info">
              <h3>Houston headlines, new openings &amp; neighborhood stories</h3>
              <p>Houston headlines, new openings, development, and the stories shaping our city, explained by Dillon.</p>
              <a class="cp-mlink" href={site.social.youtube} target="_blank" rel="noopener">Watch on our YouTube channel &rarr;</a>
            </div>
          </div>
          {videos.length > 1 && (
            <div class="cp-video-picker">
              <p class="cp-picker-label">More videos</p>
              <div class="cp-video-picker-row">
                {videos.slice(1).map((v: string) => (
                  <a class="cp-video-pick" href={`https://www.youtube.com/watch?v=${v}`} target="_blank" rel="noopener">
                    <img src={`https://img.youtube.com/vi/${v}/hqdefault.jpg`} alt="" loading="lazy" />
                    <span class="cp-play sm"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
                  </a>
                ))}
              </div>
            </div>
          )}
          <div class="cp-topic-row">
            <div>
              <h2>What should we take a closer look at?</h2>
              <p class="cp-desc">Suggest the next neighborhood, business, or story we should feature.</p>
            </div>
            <a class="cp-btn ghost" href={`mailto:${config.contactEmail}?subject=Video%20topic%20suggestion`}>Suggest a video topic &rarr;</a>
          </div>
        </div>
      </section>
    )}

    <section class="cp-newsletter">
      <div class="wrap cp-nl-row">
        <div>
          <h2>Get it in your inbox.</h2>
          <p>Become a local insider. Join for monthly stories, events, and what's trending near you.</p>
        </div>
        <div>
          {config.newsletterAction ? (
            <form class="cp-nl-form" action={config.newsletterAction} method="post">
              <label class="sr-only" for="cp-nl-email">Email</label>
              <input id="cp-nl-email" name="email" type="email" required placeholder="you@example.com" />
              <button type="submit">Subscribe</button>
              <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
              <input type="hidden" name="return" id="cp-nl-return" />
            </form>
          ) : (
            <a class="cp-btn primary" href={`mailto:${config.contactEmail}?subject=Subscribe%20me%20to%20Tradition%20Local`}>Join the newsletter</a>
          )}
          <p id="cp-nl-msg" role="status" class="cp-nl-msg" hidden></p>
        </div>
      </div>
    </section>

    <section class="cp-stories" id="stories">
      <div class="wrap">
        <div class="cp-section-head">
          <p class="cp-eyebrow">Stories &amp; reviews</p>
          <h2>Find your next good read.</h2>
          <p class="cp-sub">Recent posts from Dillon &amp; Sara, plus the full archive — search it, revisit a review, or share your own experience.</p>
        </div>

        {featured && (
          <a class="cp-feature" href={url(featured.path)}>
            <span class="cp-tag">{typeTag(featured)} &middot; Just posted</span>
            <h3>{featured.title}</h3>
            <p class="cp-quote">{featured.description}</p>
            <div class="cp-feature-links">
              <span class="cp-flink">Read the full story &rarr;</span>
              <span class="cp-byline-sm">{featured.author} &middot; {fmtDate(featured.date)}</span>
            </div>
          </a>
        )}

        <div class="cp-archive-head">
          <h3>Search the archive</h3>
          <span class="cp-byline">{posts.length} stories and counting</span>
        </div>
        <div class="cp-filters">
          <button class="cp-chip" data-cat="" aria-pressed="true">All</button>
          {categories.map((c: any) => <button class="cp-chip" data-cat={c.slug} aria-pressed="false">{c.name}</button>)}
        </div>
        <label class="cp-search"><span class="sr-only">Search stories</span>
          <input type="search" id="cp-q" placeholder="Search a title or topic" />
        </label>
        <p class="cp-muted" id="cp-count">{posts.length} stories</p>

        <div class="cp-row-list" id="cp-grid">
          {others.map((p: any) => (
            <article class="cp-story-row" data-cats={(p.categories || []).join('|')} data-name={(p.title + ' ' + (p.description || '')).toLowerCase()}>
              <div class="cp-main">
                <span class="cp-tag">{typeTag(p)}</span>
                <h4><a href={url(p.path)}>{p.title}</a></h4>
                <p class="cp-byline-sm">{p.author} &middot; {fmtDate(p.date)}</p>
              </div>
              <div class="cp-row-links">
                <a href={url(p.path)}>Read excerpt &rarr;</a>
                <button class="cp-save" type="button" title="Saving stories isn't built yet" aria-label="Bookmark">Bookmark</button>
              </div>
            </article>
          ))}
          {posts.filter((p: any) => p !== featured && !others.includes(p)).map((p: any) => (
            <article class="cp-story-row" data-cats={(p.categories || []).join('|')} data-name={(p.title + ' ' + (p.description || '')).toLowerCase()} hidden data-overflow>
              <div class="cp-main">
                <span class="cp-tag">{typeTag(p)}</span>
                <h4><a href={url(p.path)}>{p.title}</a></h4>
                <p class="cp-byline-sm">{p.author} &middot; {fmtDate(p.date)}</p>
              </div>
              <div class="cp-row-links">
                <a href={url(p.path)}>Read excerpt &rarr;</a>
                <button class="cp-save" type="button" title="Saving stories isn't built yet" aria-label="Bookmark">Bookmark</button>
              </div>
            </article>
          ))}
        </div>
        <p id="cp-empty" class="cp-empty" hidden>No stories match that search. Try a different term or category.</p>
        <button class="cp-btn ghost" id="cp-show-more" type="button">Show all {posts.length} stories</button>

        <div class="cp-review-link-row">
          <p>Every review carries one of Sara's six personal rating levels, from a first try to a true favorite.</p>
          <a href={url('/about-our-reviews')}>See how our review levels work &rarr;</a>
        </div>
      </div>
    </section>

    {upcomingEvents.length > 0 && (
      <section class="cp-events">
        <div class="wrap">
          <div class="cp-events-head">
            <div>
              <p class="cp-eyebrow">Happening soon</p>
              <h2>Upcoming local events</h2>
            </div>
            <a href={url('/living#featured')}>See the full calendar &rarr;</a>
          </div>
          <div class="cp-events-scroll">
            {upcomingEvents.map((e: any) => {
              const d = fmtEventDate(e.date);
              return (
                <div class="cp-event-card">
                  <span class="cp-event-date">{d.dow} {d.md}</span>
                  <h4>{e.title.replace(/\s*\[.*?\]\s*/g, ' ').trim()}</h4>
                  <p class="cp-event-loc">{e.venue}</p>
                  <a class="cp-rsvp-btn" href={url(e.path)}>RSVP</a>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  const q = document.getElementById('cp-q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const rows = [...document.querySelectorAll<HTMLElement>('.cp-story-row')];
  const count = document.getElementById('cp-count')!;
  const empty = document.getElementById('cp-empty') as HTMLElement;
  const showMoreBtn = document.getElementById('cp-show-more') as HTMLButtonElement;
  let cat = '';
  let expanded = false;

  function apply() {
    const term = q.value.trim().toLowerCase();
    const filtering = Boolean(term || cat);
    let n = 0;
    rows.forEach((r) => {
      const isOverflow = r.hasAttribute('data-overflow');
      const okCat = !cat || (r.dataset.cats || '').split('|').includes(cat);
      const okTerm = !term || (r.dataset.name || '').includes(term);
      const ok = okCat && okTerm;
      // Overflow rows only ever show while actively filtering or after "show more"; otherwise collapsed.
      const visible = ok && (filtering || expanded || !isOverflow);
      r.hidden = !visible;
      if (visible) n++;
    });
    count.textContent = `${n} ${n === 1 ? 'story' : 'stories'}`;
    empty.hidden = n > 0;
    showMoreBtn.hidden = filtering || expanded;
  }
  chips.forEach((chip) => chip.addEventListener('click', () => {
    cat = chip.dataset.cat || '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    apply();
  }));
  q.addEventListener('input', apply);
  showMoreBtn.addEventListener('click', () => { expanded = true; apply(); });
  apply();
</script>

<script>
import { membersReady, supabase } from '../../lib/members';

function esc(s: string) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function initials(name: string) {
  return name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || '?';
}

async function loadCommunityFeed() {
  const box = document.querySelector('[data-community-feed]') as HTMLElement;
  if (!box) return;
  if (!membersReady) { box.closest('section')?.remove(); (document.querySelector('[data-hero-preview]') as HTMLElement)?.remove(); return; }
  const sb = supabase();
  const { data, error } = await sb
    .from('posts')
    .select('id, body, neighborhood, created_at, profiles!posts_author_id_fkey(first_name,last_name)')
    .eq('visibility', 'public')
    .order('created_at', { ascending: false })
    .limit(6);
  if (error || !data || !data.length) { box.closest('section')?.remove(); (document.querySelector('[data-hero-preview]') as HTMLElement)?.remove(); return; }

  const feedItems = data.slice(0, 4);
  box.innerHTML = feedItems.map((p: any) => {
    const name = [p.profiles?.first_name, p.profiles?.last_name].filter(Boolean).join(' ') || 'Member';
    const when = new Date(p.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    return `<div class="cp-post">
      <div class="cp-post-top"><span class="cp-avatar">${esc(initials(name))}</span>
        <div><strong>${esc(name)}</strong><span class="cp-byline-sm">${p.neighborhood ? esc(p.neighborhood) + ' &middot; ' : ''}${when}</span></div>
      </div>
      <p class="cp-post-body">${esc(p.body)}</p>
    </div>`;
  }).join('');

  // Fill the hero preview card with the single most recent post, so the hero isn't empty.
  const top = data[0];
  const heroBox = document.querySelector('[data-hero-preview]') as HTMLElement;
  if (heroBox && top) {
    const name = [top.profiles?.first_name, top.profiles?.last_name].filter(Boolean).join(' ') || 'Member';
    const when = new Date(top.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    heroBox.querySelector('[data-hp-initials]')!.textContent = initials(name);
    heroBox.querySelector('[data-hp-name]')!.textContent = name;
    (heroBox.querySelector('[data-hp-when]') as HTMLElement).textContent = (top.neighborhood ? top.neighborhood + ' · ' : '') + when;
    heroBox.querySelector('[data-hp-body]')!.textContent = top.body;
    heroBox.hidden = false;
  }

  // Real count of posts from this calendar month, for the stat strip.
  const monthAgo = new Date(); monthAgo.setDate(1); monthAgo.setHours(0, 0, 0, 0);
  const { count: monthCount } = await sb
    .from('posts')
    .select('id', { count: 'exact', head: true })
    .eq('visibility', 'public')
    .gte('created_at', monthAgo.toISOString());
  const statEl = document.querySelector('[data-stat-posts]') as HTMLElement;
  if (statEl && typeof monthCount === 'number') {
    statEl.querySelector('[data-stat-posts-n]')!.textContent = String(monthCount);
    statEl.hidden = false;
  }
}

async function loadSpotlight() {
  const box = document.querySelector('[data-spotlight-box]') as HTMLElement;
  if (!box) return;
  if (!membersReady) { box.closest('section')?.remove(); return; }
  const { data, error } = await supabase()
    .from('public_profiles')
    .select('first_name, last_name, display_name, bio, area_of_interest, username')
    .eq('bio_public', true)
    .not('bio', 'is', null)
    .limit(6);
  if (error || !data || !data.length) { box.closest('section')?.remove(); return; }
  const pick = data[Math.floor(Math.random() * data.length)];
  const name = pick.display_name || [pick.first_name, pick.last_name].filter(Boolean).join(' ') || 'Member';
  box.innerHTML = `<div class="cp-spotlight-card">
    <span class="cp-avatar-lg">${esc(initials(name))}</span>
    <div>
      <h3>${esc(name)}</h3>
      ${pick.area_of_interest ? `<p class="cp-hood">${esc(pick.area_of_interest)}</p>` : ''}
      <p class="cp-quote">&ldquo;${esc(pick.bio)}&rdquo;</p>
    </div>
  </div>`;
}

loadCommunityFeed();
loadSpotlight();
</script>

<script is:inline>
  var q = new URLSearchParams(location.search).get('newsletter');
  var m = document.getElementById('cp-nl-msg');
  var r = document.getElementById('cp-nl-return');
  if (r) { r.value = location.origin + location.pathname; }
  if (q && m) {
    m.hidden = false;
    m.textContent = q === 'ok' ? 'Thanks, you are subscribed. Welcome to Tradition Local.'
      : q === 'invalid' ? 'That email address does not look right. Please try again.'
      : 'Something went wrong. Please try again, or email us.';
  }
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cp-page {
    --cp-navy: #141231; --cp-bg: #171f2b; --cp-community-bg: #152a20; --cp-community-line: #2a4536;
    --cp-card: #1d2635; --cp-card-2: #202c42; --cp-line: #2c3647;
    --cp-ink: #e8e9ec; --cp-muted: #8f96a3; --cp-muted-2: #b7bdc7;
    --cp-gold: #E7BC52; --cp-blue: #8fb6ea; --cp-green: #5fae7f;
    --cp-serif: 'Fraunces', Georgia, serif; --cp-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: var(--cp-bg); color: var(--cp-ink); font-family: var(--cp-sans);
  }
  .cp-page h1, .cp-page h2, .cp-page h3, .cp-page h4 { font-family: var(--cp-serif); font-weight: 600; color: #fff; margin: 0; }
  .cp-page a { color: inherit; }
  .cp-eyebrow { color: var(--cp-green); font-size: 13px; font-weight: 600; letter-spacing: .02em; margin: 0 0 12px; }
  .cp-muted { color: var(--cp-muted); font-size: 13.5px; }
  .cp-byline, .cp-byline-sm { color: var(--cp-muted); font-size: 13.5px; }

  .cp-btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 12px 22px; font-weight: 600; font-size: 14.5px; border: 0; cursor: pointer; text-decoration: none; font-family: var(--cp-sans); }
  .cp-btn.primary { background: var(--cp-blue); color: #10202e; }
  .cp-btn.ghost { background: transparent; border: 1.5px solid #3a4558; color: var(--cp-ink); }

  .cp-hero { background: var(--cp-navy); padding: 64px 0 48px; }
  .cp-hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .cp-hero h1 { font-size: clamp(2.1rem, 4vw, 3rem); line-height: 1.1; margin-bottom: 16px; }
  .cp-lede { color: var(--cp-muted-2); font-size: 1.05rem; max-width: 42ch; margin-bottom: 24px; }
  .cp-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .cp-hero-preview { background: var(--cp-community-bg); border: 1px solid var(--cp-community-line); border-radius: 16px; padding: 20px 22px; }
  .cp-tag { color: var(--cp-green); font-size: 12px; font-weight: 700; margin-bottom: 12px; display: block; }
  .cp-who { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .cp-avatar { width: 34px; height: 34px; border-radius: 50%; background: #2e4740; color: var(--cp-muted-2); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
  .cp-who span { display: block; color: var(--cp-muted); font-size: 12px; }
  .cp-hp-body { font-size: 14.5px; color: var(--cp-ink); }

  .cp-stat-strip { background: var(--cp-card-2); padding: 26px 0; }
  .cp-stat-strip .wrap { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px; text-align: center; }
  .cp-stat strong { font-family: var(--cp-serif); font-size: 1.7rem; display: block; color: #fff; }
  .cp-stat span { color: var(--cp-muted); font-size: 12.5px; }

  .cp-community { background: var(--cp-community-bg); border-bottom: 1px solid var(--cp-community-line); padding: 52px 0 60px; }
  .cp-community-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; margin-bottom: 8px; }
  .cp-community-head h2 { font-size: 1.9rem; }
  .cp-sub { color: var(--cp-muted-2); margin-top: 8px; font-size: 14.5px; max-width: 48ch; }
  .cp-feed { display: flex; flex-direction: column; margin-top: 26px; }
  .cp-post { padding: 20px 0; border-top: 1px solid var(--cp-community-line); }
  .cp-post:first-child { border-top: none; padding-top: 0; }
  .cp-post-top { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
  .cp-post-top strong { display: block; font-size: 1rem; }
  .cp-post-body { font-size: 15px; white-space: pre-line; max-width: 62ch; }

  .cp-spotlight { padding: 48px 0; }
  .cp-spotlight-head { margin-bottom: 22px; }
  .cp-spotlight-card { display: grid; grid-template-columns: auto 1fr; gap: 22px; background: var(--cp-card); border: 1px solid var(--cp-line); border-radius: 14px; padding: 24px 26px; align-items: center; }
  .cp-avatar-lg { width: 56px; height: 56px; border-radius: 50%; background: #30405a; color: var(--cp-blue); display: flex; align-items: center; justify-content: center; font-family: var(--cp-serif); font-size: 1.2rem; flex-shrink: 0; }
  .cp-spotlight-card h3 { font-size: 1.2rem; margin-bottom: 2px; }
