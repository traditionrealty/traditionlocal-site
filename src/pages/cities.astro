---
import Base from '../layouts/Base.astro';
import areas from '../data/areas.json';
import hoods from '../data/neighborhoods.json';
import subdivisions from '../data/subdivisions.json';
import { config } from '../config';
import { url } from '../lib/util';

const REGIONS = ['Central', 'West', 'North', 'South', 'East', 'Suburbs', 'Coast', 'Countryside'].filter((r) => areas.some((a) => a.region === r));
const trim = (s: string | null | undefined, n: number) => {
  const t = (s || '').replace(/\s+/g, ' ').trim();
  return t.length <= n ? t : t.slice(0, n).replace(/\s+\S*$/, '').replace(/[,;:]+$/, '') + '…';
};
const list = (areas as any[]).map((a) => ({
  slug: a.slug as string, name: a.name as string, type: a.type as string, region: a.region as string,
  vibe: trim(a.vibe, 150), bestFor: trim(a.bestFor, 120), schools: trim(a.schools, 70),
  take: a.take && a.vibe && a.schools ? trim(a.take, 230) : '',
})).sort((a, b) => a.name.localeCompare(b.name));
const nHood = list.filter((a) => a.type === 'Neighborhood').length;

// Spotlight: rotates by day through our featured areas (each has a vibe line, Dillon's take, and school info).
const FEATURED = ['spring-branch', 'the-heights', 'tanglewood', 'cypress', 'sugar-land', 'katy'];
let pool = FEATURED.map((s) => list.find((a) => a.slug === s && a.take)).filter(Boolean) as typeof list;
if (pool.length < 3) pool = list.filter((a) => a.take);
const dayIndex = Math.floor(Date.now() / 86400000);
const spotStart = pool.length ? dayIndex % pool.length : 0;
const spot = pool[spotStart];

// Group the subdivision profiles by the neighborhood they are in (same matching the old page used).
const subAreaByName: Record<string, string> = {};
(subdivisions as any[]).forEach((s) => (subAreaByName[s.name.trim().toLowerCase()] = s.area));
const areaByName: Record<string, any> = {};
(areas as any[]).forEach((a) => (areaByName[a.name.trim().toLowerCase()] = a));
const hoodGroups: Record<string, { area: any; items: any[] }> = {};
const otherHoods: any[] = [];
(hoods as any[]).forEach((h) => {
  const key = h.name.trim().toLowerCase();
  const areaSlug = subAreaByName[key] || areaByName[key]?.slug;
  const area = areaSlug ? (areas as any[]).find((a) => a.slug === areaSlug) : null;
  if (area) (hoodGroups[area.slug] ||= { area, items: [] }).items.push(h); else otherHoods.push(h);
});
const sortedGroups = Object.values(hoodGroups).sort((x, y) => x.area.name.localeCompare(y.area.name));
sortedGroups.forEach((g) => g.items.sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase())));
otherHoods.sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()));
const subTotal = hoods.length;

const SV = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const icon = (type: string, s: number) => {
  const paths: Record<string, string> = {
    Neighborhood: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
    City: '<path d="M4 21V8l6-3v16M10 21V10l10 3v8M3 21h18"/><path d="M7 11h0M7 15h0M14 15h0M17 17h0"/>',
    Area: '<circle cx="12" cy="9" r="6"/><path d="M12 15v6M9 21h6"/>',
  };
  return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" ' + SV + '>' + (paths[type] || paths.Area) + '</svg>';
};
const byType: Record<string, typeof list> = {};
list.forEach((a) => { (byType[a.type] = byType[a.type] || []).push(a); });
const TYPE_PLURAL: Record<string, string> = { Neighborhood: 'Neighborhoods', City: 'Cities', Area: 'Areas' };
const SHOW = 12;
const bar = [['spotlight', 'Spotlight'], ['kind', 'Your kind of local'], ['explore', 'Explore'], ['locally', 'Locally'], ['subs', 'Subdivisions'], ['home', 'Make it home']];
const spotJson = JSON.stringify(pool.map((a) => ({ s: a.slug, n: a.name, t: a.type, r: a.region, v: a.vibe, b: a.bestFor, sc: a.schools, k: a.take })));
---
<Base title="Around Town" description="Every Tradition Local neighborhood guide covers where to eat, how to spend a Saturday, and what it is really like to live there.">
  <section class="band cn-band">
    <div class="wrap">
      <p class="cn-crumb"><a href={url('/')}>Home</a> <span aria-hidden="true">&rsaquo;</span> Neighborhoods</p>
      <span class="cn-tag">Neighborhoods &middot; Greater Houston</span>
      <h1>Around Town</h1>
      <p class="cn-lead">Houston, one neighborhood at a time. Find a place that feels like you. Explore the local flavors, everyday discoveries, and connections that make each corner of Houston worth knowing.</p>
      <div class="cn-stats">
        <div><b>{list.length}</b><span>Area guides</span></div>
        <div><b>{nHood}</b><span>Neighborhoods</span></div>
        <div><b>{list.length - nHood}</b><span>Cities and areas</span></div>
        <div><b>{subTotal}</b><span>Subdivision profiles</span></div>
      </div>
      <div class="cn-btns"><a class="cn-pill gold" href="#explore">Explore neighborhoods</a><a class="cn-pill white" href={url('/neighborhood-info-request')}>Help me get started</a></div>
    </div>
  </section>
  <div class="cn-bar">
    <div class="wrap cn-barin">
      <nav class="cn-barlist" aria-label="Sections on this page">{bar.map((b, i) => <a href={'#' + b[0]} data-sec={b[0]} class={i === 0 ? 'on' : ''}>{b[1]}</a>)}</nav>
      <span class="cn-best">Best for: Movers, curious locals, and anyone choosing where to live</span>
    </div>
  </div>

  <section class="cn-blk wrap" id="perspective">
    <div class="cn-persp first">
      <h2>A local perspective. A personal connection.</h2>
      <p>Explore with Dillon and Sara through firsthand visits, neighborhood spotlights, and useful guides that connect the places you are curious about.</p>
      <p class="path"><a href="#explore">Area guide</a> &rarr; <a href="#spotlight">Neighborhood spotlight</a> &rarr; <a href="#subs">Subdivision profiles</a>, where applicable.</p>
    </div>
  </section>

  {spot && (
    <section class="cn-blk wrap" id="spotlight">
      <div class="cn-sechead"><div><h2>Neighborhood spotlight</h2></div><button class="cn-linkbtn" type="button" id="cn-spotnext">See another &rarr;</button></div>
      <div class="cn-spot" id="cn-spot">
        <div class="tile" aria-hidden="true"><span set:html={icon(spot.type, 34)}></span><h3>{spot.name}</h3><span class="ph">[Neighborhood photo]</span></div>
        <div class="body">
          <span class="tg">Explore locally</span>
          <h3 class="t">Get to know {spot.name}.</h3>
          <p>{spot.vibe}</p>
          <div class="facts"><span><b>Best for:</b> {spot.bestFor}</span><span><b>Schools:</b> {spot.schools}</span><span><b>Region:</b> {spot.region}</span></div>
          <p class="take">&ldquo;{spot.take}&rdquo; Dillon</p>
          <div class="acts"><a class="cn-pill gold" href={url('/cities/' + spot.slug)}>Explore the guide</a></div>
        </div>
      </div>
      <script type="application/json" id="cn-spotdata" set:html={spotJson}></script>
    </section>
  )}

  <section class="cn-blk wrap" id="kind">
    <div class="cn-kind">
      <div><p class="eb">Your kind of local</p><h2>Start with what you love.</h2><p>Follow a good meal, an afternoon outdoors, or a local story into a neighborhood you want to know better.</p></div>
      <div class="kchips">
        <a class="kchip" href={url('/food')}>Food &amp; coffee</a>
        <a class="kchip" href={url('/living')}>Outdoors &amp; outings</a>
        <a class="kchip" href={url('/all-articles')}>People &amp; stories</a>
      </div>
    </div>
  </section>

  <section class="cn-blk wrap" id="explore">
    <div class="cn-sechead"><div><h2>Where would you like to explore?</h2></div><span class="cn-badge">Every card opens its neighborhood profile</span></div>
    <div class="cn-filters">
      <label>Find an area<input type="search" id="cn-q" placeholder="Search neighborhoods and communities" /></label>
      <label>Browse
        <select id="cn-region"><option value="">All areas</option>{REGIONS.map((r) => <option value={r}>{r} ({list.filter((a) => a.region === r).length})</option>)}</select>
      </label>
    </div>
    <div class="cn-tabs" id="cn-tabs" role="group" aria-label="Type of area">
      <button class="cn-tab" type="button" data-type="" aria-pressed="true">All areas</button>
      <button class="cn-tab" type="button" data-type="Neighborhood" aria-pressed="false">Neighborhoods</button>
      <button class="cn-tab" type="button" data-type="City" aria-pressed="false">Cities</button>
      <button class="cn-tab" type="button" data-type="Area" aria-pressed="false">Areas</button>
    </div>
    <p class="cn-count" id="cn-count" aria-live="polite">{list.length} areas to explore</p>
    <div class="cn-grid" id="cn-grid">
      {list.map((a, i) => (
        <article class="cn-acard" hidden={i >= SHOW} data-region={a.region} data-type={a.type} data-text={(a.name + ' ' + a.vibe).toLowerCase()}>
          <div class="band2"><span class="ic" set:html={icon(a.type, 26)}></span><span>{a.type} &middot; {a.region}</span></div>
          <div class="body">
            <h3><a href={url('/cities/' + a.slug)}>{a.name}</a></h3>
            <p>{a.vibe}</p>
            <div class="row"><a class="cn-pill line sm" href={url('/cities/' + a.slug)}>Explore {a.name.length > 26 ? 'this guide' : a.name} &rarr;</a></div>
          </div>
        </article>
      ))}
    </div>
    <div class="cn-empty" id="cn-empty" hidden>No areas match that search. Try another name or region.</div>
    <div class="cn-more"><button class="cn-pill line" type="button" id="cn-more" hidden={list.length <= SHOW}>Show more areas</button></div>
    <noscript><style>.cn-acard[hidden] { display: flex; }</style></noscript>
  </section>

  <section class="cn-blk wrap" id="locally">
    <div class="cn-locally">
      <div><p class="eb" id="cn-loceb">Locally{spot ? ' · ' + spot.name : ''}</p><h2>Your neighborhood.<br />In your inbox.</h2><p id="cn-loctext">Get food finds, things to do, local stories, and updates for your neighborhood.</p></div>
      {config.newsletterAction ? (
        <form id="cn-locform" action={config.newsletterAction} method="post">
          <label for="cn-locarea">Choose your neighborhood</label>
          <select id="cn-locarea" name="neighborhood">
            {['Neighborhood', 'City', 'Area'].filter((t) => byType[t]).map((t) => (
              <optgroup label={TYPE_PLURAL[t]}>{byType[t].map((a) => <option value={a.slug} selected={spot ? a.slug === spot.slug : false}>{a.name}</option>)}</optgroup>
            ))}
          </select>
          <label for="cn-locemail">Email address</label>
          <input id="cn-locemail" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <input type="hidden" name="return" id="cn-locreturn" />
          <button type="submit">Join Locally</button>
          <p class="fine" id="cn-locmsg" role="status">Joins the Tradition Local newsletter. We note your neighborhood for Locally updates.</p>
        </form>
      ) : (
        <div><a class="cn-pill gold" href={'mailto:' + config.contactEmail + '?subject=Locally%20newsletter'}>Email us to join Locally</a></div>
      )}
    </div>
  </section>

  <section class="cn-blk wrap" id="subs">
    <div class="cn-sechead"><div><h2>Subdivision profiles</h2></div><span class="cn-hcount">{subTotal} communities</span></div>
    <p class="cn-hdesc">Price ranges, price per square foot, HOAs, and school districts for individual subdivisions, grouped by neighborhood.</p>
    {sortedGroups.map((g) => (
      <div class="cn-hgroup">
        <h3><a href={url('/cities/' + g.area.slug)}>{g.area.name}</a><small>{g.items.length}</small></h3>
        <ul class="cn-hlinks">{g.items.map((h) => <li><a href={url(h.path)}>{h.name}</a></li>)}</ul>
      </div>
    ))}
    {otherHoods.length > 0 && (
      <div class="cn-hgroup">
        <h3>Other communities<small>{otherHoods.length}</small></h3>
        <ul class="cn-hlinks">{otherHoods.map((h) => <li><a href={url(h.path)}>{h.name}</a></li>)}</ul>
      </div>
    )}
  </section>

  <section class="cn-blk padb wrap" id="home">
    <div class="cn-mih">
      <div><p class="eb">Make it home</p><h2>Exploring a neighborhood? Considering a move?</h2><p>Dillon can help you turn local curiosity into a plan.</p></div>
      <div class="btnrow"><a class="cn-pill gold" href={url('/neighborhood-info-request')}>Ask Dillon</a><a class="cn-pill line" href={url('/make-it-home')}>Compare neighborhoods</a></div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var cards = [].slice.call(document.querySelectorAll('.cn-acard'));
    var SHOW = 12, st = { q: '', region: '', type: '', limit: SHOW };
    function render() {
      var q = st.q.trim().toLowerCase(), n = 0, shown = 0;
      cards.forEach(function (c) {
        var ok = (!q || c.getAttribute('data-text').indexOf(q) > -1) && (!st.region || c.getAttribute('data-region') === st.region) && (!st.type || c.getAttribute('data-type') === st.type);
        if (ok) { n++; if (shown < st.limit) { shown++; c.hidden = false; } else { c.hidden = true; } } else { c.hidden = true; }
      });
      $('cn-count').textContent = n + ' area' + (n === 1 ? '' : 's') + ' to explore';
      $('cn-empty').hidden = n > 0;
      $('cn-more').hidden = n <= st.limit;
      document.querySelectorAll('#cn-tabs [data-type]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-type') === st.type)); });
    }
    $('cn-q').addEventListener('input', function () { st.q = this.value; st.limit = SHOW; render(); });
    $('cn-region').addEventListener('change', function () { st.region = this.value; st.limit = SHOW; render(); });
    $('cn-tabs').addEventListener('click', function (e) { var b = e.target.closest('[data-type]'); if (!b) return; st.type = b.getAttribute('data-type'); st.limit = SHOW; render(); });
    $('cn-more').addEventListener('click', function () { st.limit += SHOW; render(); });
    render();

    // spotlight: "See another" cycles through the featured areas
    var dataEl = $('cn-spotdata'), btn = $('cn-spotnext');
    if (dataEl && btn) {
      var pool = JSON.parse(dataEl.textContent), si = 0;
      var base = (document.querySelector('.cn-hgroup h3 a') || { getAttribute: function () { return ''; } }).getAttribute('href') || '';
      var prefix = base.replace(/\/cities\/[^/]*\/?$/, '');
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      var first = (document.querySelector('#cn-spot .acts a') || {}).getAttribute && document.querySelector('#cn-spot .acts a').getAttribute('href');
      pool.forEach(function (a, i) { if (first && first.indexOf('/cities/' + a.s) > -1) si = i; });
      var tileHtml = document.querySelector('#cn-spot .tile span').innerHTML;
      var linkBase = first ? first.replace(/\/cities\/[^/]*\/?$/, '') : prefix;
      btn.addEventListener('click', function () {
        si = (si + 1) % pool.length; var a = pool[si];
        $('cn-spot').innerHTML = '<div class="tile" aria-hidden="true"><span>' + tileHtml + '</span><h3>' + esc(a.n) + '</h3><span class="ph">[Neighborhood photo]</span></div><div class="body"><span class="tg">Explore locally</span><h3 class="t">Get to know ' + esc(a.n) + '.</h3><p>' + esc(a.v) + '</p><div class="facts"><span><b>Best for:</b> ' + esc(a.b) + '</span><span><b>Schools:</b> ' + esc(a.sc) + '</span><span><b>Region:</b> ' + esc(a.r) + '</span></div><p class="take">“' + esc(a.k) + '” Dillon</p><div class="acts"><a class="cn-pill gold" href="' + linkBase + '/cities/' + a.s + '">Explore the guide</a></div></div>';
      });
    }

    // Locally: show the chosen neighborhood, and the result after the newsletter form returns here
    var sel = $('cn-locarea');
    if (sel) {
      var upd = function () { var o = sel.options[sel.selectedIndex]; $('cn-loceb').textContent = 'Locally · ' + o.textContent; $('cn-loctext').textContent = 'Get food finds, things to do, local stories, and updates for ' + o.textContent + '.'; };
      sel.addEventListener('change', upd); upd();
      var ret = $('cn-locreturn'); if (ret) ret.value = location.origin + location.pathname;
      var q = new URLSearchParams(location.search).get('newsletter'), m = $('cn-locmsg');
      if (q && m) { m.textContent = q === 'ok' ? 'Thanks, you are subscribed. Welcome to Tradition Local.' : q === 'invalid' ? 'That email address does not look right. Please try again.' : 'Something went wrong. Please try again, or email us.'; var ls = $('locally'); if (ls) setTimeout(function () { ls.scrollIntoView(); }, 50); }
    }

    // keep the section bar in sync while scrolling
    var links = [].slice.call(document.querySelectorAll('.cn-bar a[data-sec]'));
    window.addEventListener('scroll', function () {
      var cur = links[0].getAttribute('data-sec');
      links.forEach(function (a) { var el = document.getElementById(a.getAttribute('data-sec')); if (el && el.getBoundingClientRect().top <= 140) cur = a.getAttribute('data-sec'); });
      links.forEach(function (a) { a.classList.toggle('on', a.getAttribute('data-sec') === cur); });
    }, { passive: true });
  })();
</script>

<style is:global>
  .cn-band { padding: 36px 0 44px; }
  .cn-crumb { font-size: 14px; color: rgba(255,255,255,.8); margin: 0 0 18px; }
  .cn-crumb a { color: #dfe6fb; }
  .cn-tag { display: inline-block; background: rgba(255,255,255,.18); border-radius: 99px; padding: 7px 16px; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 12px; color: #fff; }
  .cn-band h1 { font-size: clamp(44px, 7vw, 78px); line-height: 1.05; margin: 0 0 22px; }
  .cn-lead { font-size: 20px; line-height: 1.55; max-width: 34em; margin: 0 0 30px; color: #fff; }
  .cn-stats { display: flex; flex-wrap: wrap; gap: 20px 56px; margin: 0 0 28px; }
  .cn-stats b { display: block; font: 600 clamp(24px, 3vw, 32px)/1.2 var(--serif); color: #fff; }
  .cn-stats span { font-size: 15px; color: rgba(255,255,255,.8); }
  .cn-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .cn-pill { display: inline-block; border-radius: 999px; padding: 12px 26px; font: 700 15px var(--serif); text-decoration: none; cursor: pointer; border: 2px solid transparent; }
  .cn-pill:hover { text-decoration: none; }
  .cn-pill.gold { background: var(--gold); color: var(--navy); }
  .cn-pill.white { background: #fff; color: var(--navy); }
  .cn-pill.line { background: #fff; border-color: var(--line); color: var(--blue); }
  .cn-pill.line:hover { border-color: var(--blue); }
  .cn-pill.sm { padding: 7px 16px; font-size: 13px; }

  .cn-bar { position: sticky; top: 0; z-index: 6; background: #fff; border-bottom: 1px solid var(--line); }
  .cn-barin { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
  .cn-barlist { display: flex; gap: 6px; flex-wrap: wrap; }
  .cn-barlist a { border-radius: 999px; padding: 11px 20px; font: 700 17px var(--sans); color: var(--navy); text-decoration: none; }
  .cn-barlist a:hover { background: var(--cream); }
  .cn-barlist a.on { background: var(--navy); color: #fff; }
  .cn-best { color: var(--muted); font-size: 17px; }

  .cn-blk { padding: 44px 0 8px; scroll-margin-top: 84px; }
  .cn-blk.padb { padding-bottom: 44px; }
  .cn-sechead { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; border-bottom: 2px solid var(--blue); padding-bottom: 8px; margin-bottom: 18px; }
  .cn-sechead h2 { margin: 0; font-size: clamp(26px, 3.4vw, 34px); color: var(--blue); line-height: 1.15; }
  .cn-badge { font-size: 12px; color: var(--muted); background: #fff; border: 1px solid var(--line); border-radius: 99px; padding: 3px 12px; }
  .cn-linkbtn { background: none; border: 0; color: var(--blue); font-weight: 700; cursor: pointer; font-size: 15px; padding: 8px 4px; text-decoration: underline; }

  .cn-persp h2 { font-size: clamp(26px, 3.2vw, 34px); color: var(--blue); margin: 0 0 10px; line-height: 1.2; }
  .cn-persp p { font-size: 18px; max-width: 62ch; margin: 0 0 12px; }
  .cn-persp .path { font-size: 15px; color: var(--muted); }
  .cn-persp .path a { color: var(--blue); font-weight: 700; text-decoration: none; }

  .cn-spot { display: grid; grid-template-columns: 1fr 1.4fr; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; }
  @media (max-width: 800px) { .cn-spot { grid-template-columns: 1fr; } }
  .cn-spot .tile { background: var(--cream); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 34px 20px; min-height: 260px; text-align: center; color: var(--navy); }
  .cn-spot .tile h3 { font-size: clamp(30px, 4vw, 44px); line-height: 1.1; margin: 0; }
  .cn-spot .tile .ph { font: italic 400 15px var(--serif); color: var(--muted); }
  .cn-spot .body { padding: 28px 32px; display: flex; flex-direction: column; gap: 12px; }
  .cn-spot .tg { align-self: flex-start; background: var(--gold-soft); color: #6b4a1d; border-radius: 99px; padding: 4px 14px; font-size: 13px; font-weight: 700; }
  .cn-spot h3.t { font-size: clamp(28px, 3.6vw, 38px); line-height: 1.15; color: var(--navy); margin: 0; }
  .cn-spot p { margin: 0; font-size: 18px; color: var(--ink); }
  .cn-spot .facts { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; color: var(--muted); }
  .cn-spot .facts b { color: var(--navy); }
  .cn-spot .take { border-left: 3px solid var(--gold); padding-left: 14px; font-size: 16px; color: var(--muted); font-style: italic; }
  .cn-spot .acts { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

  .cn-kind { background: var(--navy); color: #fff; border-radius: 18px; padding: 30px 34px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 26px; align-items: center; }
  @media (max-width: 860px) { .cn-kind { grid-template-columns: 1fr; } }
  .cn-kind .eb, .cn-mih .eb, .cn-locally .eb { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin: 0 0 6px; }
