---
import Base from '../layouts/Base.astro';
import areas from '../data/areas.json';
import businesses from '../data/businesses.json';
import hoods from '../data/neighborhoods.json';
import subdivisions from '../data/subdivisions.json';
import { url } from '../lib/util';
const regions = ['Central', 'West', 'North', 'South', 'East', 'Suburbs', 'Coast', 'Countryside'].filter((r) => areas.some((a) => a.region === r));
// "Trending" proxy for a neighborhood: the most recent reviewYear among businesses located there.
// Areas with no linked businesses sort last.
const latestYearByArea: Record<string, number> = {};
businesses.forEach((b) => {
  if (b.area && b.reviewYear) latestYearByArea[b.area] = Math.max(latestYearByArea[b.area] || 0, b.reviewYear);
});

// Group the 270 subdivision profiles by the neighborhood they're actually in, instead of one
// flat A-Z list. Resolved by matching each profile's name against our subdivisions dataset
// (which already carries a clean area link); a handful are themselves area-level names and
// resolve directly against areas.json.
const subAreaByName: Record<string, string> = {};
subdivisions.forEach((s) => (subAreaByName[s.name.trim().toLowerCase()] = s.area));
const areaByName: Record<string, (typeof areas)[number]> = {};
areas.forEach((a) => (areaByName[a.name.trim().toLowerCase()] = a));
const hoodGroups: Record<string, { area: (typeof areas)[number]; items: typeof hoods }> = {};
const otherHoods: typeof hoods = [];
hoods.forEach((h) => {
  const key = h.name.trim().toLowerCase();
  const areaSlug = subAreaByName[key] || areaByName[key]?.slug;
  const area = areaSlug ? areas.find((a) => a.slug === areaSlug) : null;
  if (area) {
    (hoodGroups[area.slug] ||= { area, items: [] }).items.push(h);
  } else {
    otherHoods.push(h);
  }
});
const sortedHoodGroups = Object.values(hoodGroups).sort((x, y) => x.area.name.localeCompare(y.area.name));

// Rotating neighborhood guide preview, shown above "Browse neighborhoods". Rotates by calendar
// day (changes whenever the site next rebuilds on a new day) through areas that actually have
// enough real content to look complete: at least 2 Sara's-pick businesses, a vibe line, Dillon's
// take, and school info. Two fields we don't have anywhere (median home price, commute time) and
// the "Perfect Saturday" itinerary beyond the coffee stop are shown as honest bracketed
// placeholders, same convention used for "Opened this month" and the Food Feature card.
const RATING_LABEL: Record<string, string> = { stop: 'Worth a Stop', drive: 'Worth the Drive', trip: 'Worth the Trip' };
const picksByArea: Record<string, typeof businesses> = {};
businesses.forEach((b) => { if (b.area && b.saraPick) (picksByArea[b.area] ||= []).push(b); });
const rotationPool = areas.filter((a) => (picksByArea[a.slug]?.length || 0) >= 2 && a.take && a.vibe && a.schools);
const dayIndex = Math.floor(Date.now() / 86400000);
const featured = rotationPool.length > 0 ? rotationPool[dayIndex % rotationPool.length] : null;
const featuredPicks = featured ? (picksByArea[featured.slug] || []).slice(0, 3) : [];
const coffeePick = featuredPicks.find((b) => b.categories.includes('Coffee & Tea'));
---
<Base title="Around Town" description="Every Tradition Local neighborhood guide covers where to eat, how to spend a Saturday, and what it is really like to live there.">
  <section class="band">
    <div class="wrap">
      <p class="kicker">Eat, do, and live like a local</p>
      <h1>Around Town</h1>
      <p class="lede">Every neighborhood guide covers where to eat, how to spend a Saturday, and what it is really like to live there.</p>
      <a class="btn gold" href={url('/neighborhood-info-request')}>Not sure? Ask Dillon</a>
      <p class="mih-link"><a href={url('/make-it-home')}>Compare neighborhoods side by side &rarr;</a></p>
    </div>
  </section>
  {featured && (
    <section class="section preview-section">
      <div class="wrap">
        <div class="preview-head">
          <div>
            <p class="preview-kicker">Neighborhood guide preview</p>
            <h2>{featured.name}</h2>
            <p class="preview-vibe">{featured.vibe}</p>
          </div>
          <a class="preview-open" href={url(`/cities/${featured.slug}`)}>Open the full {featured.name} guide &rarr;</a>
        </div>
        <div class="preview-grid">
          <div class="preview-card">
            <p class="col-kicker">Where to eat</p>
            {featuredPicks.length > 0 ? (
              <ul class="preview-eats">
                {featuredPicks.map((b) => (
                  <li>
                    <div class="ph"></div>
                    <div>
                      <strong><a href={url(`/eat/${b.slug}`)}>{b.name}</a></strong>
                      <span class="muted small">{RATING_LABEL[b.rating] || "Sara's pick"} &middot; {b.categories[0]}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : <p class="muted small">No spots listed here yet.</p>}
            <a class="more-link" href={url(`/cities/${featured.slug}`)}>All places to eat &rarr;</a>
          </div>
          <div class="preview-card">
            <p class="col-kicker">The perfect Saturday</p>
            <ul class="sat-list">
              <li><span class="time">9 AM</span><div><strong>Coffee</strong><span class="muted small">{coffeePick ? coffeePick.name : <span class="ph-text">[Coffee shop]</span>}</span></div></li>
              <li><span class="time">11 AM</span><div><strong>Park or trail</strong><span class="muted small ph-text">[Park name]</span></div></li>
              <li><span class="time">2 PM</span><div><strong>Local shops</strong><span class="muted small ph-text">[Shop or market]</span></div></li>
              <li><span class="time">7 PM</span><div><strong>Dinner</strong><span class="muted small ph-text">[Restaurant]</span></div></li>
            </ul>
            <a class="more-link" href={url(`/cities/${featured.slug}`)}>What's on this weekend &rarr;</a>
          </div>
          <div class="preview-card dark">
            <p class="col-kicker gold">Living here</p>
            <dl>
              <div><dt>Median home price</dt><dd class="ph-text">[$000K]</dd></div>
              <div><dt>Commute to Galleria</dt><dd class="ph-text">[00 min]</dd></div>
              <div><dt>School district</dt><dd>{featured.schools}</dd></div>
            </dl>
            <p class="quote">&ldquo;{featured.take}&rdquo;</p>
            <a class="btn gold" href={url(`/cities/${featured.slug}`)}>Living in {featured.name} &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  )}
  <section class="section">
    <div class="wrap">
      <h2 class="filters-head">Browse neighborhoods</h2>
      <div class="filters" id="filters">
        <label class="search"><span class="sr">Search neighborhoods</span>
          <input type="search" id="q" placeholder="Search by name" />
        </label>
      </div>
      <div class="chips" role="group" aria-label="Filter by region">
        <button class="chip" data-region="" data-trending="1" aria-pressed="true">Trending</button>
        <button class="chip" data-region="" aria-pressed="false">All regions</button>
        {regions.map((r) => <button class="chip" data-region={r} aria-pressed="false">{r}</button>)}
      </div>
      <p class="muted" id="count" aria-live="polite">{areas.length} guides</p>
      <ul class="areas" id="areas">
        {areas.map((a) => (
          <li data-region={a.region} data-name={a.name.toLowerCase()} data-year={latestYearByArea[a.slug] || 0}>
            <a href={url(`/cities/${a.slug}`)}>
              <span class="type">{a.type} in {a.region}</span>
              <strong>{a.name}</strong>
              <span class="vibe">{a.vibe}</span>
            </a>
          </li>
        ))}
      </ul>
      <p id="empty" hidden>No neighborhoods match that search.</p>
    </div>
  </section>
  <section class="section tint">
    <div class="wrap">
      <div class="section-head"><h2>Subdivision profiles</h2><span class="muted">{hoods.length} communities</span></div>
      <p>Price ranges, price per square foot, HOAs, and school districts for individual subdivisions, grouped by neighborhood.</p>
      {sortedHoodGroups.map((g) => (
        <div class="hood-group">
          <h3><a href={url(`/cities/${g.area.slug}`)}>{g.area.name}</a> <span class="muted small">{g.items.length}</span></h3>
          <ul class="hood-index">{g.items.map((h) => <li><a href={url(h.path)}>{h.name}</a></li>)}</ul>
        </div>
      ))}
      {otherHoods.length > 0 && (
        <div class="hood-group">
          <h3>Other communities <span class="muted small">{otherHoods.length}</span></h3>
          <ul class="hood-index">{otherHoods.map((h) => <li><a href={url(h.path)}>{h.name}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-region]')].filter((el) => el.tagName === 'BUTTON');
  const list = document.getElementById('areas')!;
  const originalOrder = [...document.querySelectorAll<HTMLLIElement>('#areas li')];
  const items = originalOrder;
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  let region = '';
  let trending = true;
  function apply() {
    const term = q.value.trim().toLowerCase();
    const order = trending
      ? [...items].sort((a, b) => Number(b.dataset.year) - Number(a.dataset.year))
      : originalOrder;
    let n = 0;
    for (const li of order) {
      const ok = (!term || li.dataset.name!.includes(term)) && (!region || li.dataset.region === region) && (!trending || n < 12);
      li.hidden = !ok; if (ok) n++;
    }
    count.textContent = `${n} ${n === 1 ? 'guide' : 'guides'}`;
    empty.hidden = n > 0;
    order.forEach((li) => list.appendChild(li));
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    region = c.dataset.region || '';
    trending = c.dataset.trending === '1';
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  q.addEventListener('input', apply);
  apply();
</script>
<style>
  .filters-head { margin: 0 0 16px; }
  .filters { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
  .filters input[type=search] { padding: 12px 16px; border: 1.5px solid var(--line); border-radius: 999px; font-size: 16px; background: #fff; }
  .search { flex: 1 1 320px; } .search input { width: 100%; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .mih-link { margin-top: 14px; }
  .mih-link a { color: var(--gold); font-weight: 600; text-decoration: underline; }
  .preview-section { background: var(--cream); }
  .preview-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 24px; }
  .preview-kicker { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--brown); margin: 0; }
  .preview-head h2 { margin: 4px 0 6px; }
  .preview-vibe { color: var(--muted); margin: 0; }
  .preview-open { font-weight: 600; white-space: nowrap; }
  .preview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }
  .preview-card { background: #fff; border-radius: 10px; padding: 24px; display: flex; flex-direction: column; }
  .preview-card.dark { background: var(--navy); color: #fff; }
  .col-kicker { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--brown); margin: 0 0 16px; }
  .col-kicker.gold { color: var(--gold); }
  .preview-eats { list-style: none; margin: 0 0 12px; padding: 0; }
  .preview-eats li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .preview-eats li:last-child { border-bottom: none; }
  .preview-eats .ph { flex-shrink: 0; width: 48px; height: 48px; border-radius: 6px; background: linear-gradient(135deg, var(--cream), var(--gold-soft)); }
  .preview-eats strong { font-family: var(--serif); font-weight: 400; font-size: 1.05rem; }
  .preview-eats strong a { color: var(--blue); text-decoration: none; }
  .preview-eats span.muted { display: block; font-size: 13px; }
  .sat-list { list-style: none; margin: 0 0 12px; padding: 0; }
  .sat-list li { display: flex; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .sat-list li:last-child { border-bottom: none; }
  .sat-list .time { flex-shrink: 0; width: 46px; font-size: 12px; font-weight: 700; color: var(--brown); padding-top: 2px; }
  .sat-list strong { display: block; font-size: 15px; }
  .sat-list span.muted { display: block; font-size: 13px; }
  .more-link { margin-top: auto; font-weight: 600; font-size: 14px; }
  .preview-card.dark dl { margin: 0 0 20px; }
  .preview-card.dark dl > div { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.2); font-size: 14px; }
  .preview-card.dark dt { color: rgba(255,255,255,.75); }
  .preview-card.dark dd { font-weight: 700; }
  .preview-card.dark .quote { font-family: var(--serif); font-size: 1.1rem; line-height: 1.4; margin: 0 0 20px; }
  .preview-card.dark .btn.gold { margin-top: auto; text-align: center; }
  .ph-text { color: var(--muted); font-style: italic; }
  .preview-card.dark .ph-text { color: rgba(255,255,255,.6); }
  @media (max-width: 900px) { .preview-grid { grid-template-columns: 1fr; } }
  #count { margin: 18px 0; }
  .areas { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .areas li[hidden] { display: none; }
  .areas a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 22px; border: 1px solid var(--line); border-top: 4px solid var(--gold); text-decoration: none; color: var(--ink); }
  .areas a:hover { background: var(--cream); }
  .type { font-size: 13px; color: var(--brown); }
  .areas strong { font-family: var(--serif); font-weight: 400; font-size: 1.5rem; color: var(--blue); }
  .vibe { color: var(--muted); font-size: 15px; }
  .hood-group { margin-top: 36px; }
  .hood-group h3 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; color: var(--blue); margin: 0 0 4px; }
  .hood-group h3 a { color: inherit; text-decoration: none; }
  .hood-group h3 a:hover { text-decoration: underline; }
  .muted.small { font-size: 14px; font-weight: 400; font-family: var(--sans); }
  .hood-index { columns: 4 200px; padding: 0; list-style: none; margin-top: 12px; }
  .hood-index li { break-inside: avoid; padding: 3px 0; }
  .hood-index a { text-decoration: none; }
</style>
