---
import Base from '../layouts/Base.astro';
import MemberForm from '../components/MemberForm.astro';
import { url } from '../lib/util';
---
<Base title="Sign in" description="Sign in to your Tradition Local member account.">
  <MemberForm title="Welcome back" intro="Sign in to your Tradition Local member account.">
    <div data-redirect-if-member={url('/members')}></div>
    <form class="mform" id="signin-form" novalidate>
      <p class="msg" data-msg role="alert" tabindex="-1" hidden></p>
      <label>Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>Password
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button class="btn blue" type="submit">Sign in</button>
    </form>
    <p class="alt"><a href={url('/reset-password')}>Forgot your password?</a></p>
    <p class="alt">New here? <a href={url('/join')}>Create a free account</a></p>
  </MemberForm>
</Base>

<script>
  import { membersReady, supabase, siteUrl, friendly, say, busy, field } from '../lib/members';
  const form = document.getElementById('signin-form') as HTMLFormElement | null;
  if (form && membersReady) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      say(form, '');
      const { error } = await busy(form, 'Signing in…', () =>
        supabase().auth.signInWithPassword({ email: field(form, 'email'), password: field(form, 'password') }));
      if (error) return say(form, friendly(error.message));
      const back = new URLSearchParams(window.location.search).get('next');
      window.location.href = back && back.startsWith('/') ? siteUrl(back) : siteUrl('/members');
    });
  }
</script>
