---
import Base from '../layouts/Base.astro';
import { config } from '../config';
import { url } from '../lib/util';
import site from '../data/site.json';
const youtubeUrl = site.social?.youtube || 'https://www.youtube.com/@traditionlocal';
---
<Base title="Meet Dillon" description="Dillon Loren is a Houston Realtor with Tradition Realty Group, connecting local discovery with practical real estate guidance.">
  <section class="band tone-cool">
    <div class="wrap">
      <p class="crumb"><a href={url('/about')}>About Us</a> / Meet Dillon Loren</p>
      <p class="kicker">Meet Dillon Loren</p>
      <h1>Your Houston Realtor.<br />Your local guide.</h1>
      <p class="lede">A decade of experience. Thoughtful strategy. Genuine hospitality. Dillon helps you understand your options and make your next move with clarity.</p>
      <div class="cta-row">
        <a class="btn-meet" href={config.brokerage.url} target="_blank" rel="noopener">Book a call with Dillon &nearr;</a>
        <a class="mlink-dark" href={config.brokerage.url} target="_blank" rel="noopener">Search Houston homes &nearr;</a>
      </div>
      <p class="brokerage-line">{config.brokerage.name} &middot; Keller Williams Memorial</p>
      <div class="photo-ph">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
        <span>Dillon Loren</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Local perspective.<br />Personal attention.</h2>
      <p>I'm interested in the people, economics, and everyday details that shape a neighborhood. My approach starts with listening, careful preparation, and clear communication.</p>
      <p>Here, I share useful local insights. Through {config.brokerage.name}, I represent buyers, sellers, renters, landlords, and investors.</p>
      <div class="video-card">
        <a href={youtubeUrl} target="_blank" rel="noopener" class="video-link">
          <span class="play-btn">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 5v14l11-7-11-7z"/></svg>
          </span>
          <span class="video-label">Watch on YouTube</span>
        </a>
      </div>
      <h3>A quick hello.</h3>
      <p class="muted">Get to know the person behind the guidance.</p>
      <a class="mlink-light" href={youtubeUrl} target="_blank" rel="noopener">Explore Dillon's videos &nearr;</a>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">Explore &amp; connect</p>
      <h2>What would help you next?</h2>
      <p class="lede-dark">A guide to get started, a resource to use, or a neighborhood to get to know.</p>
      <div class="help-cards">
        <a class="help-card" data-tone="warm" href={url('/all-articles')}>
          <div class="help-band">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5c3 0 6 1 8 3 2-2 5-3 8-3v13c-3 0-6 1-8 3-2-2-5-3-8-3V5z"/></svg>
          </div>
          <div class="help-body">
            <h3>Guides</h3>
            <p>Practical reading for buying, selling, renting, and your first investment.</p>
            <span class="mlink-dark">Find a guide &nearr;</span>
          </div>
        </a>
        <a class="help-card" data-tone="slate" href={config.brokerage.url} target="_blank" rel="noopener">
          <div class="help-band">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7l8-4 8 4v10l-8 4-8-4V7z"/></svg>
          </div>
          <div class="help-body">
            <h3>Shared Resources</h3>
            <p>Calculators, checklists, and useful references to support your next decision.</p>
            <span class="mlink-dark">Explore shared resources &nearr;</span>
          </div>
        </a>
        <a class="help-card" data-tone="green" href={url('/cities')}>
          <div class="help-band">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z"/></svg>
          </div>
          <div class="help-body">
            <h3>Neighborhoods</h3>
            <p>Area introductions, local discoveries, and the places around your next home.</p>
            <span class="mlink-dark">Explore neighborhoods &nearr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Real estate services</p>
      <h2>Ways Dillon can help with your next move.</h2>
      <div class="service-grid">
        <a class="service-card" href={url('/new-builds')}>
          <h3>New construction</h3>
          <p>Guidance through new build communities across Greater Houston, from lot selection to closing.</p>
        </a>
        <a class="service-card" href={config.brokerage.url} target="_blank" rel="noopener">
          <h3>Apartment locating</h3>
          <p>Help finding the right rental, matched to your budget, commute, and lifestyle.</p>
        </a>
        <a class="service-card" href={config.brokerage.url} target="_blank" rel="noopener">
          <h3>Commercial real estate</h3>
          <p>Support for commercial leasing, purchase, and investment decisions.</p>
        </a>
        <a class="service-card" href={config.brokerage.url} target="_blank" rel="noopener">
          <h3>Off-market properties</h3>
          <p>Access to opportunities before they hit the open market, for buyers and investors.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="band tone-cool">
    <div class="wrap talk-row">
      <div>
        <h2>Let's talk about<br />your next move.</h2>
        <p class="lede">Share what's on your mind. We'll start there.</p>
      </div>
      <a class="btn-meet" href={config.brokerage.url} target="_blank" rel="noopener">Request a call with Dillon &nearr;</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap explore-more">
      <a class="mlink-light" href={url('/about')}>&larr; Back to About Us</a>
      <a class="mlink-light" href={url('/meet-sara')}>Meet Sara &rarr;</a>
    </div>
  </section>
</Base>
<style>
  .band.tone-cool { background: var(--slate); }
  .band.no-top { padding-top: 0; }
  .crumb { color: rgba(255,255,255,.6); font-size: 13px; margin: 0 0 20px; }
  .crumb a { color: rgba(255,255,255,.6); }
  .kicker { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; font-size: 12px; margin: 0 0 12px; }
  h1 { max-width: 20ch; }
  .lede { font-size: 1.15rem; max-width: 50ch; margin: 18px 0 28px; color: rgba(255,255,255,.85); }
  .cta-row { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-bottom: 18px; }
  .btn-meet { display: inline-block; background: var(--blue); color: #fff; font-weight: 700; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-size: 15px; }
  .btn-meet:hover { background: var(--blue-deep); }
  .mlink-dark { color: rgba(255,255,255,.9); font-weight: 600; text-decoration: underline; }
  .mlink-light { color: var(--blue); font-weight: 600; text-decoration: none; }
  .brokerage-line { color: rgba(255,255,255,.6); font-size: 14px; margin: 0 0 32px; }
  .photo-ph { aspect-ratio: 16 / 9; max-width: 560px; background: rgba(255,255,255,.08); border: 1.5px dashed rgba(255,255,255,.25); border-radius: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: rgba(255,255,255,.6); }
  .narrow { max-width: 64ch; }
  .narrow h2 { margin: 0 0 20px; color: var(--navy); }
  .narrow p { font-size: 1.05rem; line-height: 1.7; color: var(--ink); }
  .video-card { margin: 28px 0; }
  .video-link { display: inline-flex; align-items: center; gap: 12px; background: var(--cream); border: 1px solid var(--line); border-radius: 10px; padding: 14px 20px; text-decoration: none; color: var(--navy); }
  .play-btn { width: 36px; height: 36px; border-radius: 50%; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; flex: none; }
  .video-label { font-weight: 600; }
  .narrow h3 { color: var(--navy); margin: 32px 0 6px; font-size: 1.3rem; }
  .eyebrow { color: var(--green, #1e7a43); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  .lede-dark { color: var(--muted); max-width: 54ch; margin: 0 0 28px; }
  .help-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .help-card { display: block; background: var(--slate); border-radius: 10px; overflow: hidden; text-decoration: none; color: #fff; }
  .help-band { padding: 22px; color: rgba(255,255,255,.7); }
  .help-card[data-tone="warm"] .help-band { background: var(--brown); }
  .help-card[data-tone="green"] .help-band { background: #2f4a2c; }
  .help-body { padding: 22px; }
  .help-body h3 { margin: 0 0 10px; font-size: 1.3rem; font-family: var(--serif); color: #fff; }
  .help-body p { margin: 0 0 16px; font-size: 14px; color: rgba(255,255,255,.75); }
  .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 24px; }
  .service-card { display: block; background: var(--cream); border-radius: 10px; padding: 22px; text-decoration: none; color: var(--ink); border-top: 4px solid var(--gold); }
  .service-card h3 { margin: 0 0 8px; font-size: 1.05rem; color: var(--navy); }
  .service-card p { margin: 0; color: var(--muted); font-size: 13.5px; }
  .talk-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .talk-row h2 { margin: 0 0 10px; }
  .explore-more { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 860px) {
    .help-cards, .service-grid { grid-template-columns: 1fr; }
  }
</style>
