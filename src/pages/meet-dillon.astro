---
import Base from '../layouts/Base.astro';
import { config } from '../config';
import { url } from '../lib/util';
---
<Base title="Meet Dillon" description="Dillon Loren is a Houston Realtor with Tradition Realty Group, connecting local discovery with practical real estate guidance.">
  <section class="band tone-cool">
    <div class="wrap hero">
      <span class="initials">DL</span>
      <div>
        <p class="kicker">The connector</p>
        <h1>Dillon Loren</h1>
        <p class="lede">A new place. A next chapter. Dillon helps you connect the dots.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p>A Houston Realtor with {config.brokerage.name}, Dillon brings his interest in neighborhoods, economics, and hospitality to the way he serves people.</p>
      <p>Whether you're exploring an area or planning to buy, sell, rent, or invest, his approach starts with listening, thoughtful preparation, and clear communication. He connects the local discoveries you find on Tradition Local with practical guidance for your next real estate decision.</p>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="eyebrow">Explore with Dillon</p>
      <h2>Neighborhood insights, Houston updates, and real estate guidance.</h2>
      <div class="topic-grid">
        <a class="topic-card" href={url('/cities')}>
          <h3>Neighborhood insights</h3>
          <p>Guides to Houston's neighborhoods, written with a buyer's and seller's perspective.</p>
        </a>
        <a class="topic-card" href={url('/all-articles')}>
          <h3>Houston updates</h3>
          <p>What's new and changing across Greater Houston.</p>
        </a>
        <a class="topic-card" href={config.brokerage.url} target="_blank" rel="noopener">
          <h3>Real estate guidance</h3>
          <p>Personal guidance for buyers, sellers, tenants, landlords, and investors.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap explore-more">
      <a class="mlink-light" href={url('/about')}>&larr; Back to About Us</a>
      <a class="mlink-light" href={url('/meet-sara')}>Meet Sara &rarr;</a>
    </div>
  </section>
</Base>
<style>
  .hero { display: flex; align-items: center; gap: 28px; }
  .initials { flex: none; width: 96px; height: 96px; border-radius: 28px 28px 28px 4px; background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 2.6rem; color: var(--gold-soft); }
  .tone-cool { background: var(--slate); }
  .kicker { color: rgba(255,255,255,.75); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; font-size: 12px; margin: 0 0 8px; }
  .lede { font-size: 1.1rem; max-width: 46ch; margin: 14px 0 0; color: rgba(255,255,255,.9); }
  .narrow { max-width: 68ch; }
  .narrow p { font-size: 1.05rem; line-height: 1.7; }
  .eyebrow { color: var(--green, #1e7a43); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }
  .topic-card { display: block; background: #fff; border-radius: 10px; padding: 22px; text-decoration: none; color: var(--ink); border-top: 4px solid var(--slate); }
  .topic-card h3 { margin: 0 0 8px; font-size: 1.1rem; }
  .topic-card p { margin: 0; color: var(--muted); font-size: 14px; }
  .mlink-light { color: var(--blue); font-weight: 600; text-decoration: none; }
  .explore-more { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 760px) {
    .hero { flex-direction: column; align-items: flex-start; }
    .topic-grid { grid-template-columns: 1fr; }
  }
</style>
