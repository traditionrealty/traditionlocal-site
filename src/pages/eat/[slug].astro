---
import Base from '../../layouts/Base.astro';
import businesses from '../../data/businesses.json';
import areas from '../../data/areas.json';
import posts from '../../data/posts.json';
import { url } from '../../lib/util';

export function getStaticPaths() {
  return businesses.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props;
const area = areas.find((a) => a.slug === b.area);
const brand = b.name.toLowerCase().replace(/[’']/g, '').split(/[\s–-]+/).slice(0, 2).join(' ');
const story = posts.find((p) => p.title.toLowerCase().replace(/[’']/g, '').startsWith(brand));
const place = b.neighborhood || area?.name || b.city;
const ld = { '@context': 'https://schema.org', '@type': 'Review', itemReviewed: { '@type': 'LocalBusiness', name: b.name },
  author: { '@type': 'Person', name: b.reviewAuthor || 'Sara Loren' } };

// This page is Sara's firsthand review, written in her voice. Anything that's really about the
// business itself rather than her visit -- address, phone, hours, categories, other locations --
// now points to the business profile page at /business/[slug] instead of living inline here.
const TIERS: Record<string, { label: string; desc: string; icon: string }> = {
  'try-once': { label: 'Try at Least Once', desc: "Worth experiencing to see if it's your thing.", icon: 'compass' },
  visit: { label: 'Worth a Visit', desc: "A good option when you're nearby or curious.", icon: 'pin' },
  return: { label: 'Would Go Again', desc: "An enjoyable experience we'd return for.", icon: 'refresh' },
  recommend: { label: 'Highly Recommend', desc: "A standout we'd recommend to friends.", icon: 'thumb' },
  favorite: { label: 'Local Favorite', desc: 'A go-to spot that keeps us coming back.', icon: 'heart' },
};
const ICONS: Record<string, string> = {
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6 6-2z"/>',
  pin: '<path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
  thumb: '<path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3zm0 0l4-8a2 2 0 0 1 2 2v4h5a2 2 0 0 1 2 2.2l-1.2 7A2 2 0 0 1 17 20H9a2 2 0 0 1-2-2z"/>',
  heart: '<path d="M12 21s-7-4.6-9.5-8.8C.8 9 2 5.5 5.3 4.6 7.6 4 9.9 5 12 7.5 14.1 5 16.4 4 18.7 4.6 22 5.5 23.2 9 21.5 12.2 19 16.4 12 21 12 21z"/>',
  ribbon: '<circle cx="12" cy="8" r="5"/><path d="M9 12.5L7 21l5-3 5 3-2-8.5"/>',
};
const badge = b.saraPick ? { label: "Sara's Pick", desc: "Sara's personal top choice, deserving a special trip.", icon: 'ribbon' } : (b.rating ? TIERS[b.rating] : null);
// Only a crumb for the neighborhood/area if it's actually different from the city crumb already shown.
const placeCrumb = place && place !== b.city ? place : null;
// A short pull quote from the real review text, the first sentence or two -- but skip it when the
// review itself is this short, so the same couple of sentences don't appear twice back to back.
const pullQuoteCandidate = (b.review || '').split(/(?<=[.!?])\s+/).slice(0, 2).join(' ');
const pullQuote = pullQuoteCandidate.length < (b.review || '').length * 0.75 ? pullQuoteCandidate : null;
---
<Base title={`${b.name} review`} description={b.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <section class="band">
    <div class="wrap">
      <p class="crumb">
        <a href={url('/')}>{b.city}</a> <span aria-hidden="true">&rsaquo;</span>
        {placeCrumb && <><a href={area ? url(`/cities/${area.slug}`) : url('/cities')}>{placeCrumb}</a> <span aria-hidden="true">&rsaquo;</span></>}
        <a href={url(`/eat/${b.slug}`)}>{b.name}</a> <span aria-hidden="true">&rsaquo;</span> Review
      </p>
      <p class="kicker">{b.categories[0]} review</p>
      <h1>{b.name} review</h1>
      <p class="lede">{b.categories[0]} in {placeCrumb ? `${placeCrumb}, ${b.city}` : b.city}</p>
      <p class="lede small">{b.description}</p>
      <div class="byline-row">
        <span class="byline-pill">{b.reviewAuthor || 'Sara Loren'}</span>
        <span class="muted small">Visited {b.reviewYear}</span>
      </div>
      <div class="band-actions">
        <a class="btn ghost-light" href={url(`/business/${b.slug}`)}>View business profile &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {b.heroImage ? (
        <img class="hero-real" src={url(b.heroImage)} alt={b.images?.[0]?.alt || `${b.name} photo`} width="1200" height="525" loading="eager" />
      ) : (
        <div class="hero-photo">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M9 6l1-2h4l1 2"/></svg>
          <span>From our visit &middot; {b.categories[0].toLowerCase()} photograph</span>
        </div>
      )}
      {b.images && b.images.length > 1 && (
        <div class="gallery-strip">
          {b.images.slice(1, 6).map((im) => (
            <img src={url(im.path)} alt={im.alt || `${b.name} photo`} loading="lazy" width="200" height="150" />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <div class="prose">
        {b.closed && <p class="closed-note">This business is no longer operating. The review below is kept for reference.</p>}

        <p class="eyebrow">Sara's review</p>
        <h2 class="review-h2">Our visit and review</h2>
        {badge && (
          <span class="tier-badge">
            <span class="tier-icon" set:html={`<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[badge.icon]}</svg>`}></span>
            {badge.label}
          </span>
        )}
        {pullQuote && <blockquote class="pull-quote">&ldquo;{pullQuote}&rdquo;</blockquote>}

        {b.review && (
          <div class="original-review">
            <h2>Sara's full firsthand review</h2>
            <div class="review-text">{b.review}</div>
          </div>
        )}
        {b.reviewPage?.whatWeTried && (
          <>
            <h2>What we tried</h2>
            <p class="review-text">{b.reviewPage.whatWeTried}</p>
          </>
        )}
        {story && <p>Read the related story: <a href={url(story.path)}>{story.title}</a></p>}

        <h2>The experience</h2>
        {b.reviewPage?.theExperience
          ? <p>{b.reviewPage.theExperience}</p>
          : <p class="ph-text">[What the space, service, and overall visit felt like.]</p>}

        <h2>Who might enjoy it?</h2>
        {b.reviewPage?.whoMightEnjoyIt
          ? <p>{b.reviewPage.whoMightEnjoyIt}</p>
          : <p class="ph-text">[Who this is a good fit for, and when we'd choose it.]</p>}

        <h2>Would we go again?</h2>
        {b.reviewPage?.wouldWeGoAgain
          ? <p>{b.reviewPage.wouldWeGoAgain}</p>
          : <p class="ph-text">[A short, personal conclusion on whether we'd return.]</p>}

        <h2>Your review questions, answered</h2>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary>What did {(b.reviewAuthor || 'Sara').split(' ')[0]} order?</summary>
            {b.reviewPage?.whatWeOrdered
              ? <p>{b.reviewPage.whatWeOrdered}</p>
              : <p class="ph-text">[The specific items ordered, and the price paid on the visit date.]</p>}
          </details>
          {badge && (
            <details class="faq-item">
              <summary>What does {badge.label} mean?</summary>
              <p>{badge.desc} <a href={url('/about-our-reviews')}>See the full rating scale &rarr;</a></p>
            </details>
          )}
          <details class="faq-item">
            <summary>Where can I find current hours and the menu?</summary>
            <p>{b.website
              ? <>The business's own site has the most current information: <a href={b.website} target="_blank" rel="noopener">{b.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>.</>
              : <span class="ph-text">[Link to current hours and menu once available.]</span>}</p>
          </details>
        </div>
      </div>

      <aside>
        <div class="side-card">
          <p class="eyebrow">Meet the reviewer</p>
          <h3 class="side-name">{b.reviewAuthor || 'Sara Loren'}</h3>
          <p class="ph-text">[A short reviewer bio.]</p>
          <a class="side-link" href={url('/about-our-reviews')}>How we review local places &rarr;</a>
          <a class="side-link" href={url('/food')}>More food reviews by {(b.reviewAuthor || 'Sara Loren').split(' ')[0]} &rarr;</a>
        </div>

        <div class="side-card">
          <p class="eyebrow">The business behind this review</p>
          <h3 class="side-name">{b.name}</h3>
          <p class="muted small">{b.categories.join(', ')} &middot; {place}</p>
          <p class="muted small">Find contact details, hours, photos, and more coverage in the business profile.</p>
          <a class="btn gold small" href={url(`/business/${b.slug}`)}>View business profile &rarr;</a>
        </div>

        {area && (
          <div class="side-card tint">
            <p class="eyebrow">Explore beyond the visit</p>
            <h3 class="side-name">{area.name}, Houston</h3>
            <p class="muted small">Discover the neighborhood and nearby subdivisions through the business profile.</p>
            <a class="side-link" href={url(`/cities/${area.slug}`)}>Explore the {area.name} guide &rarr;</a>
          </div>
        )}
      </aside>
    </div>
  </section>

  {area && (
    <section class="section tint">
      <div class="wrap banner">
        <div>
          <p class="eyebrow">Locally &middot; {area.name}</p>
          <h2>More from this neighborhood</h2>
          <p class="muted">Local finds, community updates, and nearby discoveries.</p>
        </div>
        <a class="btn blue" href={url(`/cities/${area.slug}`)}>Explore Locally &rarr;</a>
      </div>
    </section>
  )}
</Base>
<style>
  .crumb { font-size: 13px; color: var(--muted); margin: 0 0 14px; }
  .kicker { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 12px; margin: 0 0 10px; }
  .lede.small { font-size: 1rem; opacity: .9; margin-top: -8px; }
  .byline-row { display: flex; align-items: center; gap: 12px; margin: 16px 0 0; }
  .byline-pill { display: inline-flex; align-items: center; padding: 4px 14px; border-radius: 999px; background: rgba(255,255,255,.15); font-weight: 600; font-size: 14px; }
  .band-actions { margin-top: 20px; }
  .btn.ghost-light { border: 1.5px solid rgba(255,255,255,.6); color: #fff; background: transparent; }
  .btn.ghost-light:hover { background: rgba(255,255,255,.12); }
  .btn.small { padding: 8px 18px; font-size: 14px; }
  .closed-note { background: var(--cream); border: 1px solid var(--line); border-radius: 6px; padding: 10px 14px; margin: 0 0 20px; font-size: 14px; color: var(--muted); }

  .hero-real { display: block; width: 100%; aspect-ratio: 16 / 7; height: auto; object-fit: cover; border-radius: 10px; }
  .gallery-strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
  .gallery-strip img { width: 100%; height: 150px; object-fit: cover; border-radius: 8px; }
  .hero-photo { aspect-ratio: 16 / 7; background: var(--cream); border: 1.5px dashed var(--line); border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: var(--muted); }

  .eyebrow { color: #1e7a43; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 6px; }
  .review-h2 { margin: 0 0 12px; }
  .tier-badge { display: inline-flex; align-items: center; gap: 7px; background: var(--gold-soft); color: var(--brown); font-weight: 700; font-size: 14px; padding: 6px 14px; border-radius: 999px; margin-bottom: 22px; }
  .tier-icon { display: flex; }
  .pull-quote { font-family: var(--serif); font-size: 1.5rem; font-weight: 400; color: var(--navy); border-left: 4px solid var(--gold); padding: 2px 0 2px 22px; margin: 0 0 28px; line-height: 1.4; }
  .review-text { white-space: pre-line; line-height: 1.8; overflow-wrap: anywhere; }
  .original-review { margin: 20px 0 32px; }
  .original-review h2 { margin-bottom: 14px; }

  dd a { color: var(--blue); }
  .layout { display: grid; grid-template-columns: 1fr 320px; gap: 40px; align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--navy); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin: 10px 0 0; }

  aside { display: flex; flex-direction: column; gap: 16px; align-self: start; }
  .side-card { background: var(--cream); padding: 22px; border-radius: 8px; }
  .side-card.tint { background: #fff; border: 1px solid var(--line); }
  .side-name { margin: 0 0 8px; font-size: 1.3rem; }
  .side-link { display: block; font-weight: 600; font-size: 14px; margin-top: 10px; }
  .ph-text { color: var(--muted); font-style: italic; }

  .banner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .banner h2 { margin: 2px 0 6px; }

  @media (max-width: 600px) { .gallery-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
