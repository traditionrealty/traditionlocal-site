---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import posts from '../data/posts.json';
import { url, fmtDate, RATING_LABELS } from '../lib/util';
import newAndNotable from '../data/new-and-notable.json';
import { foodPlaces, closedFoodPlaces, decodeEntities, REGIONS } from '../lib/food';

const places = foodPlaces();
const TIERS = ['try-once', 'visit', 'return', 'recommend', 'favorite'];
const hoodCount: Record<string, number> = {};
const rateCount: Record<string, number> = {};
places.forEach((p) => { hoodCount[p.where] = (hoodCount[p.where] || 0) + 1; if (p.rating) rateCount[p.rating] = (rateCount[p.rating] || 0) + 1; });
const hoods = Object.keys(hoodCount).sort((a, b) => hoodCount[b] - hoodCount[a] || a.localeCompare(b));
const ratedN = places.filter((p) => p.rating).length;
const pickN = places.filter((p) => p.pick).length;
const featured = places.filter((p) => p.rating === 'recommend' && p.review).sort((a, b) => b.year - a.year || Number(b.pick) - Number(a.pick))[0]
  || places.filter((p) => p.rating).sort((a, b) => b.year - a.year)[0];
const stories = (posts as any[]).filter((p) => (p.categories || []).includes('food')).sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 6);
const groupCount = (g: string) => places.filter((p) => p.groups.includes(g as any)).length;

// Cuisines: counts by cuisine and by region (only cuisines that at least one place uses are shown).
const cuCount: Record<string, number> = {};
const regCount: Record<string, number> = {};
places.forEach((p) => { p.cuisines.forEach((c) => { cuCount[c] = (cuCount[c] || 0) + 1; }); p.regions.forEach((r) => { regCount[r] = (regCount[r] || 0) + 1; }); });
const regions = REGIONS.filter((g) => regCount[g.r]).map((g) => ({
  r: g.r, n: regCount[g.r],
  cuisines: g.c.filter((c) => cuCount[c]).sort((a, b) => cuCount[b] - cuCount[a] || a.localeCompare(b)),
}));
const cuTotal = new Set(regions.filter((g) => g.r !== 'Dietary & style').flatMap((g) => g.cuisines)).size;
const withCuisine = places.filter((p) => p.cuisines.length).length;

// Neighborhood list, A to Z, with each place A to Z.
const byHood: Record<string, typeof places> = {};
places.forEach((p) => { (byHood[p.where] = byHood[p.where] || []).push(p); });
const hoodNames = Object.keys(byHood).sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
hoodNames.forEach((h) => byHood[h].sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase())));

// Openings come from the new and notable list. Closings are reviews marked closed, plus closed profiles without a review post.
const openings = (newAndNotable as any[]).filter((o) => !o.placeholder);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const reviewedOn = (d: string) => 'Reviewed ' + MON[Number(d.slice(5, 7)) - 1] + ' ' + d.slice(0, 4);
const NOT_FOOD = /Salon|Event|Dental|Spa\b|Nail|Hair|Threading|Fitness|Clinic/i;
const closedPosts = (posts as any[]).filter((p) => p.closed).sort((a, b) => (a.date < b.date ? 1 : -1)).map((p) => {
  const parts = decodeEntities(String(p.title)).replace(/\s+/g, ' ').trim().replace(/^Sara[’']s Review:\s*/, '').split(/\s[–—]\s/);
  return { name: parts[0].trim(), tag: (parts[1] || '').slice(0, 90), when: reviewedOn(p.date), href: url(p.path), permanent: String(p.path).includes('permanently') };
}).filter((c) => !NOT_FOOD.test(c.name) && !NOT_FOOD.test(c.tag));
const seen = new Set(closedPosts.map((c) => c.name.toLowerCase().replace(/\W/g, '')));
const closedProfiles = closedFoodPlaces().filter((c) => !seen.has(c.name.toLowerCase().replace(/\W/g, ''))).map((c) => ({ name: c.name, tag: c.cats.join(', '), when: 'Reviewed ' + c.year, href: url('/eat/' + c.slug), permanent: false }));
const closings = [...closedPosts, ...closedProfiles];
const SHOW = 12;

const SV = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const icon = (name: string, s: number) => {
  const paths: Record<string, string> = {
    coffee: '<path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h2a2 2 0 0 1 0 4h-2M8 3v2M12 3v2"/>',
    restaurants: '<circle cx="12" cy="13" r="6"/><circle cx="12" cy="13" r="2.5"/><path d="M3 4v6M5 4v6M3 7h2M4 10v9M20 4c-1.5 1-2.5 3-2.5 5.5S18.5 12 20 12v7"/>',
    sweets: '<path d="M4 18l2-8h12l2 8z"/><path d="M6 10a6 5 0 0 1 12 0"/><path d="M12 3v2"/>',
    markets: '<path d="M5 9h14l-1 11H6z"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/>',
  };
  return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" ' + SV + '>' + (paths[name] || paths.restaurants) + '</svg>';
};
const BOOK = '<svg width="16" height="18" viewBox="0 0 16 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 2h10v14l-5-3.5L3 16z"/></svg>';
const collections = [
  { g: 'coffee', title: 'Hug in a mug', text: 'Find your next place to linger.' },
  { g: 'restaurants', title: 'Make time for a meal', text: 'Local stops for a relaxed outing.' },
  { g: 'sweets', title: 'Something sweet', text: 'A little treat worth the stop.' },
];
const tabs = [['all', 'All food & drink'], ['coffee', 'Coffee & cafés'], ['restaurants', 'Restaurants'], ['sweets', 'Bakeries & sweets'], ['markets', 'Markets & groceries']];
const bar = [['reviews', 'Reviews'], ['collections', 'Collections'], ['cuisines', 'Cuisines'], ['find', 'Find a place'], ['openings', 'Openings'], ['videos', 'Videos'], ['hoods', 'Neighborhoods']];
---
<Base title="Food" description="Houston restaurants, coffee shops, bakeries, and dessert spots reviewed by Sara Loren and the Tradition Local team.">
  <section class="band fd-band">
    <div class="wrap">
      <p class="fd-crumb"><a href={url('/')}>Home</a> <span aria-hidden="true">&rsaquo;</span> Food</p>
      <span class="fd-tag">Food &middot; Greater Houston</span>
      <h1>Eat like a local</h1>
      <p class="fd-lead">Your next favorite is closer than you think. Discover coffee corners, memorable meals, and the local places worth making time for, with Dillon and Sara.</p>
      <div class="fd-stats">
        <div><b>{places.length}</b><span>Places to try</span></div>
        <div><b>{ratedN}</b><span>Places we have rated</span></div>
        <div><b>{pickN}</b><span>Sara's picks</span></div>
        <div><b>{hoods.length}</b><span>Neighborhoods</span></div>
        <div><b>{cuTotal}</b><span>Cuisines and styles</span></div>
      </div>
      <div class="fd-btns"><a class="fd-pill gold" href="#find">Find something good</a><a class="fd-pill white" href="#reviews">Explore our reviews</a></div>
    </div>
  </section>
  <div class="fd-bar">
    <div class="wrap fd-barin">
      <nav class="fd-barlist" aria-label="Sections on this page">{bar.map((b, i) => <a href={'#' + b[0]} data-sec={b[0]} class={i === 0 ? 'on' : ''}>{b[1]}</a>)}</nav>
      <span class="fd-best">Best for: Coffee dates, family meals, and sweet stops</span>
    </div>
  </div>

  <section class="fd-blk wrap" id="reviews">
    <div class="fd-sechead"><div><h2>Reviews</h2></div><a href={url('/about-our-reviews')}>How we review &rarr;</a></div>
    <p class="fd-note">Every place is rated by Sara or Dillon after a visit. Pick a rating to see those places.</p>
    <div class="fd-rate">
      {TIERS.map((t) => (
        <button class="fd-tier" type="button" data-tier={t} disabled={!rateCount[t]}>
          <span class="lab"><i class={'fd-dot ' + t}></i>{RATING_LABELS[t]}</span>
          <b>{rateCount[t] || 0}</b>
          <span class="s">{rateCount[t] ? 'places rated' : 'none yet'}</span>
        </button>
      ))}
    </div>
    {featured && (
      <div class="fd-feat">
        <div class="art" aria-hidden="true" set:html={icon(featured.prim, 72)}></div>
        <div class="body">
          <span class="fd-rb" style="align-self:flex-start"><i class={'fd-dot ' + featured.rating}></i>{RATING_LABELS[featured.rating]} &middot; Reviewed {featured.year}</span>
          <h3>{featured.name}</h3>
          {featured.review && <p class="quote">&ldquo;{featured.review}&rdquo;</p>}
          <div class="meta">{featured.author} &middot; {featured.where === featured.city ? featured.city : featured.where + ', ' + featured.city} &middot; {featured.cats.join(', ')}</div>
          <div><a class="fd-pill gold" href={url('/eat/' + featured.slug)}>Read the full review</a> <a class="fd-pill line" href={url('/eat/' + featured.slug)}>View profile</a></div>
        </div>
      </div>
    )}
    <div class="fd-stories">
      <h3>Latest reviews and stories</h3>
      {stories.map((p) => <div class="fd-srow"><b>{fmtDate(p.date)}</b><a href={url(p.path)}>{String(p.title).replace(/\s+/g, ' ').trim()}</a></div>)}
    </div>
    <div class="fd-nextgrid">
      <a class="fd-next b" href={url('/about-our-reviews')}><h3>Best of 2026</h3><p>Our ranked guides by city and craving.</p></a>
      <a class="fd-next g" href={site.social.youtube} target="_blank" rel="noopener"><h3>Watch the reviews</h3><p>See the food before you go.</p></a>
      <a class="fd-next c" href={url('/all-articles/categories/food')}><h3>All food stories</h3><p>Every review and guide in one place.</p></a>
    </div>
  </section>

  <section class="fd-blk wrap" id="collections">
    <div class="fd-sechead"><div><h2>A craving. A collection.</h2></div><span class="fd-badge">Curated by Tradition Local</span></div>
    <div class="fd-coll">
      {collections.map((c) => (
        <button class="fd-ccard" type="button" data-coll={c.g}>
          <span class="ic" set:html={icon(c.g, 34)}></span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
          <span class="go">{groupCount(c.g)} places &rarr;</span>
        </button>
      ))}
    </div>
  </section>

  <section class="fd-blk wrap" id="cuisines">
    <div class="fd-sechead"><div><h2>Eat around the world.</h2></div><span class="fd-badge">{cuTotal} cuisines and styles, {withCuisine} places</span></div>
    <p class="fd-note">Pick a region to see every place that serves it, or choose a single cuisine.</p>
    <div class="fd-regions">
      {regions.map((g) => (
        <div class="fd-reg">
          <button class="rh" type="button" data-region={g.r}><h3>{g.r}</h3><span class="rn">{g.n} places &rarr;</span></button>
          <div class="rc">{g.cuisines.slice(0, 6).map((c) => <button class="fd-cuchip" type="button" data-cuisine={c}>{c}<small>{cuCount[c]}</small></button>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="fd-blk wrap" id="find">
    <span id="trending"></span>
    <div class="fd-sechead"><div><h2>What sounds good?</h2></div><span class="fd-badge">Every place links to its profile</span></div>
    <div class="fd-tabs" id="fd-tabs" role="group" aria-label="Browse by type">
      {tabs.map((t, i) => <button class="fd-tab" type="button" data-g={t[0]} aria-pressed={i === 0 ? 'true' : 'false'}>{t[1]}</button>)}
      <button class="fd-tab saved" type="button" id="fd-savedBtn" aria-pressed="false">Saved (0)</button>
    </div>
    <div class="fd-searchrow"><label><span class="fd-sr">Search places</span><input type="search" id="fd-q" placeholder="Search by name, dish, or neighborhood" /></label></div>
    <div class="fd-filters">
      <label>Neighborhood
        <select id="fd-where"><option value="">All areas</option>{hoods.map((h) => <option value={h}>{h} ({hoodCount[h]})</option>)}</select>
      </label>
      <label>Cuisine
        <select id="fd-cuisine"><option value="">Any cuisine</option>{regions.map((g) => (
          <optgroup label={g.r + ' (' + g.n + ')'}>
            <option value={'region:' + g.r}>All {g.r}</option>
            {g.cuisines.map((c) => <option value={c}>{c} ({cuCount[c]})</option>)}
          </optgroup>
        ))}</select>
      </label>
      <label>Rating
        <select id="fd-rate"><option value="">Any rating</option>{TIERS.filter((t) => rateCount[t]).map((t) => <option value={t}>{RATING_LABELS[t]} ({rateCount[t]})</option>)}</select>
      </label>
      <label class="picks"><input type="checkbox" id="fd-pick" /> Sara's picks only</label>
    </div>
    <p class="fd-count" id="fd-count" aria-live="polite">{places.length} places</p>
    <div class="fd-grid" id="fd-grid">
      {places.map((p, i) => (
        <article class="fd-biz" hidden={i >= SHOW} data-slug={p.slug} data-g={p.groups.join(' ')} data-where={p.where} data-rate={p.rating} data-cu={p.cuisines.join('|')} data-rg={p.regions.join('|')} data-pick={p.pick ? '1' : '0'}
          data-text={(p.name + ' ' + p.desc + ' ' + p.cats.join(' ') + ' ' + p.where + ' ' + p.city).toLowerCase()}>
          <div class="top">
            <span class="ic" aria-hidden="true" set:html={icon(p.prim, 24)}></span>
            {p.pick ? <span class="fd-rb pick">Sara's Pick</span> : p.rating ? <span class="fd-rb"><i class={'fd-dot ' + p.rating}></i>{RATING_LABELS[p.rating]}</span> : <span></span>}
          </div>
          <h3><a href={url('/eat/' + p.slug)}>{p.name}</a></h3>
          <div class="where">{p.where === p.city ? p.city : p.where + ', ' + p.city}</div>
          <div class="cats">{p.cats.join(', ')}</div>
          <p class="desc">{p.desc}</p>
          <div class="row">
            <a class="fd-pill line sm" href={url('/eat/' + p.slug)}>View profile &rarr;</a>
            <button class="fd-save" type="button" data-save={p.slug} aria-pressed="false" aria-label={'Save place: ' + p.name} set:html={BOOK}></button>
          </div>
        </article>
      ))}
    </div>
    <div class="fd-empty" id="fd-empty" hidden>No places match those filters. Try clearing the search or picking All.</div>
    <div class="fd-more"><button class="fd-pill line" type="button" id="fd-more" hidden={places.length <= SHOW}>Show more places</button></div>
    <noscript><style>.fd-biz[hidden] { display: flex; }</style></noscript>
  </section>

  <section class="fd-blk wrap" id="openings">
    <div class="fd-sechead"><div><h2>Openings and closings.</h2></div><a href="mailto:traditionlocal@gmail.com?subject=Opening%20or%20closing%20tip">Tell us about one &rarr;</a></div>
    <p class="fd-note">New places worth a visit, and the places we have reviewed that have since closed.</p>
    <div class="fd-oc">
      <div class="fd-ocol">
        <h3><i class="fd-dotnew"></i>Now open</h3>
        {openings.length ? openings.map((o: any) => (
          <div class="fd-orow"><h4>{o.name}<span class="fd-tagnew">New</span></h4><div class="m">{o.category} &middot; {o.area}</div></div>
        )) : <p class="fd-note">No new openings logged yet.</p>}
      </div>
      <div class="fd-ocol">
        <h3><i class="fd-dotclosed"></i>Recently closed</h3>
        {closings.map((c, i) => (
          <div class="fd-orow" hidden={i >= 6} data-closed={i >= 6 ? '1' : '0'}><h4><a href={c.href}>{c.name}</a><span class="fd-tagclosed">{c.permanent ? 'Permanently closed' : 'Closed'}</span></h4><div class="m">{c.when}{c.tag ? ' · ' + c.tag : ''}</div></div>
        ))}
        <div class="fd-more" style="justify-content:flex-start;padding:10px 0 0"><button class="fd-pill line sm" type="button" id="fd-clsmore" hidden={closings.length <= 6}>Show all {closings.length} closed places</button></div>
      </div>
    </div>
  </section>

  <section class="fd-blk wrap" id="videos">
    <div class="fd-vid">
      <div><p class="eb">Sara visits</p><h2>Come along for the first bite.</h2><p>Discover the atmosphere, the flavors, and the people behind a place through Sara's visits and videos.</p></div>
      <div class="fd-vbox"><q>A local visit. A personal perspective.</q><a class="fd-pill gold" href={site.social.youtube} target="_blank" rel="noopener">Watch on YouTube</a></div>
    </div>
  </section>

  <section class="fd-blk padb wrap" id="hoods">
    <div class="fd-sechead"><div><h2>Eat by neighborhood</h2></div><span class="fd-hcount">{places.length} places in {hoodNames.length} neighborhoods</span></div>
    <p class="fd-hdesc">Every place we have reviewed, grouped by neighborhood. Find a good meal, then explore what is nearby.</p>
    {hoodNames.map((h) => (
      <div class="fd-hgroup">
        <h3>{h}<small>{byHood[h].length}</small></h3>
        <ul class="fd-hlinks">{byHood[h].map((p) => <li><a href={url('/eat/' + p.slug)}>{p.name}</a></li>)}</ul>
      </div>
    ))}
  </section>
</Base>

<script is:inline>
  (function () {
    var cards = [].slice.call(document.querySelectorAll('.fd-biz'));
    if (!cards.length) return;
    var $ = function (id) { return document.getElementById(id); };
    var SHOW = 12;
    var saved = [];
    try { saved = JSON.parse(localStorage.getItem('tl-food-saved') || '[]'); } catch (e) {}
    var st = { group: 'all', where: '', rate: '', cuisine: '', region: '', pick: false, q: '', limit: SHOW, savedOnly: false };
    var LABEL = { 'try-once': 'Try at Least Once', visit: 'Worth a Visit', 'return': 'Would Go Again', recommend: 'Highly Recommend', favorite: 'Local Favorite' };
    var toastEl = null;
    function toast(m) {
      if (!toastEl) { toastEl = document.createElement('div'); toastEl.className = 'fd-toast'; toastEl.setAttribute('role', 'status'); document.body.appendChild(toastEl); }
      toastEl.textContent = m; toastEl.classList.add('on'); clearTimeout(toast.h); toast.h = setTimeout(function () { toastEl.classList.remove('on'); }, 1800);
    }
    function inGroup(c, g) { return g === 'all' || (' ' + c.getAttribute('data-g') + ' ').indexOf(' ' + g + ' ') > -1; }
    function render() {
      var q = st.q.trim().toLowerCase(), n = 0, shown = 0;
      cards.forEach(function (c) {
        var ok = inGroup(c, st.group)
          && (!st.where || c.getAttribute('data-where') === st.where)
          && (!st.rate || c.getAttribute('data-rate') === st.rate)
          && (!st.cuisine || ('|' + c.getAttribute('data-cu') + '|').indexOf('|' + st.cuisine + '|') > -1)
          && (!st.region || ('|' + c.getAttribute('data-rg') + '|').indexOf('|' + st.region + '|') > -1)
          && (!st.pick || c.getAttribute('data-pick') === '1')
          && (!st.savedOnly || saved.indexOf(c.getAttribute('data-slug')) > -1)
          && (!q || c.getAttribute('data-text').indexOf(q) > -1);
        if (ok) { n++; if (shown < st.limit) { shown++; c.hidden = false; } else { c.hidden = true; } } else { c.hidden = true; }
        var b = c.querySelector('[data-save]'); var on = saved.indexOf(c.getAttribute('data-slug')) > -1;
        b.setAttribute('aria-pressed', String(on));
      });
      $('fd-count').textContent = n + ' place' + (n === 1 ? '' : 's');
      $('fd-empty').hidden = n > 0;
      $('fd-more').hidden = n <= st.limit;
      document.querySelectorAll('#fd-tabs [data-g]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-g') === st.group)); });
      var sb = $('fd-savedBtn'); sb.textContent = 'Saved (' + saved.length + ')'; sb.setAttribute('aria-pressed', String(st.savedOnly));
    }
    function fresh(patch) {
      st.group = 'all'; st.where = ''; st.rate = ''; st.cuisine = ''; st.region = ''; st.pick = false; st.q = ''; st.savedOnly = false; st.limit = SHOW;
      for (var k in patch) st[k] = patch[k];
      $('fd-where').value = st.where; $('fd-rate').value = st.rate; $('fd-cuisine').value = st.cuisine ? st.cuisine : (st.region ? 'region:' + st.region : ''); $('fd-pick').checked = st.pick; $('fd-q').value = st.q;
    }
    function jump(id) { var el = $(id); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    document.addEventListener('click', function (e) {
      var c = e.target.closest('[data-coll]');
      if (c) { fresh({ group: c.getAttribute('data-coll') }); render(); jump('find'); return; }
      var cc = e.target.closest('[data-cuisine]');
      if (cc) { fresh({ cuisine: cc.getAttribute('data-cuisine') }); render(); jump('find'); toast('Showing ' + st.cuisine); return; }
      var rg = e.target.closest('[data-region]');
      if (rg) { fresh({ region: rg.getAttribute('data-region') }); render(); jump('find'); toast('Showing ' + st.region); return; }
      var h = e.target.closest('[data-hood]');
      if (h) { fresh({ where: h.getAttribute('data-hood') }); render(); jump('find'); toast('Showing ' + st.where); return; }
      var t = e.target.closest('[data-tier]');
      if (t && !t.disabled) { fresh({ rate: t.getAttribute('data-tier') }); render(); jump('find'); toast('Showing ' + LABEL[st.rate]); return; }
      var g = e.target.closest('#fd-tabs [data-g]');
      if (g) { st.group = g.getAttribute('data-g'); st.savedOnly = false; st.limit = SHOW; render(); return; }
      var sv = e.target.closest('[data-save]');
      if (sv) {
        var slug = sv.getAttribute('data-save'), p = saved.indexOf(slug);
        if (p > -1) { saved.splice(p, 1); toast('Removed from saved'); } else { saved.push(slug); toast('Saved'); }
        try { localStorage.setItem('tl-food-saved', JSON.stringify(saved)); } catch (err) {}
        render(); return;
      }
      if (e.target.closest('#fd-savedBtn')) { st.savedOnly = !st.savedOnly; st.limit = SHOW; render(); return; }
    });
    $('fd-where').addEventListener('change', function () { st.where = this.value; st.limit = SHOW; render(); });
    $('fd-rate').addEventListener('change', function () { st.rate = this.value; st.limit = SHOW; render(); });
    $('fd-cuisine').addEventListener('change', function () { var v = this.value; st.cuisine = v.indexOf('region:') === 0 ? '' : v; st.region = v.indexOf('region:') === 0 ? v.slice(7) : ''; st.limit = SHOW; render(); });
    var cm = $('fd-clsmore');
    if (cm) cm.addEventListener('click', function () { document.querySelectorAll('[data-closed="1"]').forEach(function (r) { r.hidden = false; }); cm.hidden = true; });
    $('fd-pick').addEventListener('change', function () { st.pick = this.checked; st.limit = SHOW; render(); });
    $('fd-q').addEventListener('input', function () { st.q = this.value; st.limit = SHOW; render(); });
    $('fd-more').addEventListener('click', function () { st.limit += SHOW; render(); });
    // keep the section bar in sync while scrolling
    var links = [].slice.call(document.querySelectorAll('.fd-bar a[data-sec]'));
    window.addEventListener('scroll', function () {
      var cur = links[0].getAttribute('data-sec');
