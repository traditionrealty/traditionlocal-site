---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import FoodFeature from '../components/FoodFeature.astro';
import businesses from '../data/businesses.json';
import posts from '../data/posts.json';
import { url } from '../lib/util';

const counts: Record<string, number> = {};
businesses.forEach((b) => b.categories.forEach((c) => (counts[c] = (counts[c] || 0) + 1)));
const topCats = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 14).map(([c]) => c);
const places = [...new Set(businesses.map((b) => b.neighborhood || b.city))].sort();
const foodPosts = posts.filter((p) => p.categories.includes('food')).slice(0, 3);
---
<Base title="Food" description="Houston restaurants, coffee shops, bakeries, and dessert spots reviewed by Sara Loren and the Tradition Local team.">
  <section class="band">
    <div class="wrap">
      <p class="kicker">Food</p>
      <h1>Eat like a local</h1>
      <p class="lede">Every spot we have reviewed, rated simply: Worth a Stop, Worth the Drive, or Worth the Trip.</p>
    </div>
  </section>

  <section class="section" id="trending">
    <div class="wrap">
      <h2 class="filters-head">Where to eat</h2>
      <div class="filters" id="filters">
        <label class="search"><span class="sr">Search places</span>
          <input type="search" id="q" placeholder="Search by name, dish, or neighborhood" />
        </label>
        <label><span class="sr">Area</span>
          <select id="where"><option value="">All areas</option>{places.map((p) => <option value={p}>{p}</option>)}</select>
        </label>
        <label class="toggle"><input type="checkbox" id="picks" /> Sara's picks only</label>
      </div>
      <div class="chips" role="group" aria-label="Categories">
        <button class="chip" data-cat="" data-trending="1" aria-pressed="true">Trending</button>
        <button class="chip" data-cat="" aria-pressed="false">All</button>
        {topCats.map((c) => <button class="chip" data-cat={c} aria-pressed="false">{c}</button>)}
      </div>
      <div class="rating-tags" role="group" aria-label="Filter by rating">
        <button class="rchip" data-rating="" aria-pressed="true">All ratings</button>
        <button class="rchip" data-rating="stop" aria-pressed="false"><span class="dot stop"></span>Worth a Stop</button>
        <button class="rchip" data-rating="drive" aria-pressed="false"><span class="dot drive"></span>Worth the Drive</button>
        <button class="rchip" data-rating="trip" aria-pressed="false"><span class="dot trip"></span>Worth the Trip</button>
      </div>
      <p class="muted" id="count" aria-live="polite">{businesses.length} places</p>

      <ul class="biz-list" id="list">
        {businesses.map((b) => (
          <li data-name={`${b.name} ${b.description} ${b.categories.join(' ')} ${b.neighborhood || ''} ${b.city}`.toLowerCase()}
              data-cats={b.categories.join('|')} data-where={b.neighborhood || b.city} data-pick={b.saraPick ? '1' : '0'} data-rating={b.rating || ''} data-year={b.reviewYear || 0}>
            <a href={url(`/eat/${b.slug}`)}>
              {(b.saraPick || b.closed) && <span class="top">{b.saraPick && <span class="badge">Sara's pick</span>}{b.closed && <span class="badge closed-badge">Closed</span>}</span>}
              <strong>{b.name}</strong>
              <span class="where">{b.neighborhood ? `${b.neighborhood}, ${b.city}` : b.city}</span>
              <span class="cats">{b.categories.slice(0, 3).join(', ')}</span>
              <span class="desc">{b.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p id="empty" hidden>No places match those filters. Try clearing the search or picking All.</p>
    </div>
  </section>

  <FoodFeature />

  {foodPosts.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <div class="section-head"><h2>Latest food stories</h2><a href={url('/all-articles/categories/food')}>All food articles</a></div>
        <div class="grid">{foodPosts.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const where = document.getElementById('where') as HTMLSelectElement;
  const picks = document.getElementById('picks') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const rchips = [...document.querySelectorAll<HTMLButtonElement>('[data-rating]')];
  const list = document.getElementById('list')!;
  const originalOrder = [...document.querySelectorAll<HTMLLIElement>('#list li')];
  const items = originalOrder;
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  let cat = '';
  let rating = '';
  let trending = true;
  function apply() {
    const term = q.value.trim().toLowerCase();
    const order = trending
      ? [...items].sort((a, b) => Number(b.dataset.year) - Number(a.dataset.year))
      : originalOrder;
    let n = 0;
    for (const li of order) {
      const ok = (!term || li.dataset.name!.includes(term))
        && (!cat || li.dataset.cats!.split('|').includes(cat))
        && (!rating || li.dataset.rating === rating)
        && (!where.value || li.dataset.where === where.value)
        && (!picks.checked || li.dataset.pick === '1')
        && (!trending || n < 12);
      li.hidden = !ok; if (ok) n++;
    }
    count.textContent = `${n} ${n === 1 ? 'place' : 'places'}`;
    empty.hidden = n > 0;
    order.forEach((li) => list.appendChild(li));
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    cat = c.dataset.cat || '';
    trending = c.dataset.trending === '1';
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  rchips.forEach((c) => c.addEventListener('click', () => {
    rating = c.dataset.rating || '';
    rchips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  [q, where, picks].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>

<style>
  .filters-head { margin: 0 0 16px; }
  .filters { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
  .filters input[type=search], .filters select { padding: 12px 16px; border: 1.5px solid var(--line); border-radius: 999px; font-size: 16px; background: #fff; }
  .search { flex: 1 1 320px; } .search input { width: 100%; }
  .toggle { display: flex; gap: 8px; align-items: center; font-size: 15px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .rating-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
  .rchip { display: flex; align-items: center; gap: 7px; padding: 8px 16px; border: 1.5px solid var(--line); border-radius: 999px; background: #fff; font-size: 14px; font-weight: 600; color: var(--navy); cursor: pointer; }
  .rchip[aria-pressed="true"] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .rchip[aria-pressed="true"] .dot { outline: 2px solid rgba(255,255,255,.6); outline-offset: 1px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .dot.stop { background: #1e7a43; }
  .dot.drive { background: #e7bc52; }
  .dot.trip { background: #004aad; }
  #count { margin: 18px 0; }
  .biz-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0; border-top: 1px solid var(--line); }
  .biz-list li[hidden] { display: none; }
  .biz-list a { display: flex; flex-direction: column; gap: 4px; padding: 20px 18px; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--line); height: 100%; }
  .biz-list a:hover { background: var(--cream); }
  .top { display: flex; justify-content: flex-end; gap: 6px; margin-bottom: 4px; }
  .closed-badge { background: #fff; color: var(--brown); border: 1px solid var(--brown); }
  .biz-list strong { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.3rem; color: var(--blue); }
  .where { font-size: 14px; color: var(--navy); font-weight: 600; }
  .cats { font-size: 13px; color: var(--brown); }
  .desc { font-size: 15px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4px; }
</style>
