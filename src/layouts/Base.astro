---
import site from '../data/site.json';
import events from '../data/events.json';
import { url, img, fmtDate } from '../lib/util';
import { config } from '../config';
import AccountMenu from '../components/AccountMenu.astro';

interface Props { title?: string; description?: string | null; image?: string | null; type?: string; }
const { title, description, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | Tradition Local` : site.title;
const desc = description || site.description;
// Search engines should credit the real domain, not the github.io preview copy.
const PRODUCTION = 'https://www.traditionlocal.com';
const isPreview = !String(Astro.site).includes('traditionlocal.com');
const canonical = new URL((Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/').replace(/(.)\/$/, '$1'), PRODUCTION).href;
const membersOn = Boolean(config.supabaseUrl && config.supabaseAnonKey);
const today = new Date().toISOString().slice(0, 10);
const next = events.find((e) => e.date && e.date >= today);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  {
    label: 'Food', href: '/food', match: ['/food', '/eat'],
    sub: [
      { label: 'All Places', href: '/food' },
      { label: 'Trending', href: '/food#trending' },
    ],
  },
  {
    label: 'Neighborhoods', href: '/cities', match: ['/cities', '/copy-of-neighborhoods-1', '/traditionneighborhoods', '/subdivisions', '/make-it-home', '/new-builds'],
    sub: [
      { label: 'Around Town', href: '/cities' },
      { label: 'Compare Neighborhoods', href: '/make-it-home' },
      { label: 'New Builds', href: '/new-builds' },
    ],
  },
  {
    label: 'Things To Do', href: '/living', match: ['/living', '/event-details'],
    sub: [
      { label: 'This Weekend', href: '/living#weekend' },
      { label: 'Upcoming Events', href: '/living#events' },
    ],
  },
];
const moreNav = [
  { label: 'Stories', href: '/all-articles', match: ['/all-articles', '/post'] },
  { label: 'Reviews', href: '/about-our-reviews', match: ['/about-our-reviews'] },
  { label: 'Newsletters', href: '/newsletters', match: ['/newsletters'] },
  ...(membersOn ? [{ label: 'Local Directory', href: '/local-directory', match: ['/local-directory'] }] : []),
  { label: 'About Us', href: '/about', match: ['/about'] },
];
const moreActive = moreNav.some((n) => n.match.some((m) => path.startsWith(m)));
// Site search (Pagefind). Account, sign in and utility pages stay out of the index; every other page is
// tagged with a type so results can be filtered.
const searchable = !/^\/(404|sign-in|join|reset-password|members|search)(\/|$)/.test(path);
const searchType = /^\/(food|eat)(\/|$)/.test(path) ? 'Food'
  : /^\/(cities|copy-of-neighborhoods-1|traditionneighborhoods|subdivisions|make-it-home|new-builds)(\/|$)/.test(path) ? 'Neighborhoods'
  : /^\/(living|event-details)(\/|$)/.test(path) ? 'Things To Do'
  : /^\/(post|all-articles)(\/|$)/.test(path) ? 'Stories'
  : 'Pages';
const popularSearches = ['coffee', 'brunch', 'Sugar Land', 'new builds', 'events'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {isPreview && <meta name="robots" content="noindex, follow" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={img(image)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href={img(site.logo)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {next && (
    <div class="eventbar">
      <div class="wrap">
        <strong>Upcoming events</strong>
        <span class="eventbar-title">{next.title.replace(/\s*\[.*?\]\s*/g, ' ').trim()}, {fmtDate(next.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span>
        <a class="rsvp" href={url(next.path)}>RSVP</a>
        <a class="all" href={url('/living')}>See all events</a>
      </div>
    </div>
  )}
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={url('/')}>
        <img src={img(site.logo)} alt="" width="56" height="56" />
        <span>Tradition Local</span>
      </a>
      <nav aria-label="Main">
        {nav.map((n) => {
          const active = n.match.some((m) => path.startsWith(m));
          return (
            <div class="nav-more" data-nav-more>
              <a href={url(n.href)} class="nav-more-link" aria-current={active ? 'page' : undefined}>{n.label}</a>
              <button type="button" class="nav-chevron-btn" aria-haspopup="true" aria-expanded="false" aria-label={`${n.label} submenu`}>
                <svg aria-hidden="true" viewBox="0 0 12 8" width="10" height="7"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
              </button>
              <div class="nav-more-menu" hidden>
                {n.sub.map((s) => <a href={url(s.href)}>{s.label}</a>)}
              </div>
            </div>
          );
        })}
        <div class="nav-more" data-nav-more>
          <button type="button" class="nav-more-btn" aria-haspopup="true" aria-expanded="false" aria-current={moreActive ? 'page' : undefined}>
            More
            <svg aria-hidden="true" viewBox="0 0 12 8" width="10" height="7"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </button>
          <div class="nav-more-menu" hidden>
            {moreNav.map((n) => (
              <a href={url(n.href)} aria-current={n.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>{n.label}</a>
            ))}
          </div>
        </div>
      </nav>
      <div class="site-search" data-site-search data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
        <button type="button" class="search-btn" aria-label="Search" aria-expanded="false" aria-controls="search-panel">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" /></svg>
        </button>
        <div class="search-panel" id="search-panel" hidden>
          <div class="search-panel-inner">
            <form action={url('/search')} method="get" role="search">
              <label class="sr-only" for="hs-q">Search Tradition Local</label>
              <input id="hs-q" name="q" type="search" autocomplete="off" placeholder="Search places, neighborhoods, events, stories" />
            </form>
            <ul class="search-sugg" id="hs-sugg" hidden></ul>
            <p class="search-pop"><span>Popular searches</span>{popularSearches.map((t) => <a href={url('/search') + '?q=' + encodeURIComponent(t)}>{t}</a>)}</p>
          </div>
        </div>
      </div>
      {membersOn && <AccountMenu />}
    </div>
  </header>
  <script>
    // Dropdowns in the main nav. Each opens on hover via CSS; this wires up click and keyboard
    // access too, for touch devices and anyone not using a mouse.
    document.querySelectorAll<HTMLElement>('[data-nav-more]').forEach((root) => {
      const btn = root.querySelector<HTMLButtonElement>('.nav-more-btn, .nav-chevron-btn')!;
      const menu = root.querySelector<HTMLElement>('.nav-more-menu')!;
      const setOpen = (open: boolean) => { menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
      btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(menu.hidden); });
      document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) setOpen(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
    });
  </script>
  <script is:inline>
    // Header search: opens a panel, suggests matches from the Pagefind index as you type.
    window.tlPagefind = window.tlPagefind || (function () {
      var p;
      return function () {
        if (p) return p;
        var root = document.querySelector('[data-site-search]');
        var base = (root && root.getAttribute('data-base')) || '';
        p = import(base + '/pagefind/pagefind.js').then(function (pf) {
          return pf.options({ baseUrl: base + '/' }).then(function () { return pf; });
        }).catch(function () { return null; });
        return p;
      };
    })();
    (function () {
      var root = document.querySelector('[data-site-search]');
      if (!root) return;
      var btn = root.querySelector('.search-btn');
      var panel = root.querySelector('.search-panel');
      var input = root.querySelector('input[name="q"]');
      var list = root.querySelector('#hs-sugg');
      var timer;
      function setOpen(open) {
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (open) { input.focus(); window.tlPagefind(); }
      }
      btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(panel.hidden); });
      document.addEventListener('click', function (e) { if (!root.contains(e.target)) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); } });
      function render(items) {
        list.textContent = '';
        items.forEach(function (d) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = d.url;
          var t = document.createElement('span');
          t.className = 'sugg-type';
          t.textContent = (d.filters && d.filters.type && d.filters.type[0]) || 'Pages';
          var n = document.createElement('span');
          n.className = 'sugg-title';
          n.textContent = (d.meta && d.meta.title) || d.url;
          a.appendChild(t); a.appendChild(n); li.appendChild(a); list.appendChild(li);
        });
        var all = document.createElement('li');
        var link = document.createElement('a');
        link.className = 'sugg-all';
        link.href = root.querySelector('form').action + '?q=' + encodeURIComponent(input.value.trim());
        link.textContent = 'See all results for \u201c' + input.value.trim() + '\u201d \u2192';
        all.appendChild(link); list.appendChild(all);
        list.hidden = false;
      }
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (!q) { list.hidden = true; list.textContent = ''; return; }
        timer = setTimeout(function () {
          window.tlPagefind().then(function (pf) {
            if (!pf) return;
            return pf.search(q).then(function (res) {
              return Promise.all(res.results.slice(0, 5).map(function (r) { return r.data(); }));
            }).then(function (items) {
              if (input.value.trim() !== q) return;
              if (!items.length) { list.textContent = ''; list.hidden = true; return; }
              render(items);
            });
          });
        }, 150);
      });
    })();
  </script>
  <main id="main" data-pagefind-body={searchable ? '' : undefined} data-pagefind-filter={searchable ? 'type[data-type]' : undefined} data-type={searchType}><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand">Tradition Local</p>
        <p>Become a local insider. Join for monthly stories, events, and what's trending near you.</p>
        {config.newsletterAction ? (
          <form class="signup" action={config.newsletterAction} method="post">
            <label for="nl-email">Email</label>
            <div><input id="nl-email" name="email" type="email" required placeholder="you@example.com" /><button type="submit">Subscribe</button></div><input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" id="nl-return" /><p id="nl-msg" role="status" hidden></p><script is:inline>var q=new URLSearchParams(location.search).get('newsletter');var m=document.getElementById('nl-msg');var r=document.getElementById('nl-return');if(r){r.value=location.origin+location.pathname;}if(q&&m){m.hidden=false;m.textContent=q==='ok'?'Thanks, you are subscribed. Welcome to Tradition Local.':q==='invalid'?'That email address does not look right. Please try again.':'Something went wrong. Please try again, or email us.';}</script>
          </form>
        ) : (
          <a class="btn gold" href={`mailto:${config.contactEmail}?subject=Subscribe%20me%20to%20Tradition%20Local`}>Join the newsletter</a>
        )}
      </div>
      <div>
        <p class="footer-head">Explore</p>
        <ul>
          <li><a href={url('/food')}>Where to eat</a></li>
          <li><a href={url('/cities')}>Neighborhood guides</a></li>
          <li><a href={url('/living')}>Events</a></li>
          <li><a href={url('/all-articles')}>All articles</a></li>
          <li><a href={url('/about-me')}>About us</a></li>
          {membersOn && <li><a href={url('/members')}>Members</a></li>}
        </ul>
      </div>
      <div>
        <p class="footer-head">Follow</p>
        <ul>
          <li><a href={site.social.instagram}>Instagram</a></li>
          <li><a href={site.social.youtube}>YouTube</a></li>
          <li><a href={site.social.facebook}>Facebook group</a></li>
          <li><a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap legal">
      <span>© {new Date().getFullYear()} Tradition Local. All rights reserved. <a href={url('/privacy-policy')}>Privacy policy</a></span>
      <span>Real estate services by <a href={config.brokerage.url}>{config.brokerage.name}</a></span>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --blue: #004aad; --blue-deep: #1f4ba8; --navy: #20455e; --slate: #35465c;
    --gold: #d8bb53; --gold-soft: #f3e9c4; --brown: #9d693f; --cream: #f9f5f4;
    --ink: #1c1c1c; --muted: #5b6573; --line: #e4e0da; --paper: #ffffff;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --wrap: 1180px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: var(--sans); color: var(--ink); background: var(--paper); line-height: 1.55; font-size: 17px; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--blue); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  h1, h2, h3, h4 { font-family: var(--serif); font-weight: 400; color: var(--blue); line-height: 1.15; margin: 0 0 .5em; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -0.01em; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  h3 { font-size: 1.3rem; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 24px; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--gold); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }


  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .site-header { position: relative; }
  .site-search { order: 2; display: flex; align-items: center; }
  .search-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; border: 0; background: transparent; color: var(--blue); cursor: pointer; }
  .search-btn:hover, .search-btn[aria-expanded="true"] { background: var(--line); }
  .search-panel { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 12px 32px rgba(32, 69, 94, .16); }
  .search-panel[hidden] { display: none; }
  .search-panel-inner { max-width: 760px; margin: 0 auto; padding: 24px 24px 28px; }
  .search-panel input[type="search"] { width: 100%; height: 52px; padding: 0 22px; border-radius: 999px; border: 1.5px solid var(--muted); font-size: 17px; font-family: var(--sans); color: var(--ink); background: #fff; }
  .search-sugg { list-style: none; margin: 12px 0 0; padding: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .search-sugg[hidden] { display: none; }
  .search-sugg li + li { border-top: 1px solid var(--line); }
  .search-sugg a { display: flex; align-items: center; gap: 14px; padding: 12px 16px; text-decoration: none; color: var(--ink); }
  .search-sugg a:hover { background: var(--cream); }
  .sugg-type { flex: none; min-width: 104px; text-align: center; font-size: 13px; padding: 2px 10px; border-radius: 4px; background: var(--gold-soft); color: var(--brown); font-weight: 600; }
  .sugg-title { font-family: var(--serif); font-size: 1.1rem; color: var(--blue); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .search-sugg a.sugg-all { display: block; font-weight: 600; color: var(--blue); background: var(--cream); }
  .search-pop { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 16px 0 0; font-size: 14px; color: var(--muted); }
  .search-pop a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border: 1.5px solid var(--blue); border-radius: 999px; text-decoration: none; font-size: 14px; background: #fff; }
  .search-pop a:hover { background: var(--blue); color: #fff; }

  .eventbar { background: var(--gold); color: var(--navy); font-size: 15px; }
  .eventbar .wrap { display: flex; gap: 18px; align-items: center; justify-content: center; padding-top: 8px; padding-bottom: 8px; flex-wrap: wrap; }
  .eventbar strong { color: #1d2d7a; letter-spacing: .04em; }
  .eventbar a { color: var(--navy); }
  .eventbar .rsvp { font-weight: 700; letter-spacing: .15em; }
  .eventbar .all { border-left: 1px solid var(--navy); padding-left: 18px; text-decoration: none; }

  .site-header { background: var(--cream); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 104px; gap: 24px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 22px; text-decoration: none; }
  .brand span { font-family: var(--serif); font-size: clamp(1.4rem, 2.6vw, 2rem); color: var(--blue); letter-spacing: .06em; text-transform: uppercase; }
  .site-header nav { display: flex; gap: 28px; flex-wrap: wrap; align-items: center; }
  .site-header nav a { text-decoration: none; font-weight: 600; font-size: 16px; padding: 6px 0; border-bottom: 2px solid transparent; }
  .site-header nav a:hover, .site-header nav a[aria-current] { border-color: var(--gold); }
  .nav-more { position: relative; display: flex; align-items: center; gap: 2px; }
  .nav-more-link { display: inline-flex; align-items: center; color: var(--blue); font-family: var(--sans); font-weight: 600; font-size: 16px; padding: 6px 0; border-bottom: 2px solid transparent; text-decoration: none; }
  .nav-more-link:hover, .nav-more-link[aria-current] { border-color: var(--gold); }
  .nav-chevron-btn { display: flex; align-items: center; background: none; border: none; cursor: pointer; color: var(--blue); padding: 6px 2px; }
  .nav-more-btn { display: flex; align-items: center; gap: 6px; background: none; border: none; cursor: pointer; color: var(--blue); font-family: var(--sans); font-weight: 600; font-size: 16px; padding: 6px 0; border-bottom: 2px solid transparent; }
  .nav-more-btn:hover, .nav-more-btn[aria-current], .nav-more-btn[aria-expanded="true"] { border-color: var(--gold); }
  .nav-more-menu { position: absolute; top: calc(100% + 10px); left: 0; min-width: 180px; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 32px rgba(32, 69, 94, .16); padding: 8px; z-index: 20; }
  .nav-more-menu a { display: block; padding: 9px 10px; border-radius: 6px; font-weight: 600; font-size: 15px; text-decoration: none; color: var(--blue); border-bottom: none; }
  .nav-more-menu a:hover, .nav-more-menu a[aria-current] { background: var(--cream); }
  .nav-more-menu[hidden] { display: none; }
  .nav-more:hover .nav-more-menu[hidden] { display: block; }

  .band { background: var(--blue-deep); color: #fff; padding: 72px 0 64px; }
  .band h1, .band h2 { color: #fff; }
  .band .kicker { color: var(--gold); font-size: 15px; margin: 0 0 12px; }
  .band p.lede { font-size: 1.25rem; max-width: 40ch; margin: 0 0 28px; }
  .section { padding: 56px 0; }
  .section.tint { background: var(--cream); }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 24px; border-bottom: 2px solid var(--blue); padding-bottom: 8px; }
  .section-head h2 { margin: 0; }
  .section-head a { font-weight: 600; text-decoration: none; }

  .btn { display: inline-block; padding: 12px 26px; border-radius: 999px; font-family: var(--serif); font-weight: 600; text-decoration: none; border: 0; cursor: pointer; font-size: 16px; }
  .btn.gold { background: var(--gold); color: var(--blue); }
  .btn.blue { background: var(--blue); color: #fff; }
  .btn.small { padding: 8px 18px; font-size: 15px; }
  .btn.ghost { border: 2px solid var(--blue); color: var(--blue); background: transparent; }

  .grid { display: grid; gap: 28px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .chip { display: inline-block; border: 1.5px solid var(--blue); border-radius: 999px; padding: 4px 14px; font-size: 14px; color: var(--blue); text-decoration: none; background: #fff; cursor: pointer; font-family: var(--sans); }
  .chip[aria-pressed="true"] { background: var(--blue); color: #fff; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .muted { color: var(--muted); }
  .badge { display: inline-block; font-size: 13px; padding: 2px 10px; border-radius: 4px; background: var(--gold-soft); color: var(--brown); font-weight: 600; }

  .prose { max-width: 70ch; font-size: 18px; line-height: 1.7; }
  .prose h2 { margin-top: 1.6em; font-size: 1.7rem; }
  .prose h3, .prose h4, .prose h5 { margin-top: 1.4em; font-family: var(--serif); color: var(--navy); }
  .prose figure { margin: 1.6em 0; }
